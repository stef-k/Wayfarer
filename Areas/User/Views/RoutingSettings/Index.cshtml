@model Wayfarer.Areas.User.RoutingModels.RoutingSettingsViewModel

<h1>Personal routing settings</h1>
<p>Select only an administrator-approved routing template. Wayfarer never displays your stored credential.</p>
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<p aria-live="polite"><strong>Status:</strong> @Model.Status. Credential: @(Model.CredentialPresent ? "stored (masked)" : "not stored").</p>
<form asp-action="Save" method="post">
    <input asp-for="RowVersion" type="hidden" />
    <div class="mb-3">
        <label asp-for="SelectedProviderConfigurationId" class="form-label">Routing provider</label>
        <select asp-for="SelectedProviderConfigurationId" class="form-select">
            <option value="">Use the server default</option>
            @foreach (var template in Model.Templates)
            {
                <option value="@template.Id">@template.DisplayName (@(template.CredentialRequired ? "personal credential required" : "credential free"))</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Credential" class="form-label">Replacement personal credential</label>
        <input asp-for="Credential" type="password" class="form-control" autocomplete="new-password" />
        <div class="form-text">Leave blank to preserve the stored credential. Credentials are never shown again.</div>
    </div>
    <button class="btn btn-primary" type="submit">Save routing settings</button>
</form>
@if (Model.CredentialPresent)
{
    <form asp-action="ClearCredential" method="post" class="mt-3">
        <input name="rowVersion" value="@Model.RowVersion" type="hidden" />
        <div class="form-check"><input id="confirm-clear" name="confirmed" value="true" type="checkbox" class="form-check-input" /><label for="confirm-clear" class="form-check-label">Confirm removal of my personal routing credential</label></div>
        <button class="btn btn-danger mt-2" type="submit">Clear credential</button>
    </form>
}
