@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.HiddenArea
@{
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["Title"] = T["HiddenAreas.Delete"];
}

<h2>@T["HiddenAreas.DeletePrompt"]</h2>

<div class="alert alert-warning">
    <strong>@Model.Name</strong><br />
    @Model.Description
</div>

<form asp-area="User" asp-controller="HiddenAreas" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">@T["HiddenAreas.ConfirmDelete"]</button>
    <a asp-area="User" asp-controller="HiddenAreas" asp-action="Index" class="btn btn-secondary">@T["Shell.Cancel"]</a>
</form>
