@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ViewModels.HiddenAreaEditViewModel
@{
    ViewData["Title"] = T["HiddenAreas.Edit"];
    ViewData["BodyClass"] = "container";
    ViewData["WebCatalog"] = "HiddenAreas";
    // A validation result can return to the owning GET after discard consent.
    ViewData["LanguageSafeGet"] = Url.Action("Edit", "HiddenAreas", new { area = "User", id = Model.Id });
}

<h2>@ViewData["Title"]</h2>

<form asp-area="User" asp-controller="HiddenAreas" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id"/>

    <div class="form-group">
        <label asp-for="Name">@T["HiddenAreas.Name"]</label>
        <input asp-for="Name" class="form-control"/>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">@T["HiddenAreas.Description"]</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    @* The polygon editor reads and updates the model-bound WKT field. *@
    <div class="form-group">
        <div id="area-map-label">@T["HiddenAreas.EditMap"]</div>
        <div id="hidden-area-map" role="region" aria-labelledby="area-map-label" aria-describedby="area-map-help"
             data-create="false" style="height: 550px;" class="border rounded mb-2"></div>
        <input type="hidden" asp-for="AreaWKT" id="areaInput" />
        <span asp-validation-for="AreaWKT" class="text-danger"></span>
        <span id="area-map-error" class="text-danger" role="alert" hidden>@T["HiddenAreas.InvalidDrawing"]</span>
        <small id="area-map-help" class="form-text text-muted">@T["HiddenAreas.EditHelp"]</small>
    </div>

    <button type="submit" class="btn btn-primary">@T["HiddenAreas.Save"]</button>
    <a asp-area="User" asp-controller="HiddenAreas" asp-action="Index" class="btn btn-secondary">@T["Shell.Cancel"]</a>
</form>

@section Scripts {
    <script type="module" src="~/js/Areas/User/HiddenAreas/drawing.js" asp-append-version="true"></script>
}
