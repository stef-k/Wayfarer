@inject Wayfarer.Localization.WebMessages T
@model List<Wayfarer.Models.HiddenArea>
@{
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["Title"] = T["Shell.HiddenAreas"];
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="alert alert-light small mb-3">
    <i class="bi bi-lightbulb me-1"></i>
    @T["HiddenAreas.Help"]
</div>
<a asp-area="User" asp-controller="HiddenAreas" asp-action="Create" class="btn btn-primary mb-3">
    <i class="bi bi-plus-circle"></i> @T["HiddenAreas.Add"]
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @T["HiddenAreas.Empty"]
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
        <tr class="text-center">
            <th>@T["HiddenAreas.Name"]</th>
            <th style="width: 50%;">@T["HiddenAreas.Description"]</th>
            <th colspan="2">@T["HiddenAreas.Actions"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var area in Model)
        {
            <tr>
                <td>@area.Name</td>
                <td>@area.Description</td>
                <td class="text-center">
                    <a asp-area="User" asp-controller="HiddenAreas" asp-action="Edit" asp-route-id="@area.Id"
                       class="btn btn-sm btn-secondary">
                        <i class="bi bi-pencil-square"></i> @T["HiddenAreas.EditAction"]
                    </a>
                </td>
                <td class="text-center"><a asp-area="User" asp-controller="HiddenAreas" asp-action="Delete" asp-route-id="@area.Id"
                       class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> @T["HiddenAreas.DeleteAction"]
                    </a></td>
            </tr>
        }
        </tbody>
    </table>
}
