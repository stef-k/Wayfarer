@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ApplicationUser

@{
    ViewData["Title"] = T["Settings.Title"];
    ViewData["WebCatalog"] = "Settings";
    var eligibility = Wayfarer.Services.PublicTimelineEligibilityResolver.Resolve(Model);
    // Relative navigation respects the public browser origin and existing forwarded-header handling.
    var fullurl = $"/Public/Users/Timeline/{Uri.EscapeDataString(Model.UserName ?? string.Empty)}";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header  text-bg-primary mb-3">
                    <h2>@T["Settings.Timeline"]</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@T["Settings.DisplayName"]</dt>
                        <dd class="col-sm-8">@((Model.DisplayName) ?? T["Settings.NotSet"])</dd>

                        <dt class="col-sm-4">@T["Settings.Public"]</dt>
                        <dd class="col-sm-8">
                            @if (eligibility.IsEffectivelyPublic)
                            {
                                <span class="badge bg-success d-inline">@T["Settings.Yes"]</span>
                                <p>@T["Settings.PublicLink"] <a href="@fullurl" target="_blank">@fullurl</a></p>
                                <p>@T["Settings.EmbedHelp"]</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-embed-kind="timeline"
                                            data-embed-id="@Model.UserName" data-embed-title="@(Model.TimelineTitle ?? Model.DisplayName ?? Model.UserName)"
                                            data-embed-format="url">@T["Shell.CopyEmbedUrl"]</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-embed-kind="timeline"
                                            data-embed-id="@Model.UserName" data-embed-title="@(Model.TimelineTitle ?? Model.DisplayName ?? Model.UserName)"
                                            data-embed-format="html">@T["Shell.CopyEmbedHtml"]</button>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary d-inline">@T["Settings.No"]</span>
                            }
                        </dd>
                        
                        <dt class="col-sm-4">@T["Settings.TimelineThreshold"]</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsTimelinePublic && !eligibility.IsThresholdValid)
                            {
                                <span class="text-warning">@T["Settings.StatusInvalid"]</span>
                            }
                            else if (!eligibility.IsEffectivelyPublic)
                            {
                                <span class="text-muted">@T["Settings.NoThreshold"]</span>
                            }
                            else
                            {
                                @if (eligibility.IsLive)
                                {
                                    <span class="badge bg-danger">@T["Settings.Live"]</span>
                                    <span>@T["Settings.LiveWarning"]</span>

                                }
                                else
                                {
                                    <span>@T["Settings.StatusDelayed", eligibility.Delay?.ToString("g", T.DisplayCulture)]</span>
                                }
                            }
                        </dd>
                    </dl>

                    <div class="d-grid gap-2 mt-3">
                        <a class="btn btn-outline-primary" asp-area="User" asp-controller="Timeline" asp-action="Settings">@T["Settings.ManageTimeline"]</a>
                    </div>

                    <div class="card-header text-bg-primary my-4">
                        <h2>@T["Settings.LoggingThresholds"]</h2>
                    </div>

                    <p class="text-muted mb-3">
                        @T["Settings.LoggingHelp"]
                    </p>

                    <div class="row mb-3">
                        <div class="col-md-4 mb-3">
                            <div class="card bg-body-tertiary h-100">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-clock me-2"></i>@T["Settings.TimeThreshold"]
                                    </h6>
                                    <p class="display-6 mb-2 text-primary">@T["Settings.Minutes", ViewData["LocationTimeThresholdMinutes"]]</p>
                                    <p class="small text-muted mb-0">@T["Settings.TimeHelp", ViewData["LocationTimeThresholdMinutes"]]</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-body-tertiary h-100">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-geo-alt me-2"></i>@T["Settings.DistanceThreshold"]
                                    </h6>
                                    <p class="display-6 mb-2 text-primary">@T["Shell.DisplayMetres", ViewData["LocationDistanceThresholdMeters"]]</p>
                                    <p class="small text-muted mb-0">@T["Settings.DistanceHelp", ViewData["LocationDistanceThresholdMeters"]]</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-body-tertiary h-100">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-bullseye me-2"></i>@T["Settings.AccuracyThreshold"]
                                    </h6>
                                    <p class="display-6 mb-2 text-primary">@T["Shell.DisplayMetres", ViewData["LocationAccuracyThresholdMeters"]]</p>
                                    <p class="small text-muted mb-0">@T["Settings.AccuracyHelp", ViewData["LocationAccuracyThresholdMeters"]]</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-secondary mb-3">
                        <small>
                            <i class="bi bi-info-circle me-1"></i>
                            @T["Settings.LoggingNotice"]
                        </small>
                    </div>

                    @* Inbound app credentials and outbound provider keys have separate ownership. *@
                    <div class="card-header text-bg-primary my-4"><h2>@T["Connection.ShortTitle"]</h2></div>
                    <p>@T["Connection.Intro"]</p>
                    <div class="d-grid gap-2 mt-3"><a class="btn btn-primary" asp-area="User" asp-controller="ApiToken" asp-action="Index">@T["Connection.ShortTitle"]</a></div>

                    <div class="card-header text-bg-primary my-4"><h2>@T["Providers.Title"]</h2></div>
                    <div class="d-grid gap-2 mt-3"><a class="btn btn-outline-primary" asp-area="User" asp-controller="LocationProviderSettings" asp-action="Index">@T["Providers.Title"]</a></div>
                    
                    <div class="card-header  text-bg-primary my-4">
                        <h2>@T["Settings.Locations"]</h2>
                    </div>
                    
                    <div class="d-grid gap-2 mt-3">
                        <button class="btn btn-danger" id="deleteAllUserLocations" data-user-id="@Model.Id">@T["Settings.DeleteAll"]</button>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.FrontendViewScripts()
}
