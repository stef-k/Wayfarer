@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["WebCatalog"] = "Locations";
    ViewData["Title"] = T["Locations.Management"];
    ViewData["BodyClass"] = "container-fluid";
    ViewData["LoadTomSelect"] = true;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <!-- Left: Title + Stats -->
    <div class="d-flex flex-wrap align-items-baseline gap-2">
        <h1 class="fs-4 my-0">@ViewData["Title"]</h1>
        <span id="timeline-summary" class="small font-monospace text-muted"></span>
    </div>

    <!-- Right: Export dropdown + Add button -->
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group">
            <button
                type="button"
                class="btn btn-outline-primary btn-sm dropdown-toggle"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                title="@T["Locations.ExportHelp"]">
                @T["Locations.Export"]
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="LocationExport" asp-action="GeoJson">GeoJSON</a></li>
                <li><a class="dropdown-item" asp-controller="LocationExport" asp-action="Csv">CSV</a></li>
                <li><a class="dropdown-item" asp-controller="LocationExport" asp-action="Gpx">GPX</a></li>
                <li><a class="dropdown-item" asp-controller="LocationExport" asp-action="Kml">KML</a></li>
            </ul>
        </div>
        <i class="bi bi-question-circle text-muted"
           data-tippy-content="@T["Locations.ExportFormats"]"></i>
        <a class="btn btn-success btn-sm" asp-action="Create" title="@T["Locations.AddHelp"]">
            @T["Locations.Add"]
        </a>
    </div>
</div>


<!-- Search and Delete Buttons -->
<div class="d-flex justify-content-between align-items-center my-2">
    <button id="deleteSelected" class="btn btn-danger btn-sm" title="@T["Locations.DeleteSelectedHelp"]">@T["Shell.DeleteSelected"]</button>
    <!-- Search Button -->
    <button id="searchToggleBtn" class="btn btn-secondary btn-sm">@T["Shell.Search"]</button>
</div>

<!-- Advanced Search Panel (Initially hidden) -->
<div id="advancedSearchPanel" class="mt-3" style="display: none;">
    <div class="card">
        <div class="card-body">
            <form id="advancedSearchForm">
                <div class="row">
                    <div class="col-md-4">
                        <label for="fromTimestamp" class="form-label">@T["Locations.FromDate"]</label>
                        <input type="date" class="form-control" id="fromTimestamp">
                    </div>
                    <div class="col-md-4">
                        <label for="toTimestamp" class="form-label">@T["Locations.ToDate"]</label>
                        <input type="date" class="form-control" id="toTimestamp">
                    </div>
                    <div class="col-md-4">
                        <label for="latitude" class="form-label">@T["Locations.Latitude"]</label>
                        <input type="number" step="any" class="form-control" id="latitude">
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <label for="longitude" class="form-label">@T["Locations.Longitude"]</label>
                        <input type="number" step="any" class="form-control" id="longitude">
                    </div>
                    <div class="col-md-4">
                        <label for="activity" class="form-label">@T["Locations.Activity"]</label>
                        <input type="text" class="form-control" id="activity">
                    </div>
                    <div class="col-md-4">
                        <label for="address" class="form-label">@T["Locations.Address"]</label>
                        <input type="text" class="form-control" id="address">
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <label for="country" class="form-label">@T["Locations.Country"]</label>
                        <input type="text" class="form-control" id="country">
                    </div>
                    <div class="col-md-4">
                        <label for="region" class="form-label">@T["Locations.Region"]</label>
                        <input type="text" class="form-control" id="region">
                    </div>
                    <div class="col-md-4">
                        <label for="place" class="form-label">@T["Locations.City"]</label>
                        <input type="text" class="form-control" id="place">
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <label for="notes" class="form-label">@T["Shell.Notes"]</label>
                        <textarea class="form-control" id="notes"></textarea>
                    </div>
                </div>

                <div class="row mt-1">
                    <div class="col-2"><button type="submit" class="btn btn-primary btn-sm mt-3">@T["Shell.Search"]</button></div>
                    <div class="col-2"><button type="button" class="btn btn-secondary btn-sm mt-3" id="clearSearchForm">@T["Shell.Clear"]</button></div>
                </div>
            </form>
        </div>
    </div>
</div>

<p id="location-read-status" class="text-danger" role="status"></p>
<p id="location-deletion-status" class="text-danger" role="status" hidden></p>
<div class="table-responsive table-normal-height">
    <table class="table table-striped table-sm table-hover" id="locationsTable">
        <thead>
        <tr>
            <th><input type="checkbox" id="selectAll" aria-label="@T["Shell.SelectAllRows"]"/></th>
            <th>@T["Locations.DateZone"]</th>
            <th>@T["Locations.Latitude"]</th>
            <th>@T["Locations.Longitude"]</th>
            <th class="text-center">@T["Locations.AccuracyMeters"]</th>
            <th class="text-center">@T["Locations.SpeedKilometers"]</th>
            <th class="text-center">@T["Locations.AltitudeMeters"]</th>
            <th>@T["Locations.Activity"]</th>
            <th>@T["Locations.Address"]</th>
            <th>@T["Locations.Place"]</th>
            <th>@T["Locations.Country"]</th>
            <th>@T["Shell.Actions"]</th>
        </tr>
        </thead>
        <tbody>
        <!-- Location rows will be populated here via JavaScript -->
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center align-items-center my-3">
    <div id="pagination" class="pagination-container"></div>
</div>


<!-- Modal HTML -->
<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" data-bs-backdrop="static">
    <div class="modal-dialog  modal-dialog-scrollable modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-bg-primary  d-flex">
                <h5 class="modal-title" id="locationModalLabel">@T["Locations.Details"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Shell.Close"]"></button>
            </div>
            <div class="modal-body">
                <div id="modalContent"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.FrontendViewScripts()
}
