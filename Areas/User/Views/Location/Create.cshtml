@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@model Wayfarer.Models.ViewModels.AddLocationViewModel

@{
    ViewData["BodyClass"] = "container-fluid";
    ViewData["LoadLeaflet"] = true;
    var notesAssets = Wayfarer.Util.ViteAssets.Read(Environment.WebRootPath, "ClientApps/rich-notes/location-create.js");
    ViewData["LoadTomSelect"] = true;
}

<h1 class="fs-3 text-center">@ViewData["Title"]</h1>

<!-- The complete private draft surface includes the map, its controls and Notes dialog. -->
<div id="location-create-private" class="row">
    <!-- Location Form Column -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header text-bg-primary">
                <h2 class="fs-4">Location Entry</h2>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <!-- Owner-bound identity and first attempt survive ordinary redisplay and uncertain retries. -->
                    <input asp-for="CreateKey" type="hidden" />
                    <input asp-for="CreateIntent" type="hidden" />
                    <input asp-for="AttemptedValues" type="hidden" />
                    <input asp-for="CreateMayHaveEffect" type="hidden" />
                    <div id="create-status" class="alert alert-warning" role="status" aria-live="polite" hidden="@(Model.CreateStatus == null)">@Model.CreateStatus</div>
                    @if (Model.SavedLocationId is { } savedId)
                    {
                        <p><a asp-action="Edit" asp-route-id="@savedId" class="btn btn-outline-primary">Open saved Location / Edit</a></p>
                    }
                    @if (ViewData["CreateWinner"] is Wayfarer.Models.Location winner)
                    {
                        <div class="border rounded p-2 mb-3" aria-label="Actual saved location">
                            <strong>Actual saved location</strong>
                            <p>@winner.LocalTimestamp.ToString("O") · @winner.Coordinates.Y, @winner.Coordinates.X</p>
                            <p>@winner.Address</p>
                            <div>@Html.Raw(Wayfarer.Util.RichNotes.Normalize(winner.Notes))</div>
                        </div>
                    }
                    <input asp-for="FullAddress" type="hidden" />
                    <input asp-for="AddressNumber" type="hidden" />
                    <input asp-for="StreetName" type="hidden" />
                    <input asp-for="PostCode" type="hidden" />
                    <input asp-for="Place" type="hidden" />
                    <input asp-for="Region" type="hidden" />
                    <input asp-for="Country" type="hidden" />
                    <input asp-for="Accuracy" type="hidden" />
                    <input asp-for="Speed" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group row">
                        <label for="Latitude" class="col-sm-3 col-form-label">
                            Latitude <span class="text-danger">*</span>
                            <i class="bi bi-question-circle text-muted ms-1"
                               data-tippy-content="Decimal degrees format (e.g., 37.9838). Click on the map to auto-fill."></i>
                        </label>
                        <div class="col-sm-3">
                            <!-- Start blank; retain attempted input and its server validation error on redisplay. -->
                            <input type="text" class="form-control" id="Latitude" name="Latitude" value="@(ViewData.ModelState["Latitude"]?.AttemptedValue)" required />
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        <label for="Longitude" class="col-sm-3 col-form-label">
                            Longitude <span class="text-danger">*</span>
                            <i class="bi bi-question-circle text-muted ms-1"
                               data-tippy-content="Decimal degrees format (e.g., 23.7275). Click on the map to auto-fill."></i>
                        </label>
                        <div class="col-sm-3">
                            <!-- Start blank; retain attempted input and its server validation error on redisplay. -->
                            <input type="text" class="form-control" id="Longitude" name="Longitude" value="@(ViewData.ModelState["Longitude"]?.AttemptedValue)" required />
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                    </div>
                    <small id="coordinatesHelp" class="form-text text-muted">
                        Click on the map to select your location. The latitude and longitude will be automatically filled in.
                    </small>

                    <div class="row ">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="Altitude">Altitude (meters)</label>
                                <input type="number" class="form-control  mt-2" id="Altitude" asp-for="Altitude" step="any" />
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="form-group">
                                <label for="SelectedActivityId" class="form-label">Activity Type</label>
                                <select asp-for="SelectedActivityId" id="activitySelect" class="form-select"
                                        data-api-url="/api/activity">
                                    <option value="">Select an Activity</option>
                                    @foreach (var activity in Model.ActivityTypes ?? [])
                                    { <option value="@activity.Value">@activity.Text</option> }
                                </select>

                                @Html.ValidationMessageFor(m => m.SelectedActivityId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>



                    <div class="form-group">
                        <label for="Address">Address</label>
                        <input type="text" class="form-control" id="Address" asp-for="Address" />
                    </div>
                    <div class="form-group">
                        <label for="LocalTimestamp">
                            Local Date and Time <span class="text-danger">*</span>
                            <i class="bi bi-question-circle text-muted ms-1"
                               data-tippy-content="Enter the local time at this location. The time will be stored as UTC and displayed in your configured timezone."></i>
                        </label>
                        <!-- ModelState retains attempted validation input; fresh pages initialize browser-local time. -->
                        <input type="datetime-local"
                               class="form-control"
                               id="LocalTimestamp"
                               asp-for="LocalTimestamp"
                               data-initialize-local-time="@(!ViewData.ModelState.ContainsKey("LocalTimestamp") && !Model.CreateMayHaveEffect ? "true" : "false")"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        @Html.ValidationMessageFor(m => m.LocalTimestamp, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label id="notes-label">Add Notes</label>
                        <partial name="_NotesToolbar" model="@(false)" />
                        <div id="notes" data-notes-content="@(Wayfarer.Util.RichNotes.Normalize(Model.Notes))"></div>
                        <input type="hidden" id="Notes" name="Notes" value="@(Wayfarer.Util.RichNotes.Normalize(Model.Notes))" />
                        <span asp-validation-for="Notes" class="text-danger"></span>
                        <small class="text-muted">Older formatting may need adjustment when edited. Use Image to insert an HTTP(S) image URL.</small>
                        <p id="notes-feedback" role="status" aria-live="polite"></p>
                    </div>

                    <div class="form-group">
                        <small class="text-muted">
                            <span class="text-danger">*</span> Fields are required.
                        </small>
                    </div>
                    @if (!Model.CreateTerminal)
                    { <button type="submit" class="btn btn-primary">@(Model.CreateMayHaveEffect ? "Retry original save" : "Add Location")</button> }
                    <a asp-action="Create" class="btn btn-outline-secondary">Start a separate new location</a>
                </form>
            </div>
        </div>
    </div>

    <!-- Map Column -->
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header text-bg-primary">
                <h2 class="fs-4">Map View</h2>
            </div>
            <div class="card-body p-1">
                <div id="mapContainer" style="height: 575px;"></div>
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-outline-danger" id="clearButton">Clear Location</button>
            </div>
        </div>
    </div>

    <partial name="_NotesDialog" />
</div>

@section Styles {
    @foreach (var href in notesAssets.Css) { <link rel="stylesheet" href="@href" /> }
}

@section Scripts {
    @if (Environment.IsDevelopment())
    {
        <script type="module" src="http://localhost:5173/@@vite/client"></script>
        <script type="module" src="http://localhost:5173/ClientApps/rich-notes/location-create.js"></script>
    }
    else if (notesAssets.Script is not null)
    {
        <script type="module" src="@notesAssets.Script"></script>
    }
}
