@inject Wayfarer.Localization.WebMessages T
@{
    // This document supplies one catalog for both rendered and live Group controls.
    ViewData["WebCatalog"] = "Groups";
    ViewData["LanguageSafeGet"] = Url.Action("Create");
    ViewData["Title"] = T["Shell.CreateGroup"];
}

<h2>@T["Shell.CreateGroup"]</h2>

<form asp-area="User" asp-controller="Groups" asp-action="Create" method="post" id="userGroupCreateForm" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label" for="name">@T["Groups.Name"]</label>
        <input class="form-control" id="name" name="name" value="@ViewData.ModelState["name"]?.AttemptedValue" required maxlength="200" />
        <div class="invalid-feedback">@T["Groups.NameRequired"]</div>
        @Html.ValidationMessage("name", null, new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label" for="description">@T["Groups.Description"]</label>
        <textarea class="form-control" id="description" name="description" rows="3">@ViewData.ModelState["description"]?.AttemptedValue</textarea>
    </div>
    <div class="mb-3">
        <label class="form-label" for="groupType">
            @T["Groups.Type"]
            <i class="bi bi-question-circle text-muted ms-1"
               data-tippy-content="@T["Groups.PersonalTypesHelp"]"></i>
        </label>
        <select class="form-select" id="groupType" name="groupType" required>
            <option value="Family" selected="@(ViewData.ModelState["groupType"]?.AttemptedValue == "Family" ? "selected" : null)">@T["Groups.TypeFamily"]</option>
            <option value="Friends" selected="@(ViewData.ModelState["groupType"]?.AttemptedValue == "Friends" ? "selected" : null)">@T["Groups.TypeFriends"]</option>
        </select>
        <div class="invalid-feedback">@T["Groups.TypeRequired"]</div>
        @Html.ValidationMessage("groupType", null, new { @class = "text-danger" })
    </div>
    <button type="submit" class="btn btn-primary">@T["Groups.Create"]</button>
    <a class="btn btn-secondary" asp-area="User" asp-controller="Groups" asp-action="Index">@T["Shell.Cancel"]</a>
  </form>

<script>
  (function(){
    const form = document.getElementById('userGroupCreateForm');
    if (!form) return;
    form.addEventListener('submit', function(e){
      const n = form.querySelector('#name');
      const t = form.querySelector('#groupType');
      let ok = true;
      if (!n || !n.value || !n.value.trim()) { n?.classList.add('is-invalid'); ok=false; }
      else n.classList.remove('is-invalid');
      if (!t || !t.value) { t?.classList.add('is-invalid'); ok=false; } else t.classList.remove('is-invalid');
      if (!ok) e.preventDefault();
    });
  })();
</script>

