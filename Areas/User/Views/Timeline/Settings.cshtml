@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ViewModels.TimelineSettingsViewModel

@{
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    // The validation response can safely return to Settings without replaying UpdateSettings.
    ViewData["LanguageSafeGet"] = Url.Action("Settings", "Timeline", new { area = "User" });
    ViewData["Title"] = T["Settings.Timeline"];
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header text-bg-primary mb-3">
                    <h2>@T["Settings.EditTimeline"]</h2>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(false, T["Settings.FixErrors"])
                        </div>
                    }

                    <form method="post" asp-action="UpdateSettings" asp-controller="Timeline" asp-area="User">
                        @Html.AntiForgeryToken()

                        <!-- Effective public availability is calculated from persisted visibility and threshold state. -->
                        <div class="alert @(Model.HasInvalidPublicTimelineThreshold ? "alert-warning" : "alert-info")" role="status">
                            @Model.PublicTimelineStatus
                            @if (Model.HasInvalidPublicTimelineThreshold)
                            {
                                <div>@T["Settings.ReplaceThreshold"]</div>
                            }
                        </div>

                        <!-- Optional visible map heading. -->
                        <div class="mb-3">
                            <label asp-for="TimelineTitle" class="form-label">@T["Settings.TimelineTitle"]</label>
                            <input asp-for="TimelineTitle" class="form-control" maxlength="80" />
                            <div class="form-text">@T["Settings.TitleLength"]</div>
                            <div class="form-text">@T["Settings.TitleHelp"] <strong>@Model.DefaultTimelineTitle</strong></div>
                            <span asp-validation-for="TimelineTitle" class="text-danger"></span>
                        </div>

                        <!-- Public Timeline Toggle -->
                        <div class="form-check form-switch mb-4">
                            <input type="checkbox" class="form-check-input" id="IsTimelinePublic" asp-for="IsTimelinePublic" role="switch" />
                            <label for="IsTimelinePublic" class="form-check-label">@T["Settings.MakePublic"]</label>
                            <div class="form-text">@T["Settings.PublicHelp"]</div>
                            <div class="form-text text-danger">@T["Settings.PublicWarning"]</div>
                        </div>

                        <!-- Time Threshold Dropdown with Custom Option -->
                        <div class="mb-3">
                            <label for="TimeThresholdDropdown" class="form-label">@T["Settings.TimeThreshold"]</label>
                            <select asp-for="PublicTimelineTimeThreshold" class="form-select" id="TimeThresholdDropdown" data-saved-threshold="@Model.PublicTimelineTimeThreshold">
                                <option value="">@T["Settings.SelectThreshold"]</option>
                                <option value="now">@T["Settings.ThresholdNow"]</option>
                                <option value="1h">@T["Settings.ThresholdHour"]</option>
                                <option value="1d">@T["Settings.ThresholdDay"]</option>
                                <option value="1w">@T["Settings.ThresholdWeek"]</option>
                                <option value="1m">@T["Settings.ThresholdMonth"]</option>
                                <option value="1y">@T["Settings.ThresholdYear"]</option>
                                <option value="custom" selected="@(!string.IsNullOrEmpty(Model.CustomThreshold))">@T["Settings.ThresholdCustom"]</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.PublicTimelineTimeThreshold, "", new { @class = "text-danger" })
                            <div class="form-text">@T["Settings.ThresholdHelp"]</div>
                            <div id="DelayedSharingHint" class="form-text" hidden>@T["Settings.DelayedHint"]</div>
                        </div>

                        <!-- Live sharing requires an explicit acknowledgement on the submitted form. -->
                        <div id="LiveConfirmation" class="form-check mb-3" hidden>
                            <input asp-for="ConfirmLivePublicTimeline" class="form-check-input" />
                            <label asp-for="ConfirmLivePublicTimeline" class="form-check-label">@T["Settings.ConfirmLive"]</label>
                            <span asp-validation-for="ConfirmLivePublicTimeline" class="text-danger"></span>
                        </div>

                        <!-- The selected threshold controls visibility of the custom field and its error. -->
                        <div id="CustomTimeInput" class="mb-3" hidden>
                            <label for="CustomThreshold" class="form-label">@T["Settings.CustomThreshold"]</label>
                            <input type="text" class="form-control" asp-for="CustomThreshold" placeholder="@T["Settings.CustomPlaceholder"]" />
                            @* Show field-specific errors and retain the original delay notation. *@
                            <span asp-validation-for="CustomThreshold" class="text-danger"></span>
                            <div class="form-text">@T["Settings.CustomUnits"]</div>
                            <div class="form-text">@T["Settings.CustomExamples"]</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">@T["Settings.SaveChanges"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.onload = function() {
            const thresholdDropdown = document.getElementById('TimeThresholdDropdown');
            const customTimeInput = document.getElementById('CustomTimeInput');
            const customThresholdField = document.getElementById('CustomThreshold');
            const publicToggle = document.getElementById('IsTimelinePublic');
            const liveConfirmation = document.getElementById('LiveConfirmation');
            const liveConfirmationField = document.getElementById('ConfirmLivePublicTimeline');
            const delayedSharingHint = document.getElementById('DelayedSharingHint');

            const savedValue = thresholdDropdown.dataset.savedThreshold;
            const options = Array.from(thresholdDropdown.options).map(option => option.value);

            // Map a stored non-preset delay to Custom, keeping the attempted input on validation responses.
            thresholdDropdown.value = savedValue;
            if (savedValue && !options.includes(savedValue)) {
                thresholdDropdown.value = 'custom';
                customThresholdField.value = savedValue;
            }

            const updateThresholdControls = () => {
                customTimeInput.hidden = thresholdDropdown.value !== 'custom';
                const isNow = thresholdDropdown.value === 'now';
                liveConfirmation.hidden = !isNow;
                if (!isNow) {
                    liveConfirmationField.checked = false;
                }
                delayedSharingHint.hidden = !(publicToggle.checked && thresholdDropdown.value === '1d');
            };

            thresholdDropdown.addEventListener('change', function () {
                if (this.value !== 'custom') {
                    customThresholdField.value = '';
                }
                updateThresholdControls();
            });

            publicToggle.addEventListener('change', function () {
                if (this.checked && !thresholdDropdown.value) {
                    thresholdDropdown.value = '1d';
                }
                updateThresholdControls();
            });

            updateThresholdControls();

            document.querySelector('form').addEventListener('submit', function () {
                if (thresholdDropdown.value !== 'custom') {
                    customThresholdField.value = '';
                }
            });
        };
    </script>
}
