@model Wayfarer.Models.ViewModels.TripEditorShellViewModel
@inject IWebHostEnvironment Environment
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Trip Editor";
    var manifestPath = System.IO.Path.Combine(Environment.WebRootPath, "vite", "trip-editor", ".vite", "manifest.json");
    var entryScript = "/ClientApps/trip-editor/src/main.ts";
}

@functions {
    /// <summary>
    /// Reads the Trip Editor Vite manifest and emits local built asset tags for this shell only.
    /// </summary>
    private static (string? Script, IReadOnlyList<string> Css) ReadTripEditorManifest(string manifestPath, string entryScript)
    {
        if (!System.IO.File.Exists(manifestPath))
        {
            return (null, Array.Empty<string>());
        }

        using var document = JsonDocument.Parse(System.IO.File.ReadAllText(manifestPath));
        if (!document.RootElement.TryGetProperty(entryScript, out var entry))
        {
            return (null, Array.Empty<string>());
        }

        var script = entry.TryGetProperty("file", out var file) ? $"/vite/trip-editor/{file.GetString()}" : null;
        var css = entry.TryGetProperty("css", out var cssItems)
            ? cssItems.EnumerateArray()
                .Select(item => $"/vite/trip-editor/{item.GetString()}")
                .ToArray()
            : Array.Empty<string>();

        return (script, css);
    }
}

@{
    var manifest = ReadTripEditorManifest(manifestPath, entryScript);
}

@section Styles {
    @foreach (var href in manifest.Css)
    {
        <link rel="stylesheet" href="@href" />
    }
}

<form id="trip-editor-antiforgery" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div id="trip-editor-app"
     data-trip-id="@Model.TripId"
     data-trip-name="@Model.TripName"
     data-editor-endpoint="@Model.EditorEndpointUrl"
     data-trip-index-url="@Model.TripIndexUrl"
     data-tiles-url="@Model.TilesUrl">
    <div class="trip-editor-shell-loading">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Loading trip editor...
    </div>
</div>

@section Scripts {
    @if (Environment.IsDevelopment())
    {
        <script type="module" src="http://localhost:5173/@@vite/client"></script>
        <script type="module" src="http://localhost:5173/ClientApps/trip-editor/src/main.ts"></script>
        <script>
            // Development-only hint when the Vite server on port 5173 is not running.
            setTimeout(() => {
                const app = document.getElementById('trip-editor-app');
                if (app?.querySelector('.trip-editor-shell-loading')) {
                    app.innerHTML =
                        '<div class="alert alert-danger m-3">Trip Editor development server is not available. Run npm run dev.</div>';
                }
            }, 4000);
        </script>
    }
    else if (!string.IsNullOrWhiteSpace(manifest.Script))
    {
        <script type="module" src="@manifest.Script"></script>
    }
    else
    {
        <script>
            document.getElementById('trip-editor-app').innerHTML =
                '<div class="alert alert-danger m-3">Trip Editor assets are missing. Run npm ci and npm run build.</div>';
        </script>
    }
}
