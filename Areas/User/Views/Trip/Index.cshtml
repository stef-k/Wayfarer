@using System.Security.Claims
@using Wayfarer.Localization
@inject IWebHostEnvironment Environment
@inject WebMessages T
@{
    // The importer must register its file and review owners before switching is shown.
    ViewData["LanguageWorkspace"] = true;
    ViewData["LoadLeaflet"] = true;
    ViewData["WebCatalog"] = "Editor";
    ViewData["Title"] = T["Editor.MyTrips"];
}

<h2>@ViewData["Title"]</h2>

@Html.AntiForgeryToken()

@* Recovery is account scoped and independent of the current Trip list and graph. *@
<div id="trip-metadata-recovery" data-account-id="@User.FindFirstValue(ClaimTypes.NameIdentifier)"
     data-editor-url="@Url.Action("Edit", "Trip", new { area = "User", id = Guid.Empty })"></div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-area="User" asp-controller="Trip" asp-action="Create"
       class="btn btn-primary" title="@T["Editor.TripsCreateANewTrip"]">
        <i class="bi bi-plus-lg me-1"></i> @T["Editor.TripsCreateNewTrip"]
    </a>

    <a asp-action="Copy" class="btn btn-outline-primary">@T["Editor.CompositionCopyToExistingTrip"]</a>
    <a asp-action="Compose" class="btn btn-outline-primary">@T["Editor.TripsCompareCombineNewVersion"]</a>

    @* Saved comparisons load independently of the ordinary Trip pagination and filters. *@

    <label class="btn btn-outline-secondary mb-0" title="@T["Editor.TripsImportATripFromAWayfarer"]">
        <i class="bi bi-upload me-1"></i> @T["Editor.TripsImportTrip"]
        <input type="file"
               id="importFile"
               accept=".kml"
               class="d-none">
    </label>

    <label class="btn btn-outline-secondary mb-0" title="@T["Editor.TripsImportAGoogleMyMapsKML"]">
        <i class="bi bi-upload me-1"></i> @T["Editor.TripsImportMyMaps"]
        <input type="file" id="importFileMyMaps" accept=".kml" class="d-none">
    </label>

    <div class="ms-auto d-flex gap-2 align-items-center">
        <div class="search-group">
            <input type="text" class="form-control form-control-sm pe-4"
                   id="trip-search" placeholder="@T["Editor.TripsSearchTrips"]">
            <button type="button" class="btn-search-clear d-none"
                    id="trip-search-clear" title="@T["Editor.TripsClearSearch"]">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="@T["Editor.TripsTripVisibilityFilter"]">
            <input type="radio" class="btn-check" name="tripFilter" id="filterAll" value="all" checked autocomplete="off">
            <label class="btn btn-outline-primary" for="filterAll">@T["Editor.AllPlaces"]</label>
            <input type="radio" class="btn-check" name="tripFilter" id="filterPublic" value="public" autocomplete="off">
            <label class="btn btn-outline-primary" for="filterPublic">@T["Editor.TripPublic"]</label>
            <input type="radio" class="btn-check" name="tripFilter" id="filterPrivate" value="private" autocomplete="off">
            <label class="btn btn-outline-primary" for="filterPrivate">@T["Editor.TripPrivate"]</label>
        </div>
    </div>
</div>

<!-- Summary stats: dynamically updated by Index.js from API response -->
<section id="unfinished-compositions" class="mb-3" aria-label="@T["Editor.CompositionUnfinishedCompositions"]" aria-live="polite"></section>
<div id="trip-stats" class="d-flex gap-3 mb-3 text-muted small" aria-live="polite">
    <span><strong id="stat-total">0</strong> <span id="stat-total-label">@T["Editor.TripsTotal"]</span></span>
    <span><strong id="stat-public">0</strong> @T["Editor.TripsPublic"]</span>
    <span><strong id="stat-private">0</strong> @T["Editor.TripsPrivate"]</span>
</div>

<!-- Empty state message (shown/hidden by JS) -->
<p id="no-trips-message" class="d-none">@T["Editor.TripsYouDonTHaveAnyTrips"]</p>

<table id="trip-table" class="table table-bordered table-striped table-hover">
    <thead>
    <tr>
        <th class="w-auto">@T["Editor.Name"]</th>
        <th class="w-auto">@T["Editor.CompositionNotes"]</th>
        <th class="w-auto">@T["Editor.TripPublic"]</th>
        <th class="w-25">@T["Editor.TripsActions"]</th>
    </tr>
    </thead>
    <tbody id="trip-table-body">
    <!-- Populated by Index.js via AJAX -->
    </tbody>
</table>

<!-- Pagination controls and page-size selector -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
    <div id="pagination" class="pagination-container"></div>
    <div class="d-flex align-items-center gap-2">
        <label for="page-size-select" class="form-label mb-0 small text-muted">@T["Editor.TripsPerPage"]</label>
        <select id="page-size-select" class="form-select form-select-sm" style="width: auto;">
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
    </div>
</div>

<!-- ▼ Backfill analysis modal -->
<div class="modal fade" id="backfillModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-clock-history me-2"></i>@T["Editor.TripsAnalyzeLocationHistory"]
                    <i class="bi bi-question-circle text-muted ms-2 backfill-help" role="button" tabindex="0"
                       data-tippy-content="@T["Editor.TripsThisToolScansYourLocationHistory"]"></i>
                </h5>
                <button type="button" class="btn-close" aria-label="@T["Editor.TripsClose"]" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Configuration Phase -->
                <div id="backfill-config">
                    <p class="mb-3">
                        @T["Editor.TripsAnalyzingTrip"] <strong id="backfill-trip-name"></strong>
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="backfill-from-date" class="form-label">
                                @T["Editor.TripsFromDateOptional"]
                                <i class="bi bi-question-circle text-muted small backfill-help" role="button" tabindex="0"
                                   data-tippy-content="@T["Editor.TripsOnlyAnalyzeLocationHistoryFromThis"]"></i>
                            </label>
                            <input type="date" class="form-control" id="backfill-from-date">
                        </div>
                        <div class="col-md-6">
                            <label for="backfill-to-date" class="form-label">
                                @T["Editor.TripsToDateOptional"]
                                <i class="bi bi-question-circle text-muted small backfill-help" role="button" tabindex="0"
                                   data-tippy-content="@T["Editor.TripsOnlyAnalyzeLocationHistoryUpTo"]"></i>
                            </label>
                            <input type="date" class="form-control" id="backfill-to-date">
                        </div>
                    </div>
                    <div class="alert alert-light small mb-0">
                        <i class="bi bi-lightbulb me-1"></i>
                        @T["Editor.TripsTheAnalysisSearchesYourLocationHistory"]
                    </div>
                </div>

                <!-- Loading Phase -->
                <div id="backfill-loading" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">@T["Editor.TripsAnalyzing"]</span>
                    </div>
                    <p class="mb-0">@T["Editor.TripsAnalyzingLocationHistory"]</p>
                </div>

                <!-- Results Phase -->
                <div id="backfill-results" class="d-none">
                    <!-- Summary -->
                    <div class="alert alert-info mb-3">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="fw-bold" id="result-locations">0</div>
                                <small class="text-muted backfill-help" role="button" tabindex="0"
                                       data-tippy-content="@T["Editor.TripsTotalGPSLocationPointsThatMatched"]">
                                    @T["Editor.TripsLocations"] <i class="bi bi-info-circle"></i>
                                </small>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold" id="result-places">0</div>
                                <small class="text-muted backfill-help" role="button" tabindex="0"
                                       data-tippy-content="@T["Editor.TripsNumberOfPlacesInThisTrip"]">
                                    @T["Editor.PlaceGroup"] <i class="bi bi-info-circle"></i>
                                </small>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold" id="result-time">0ms</div>
                                <small class="text-muted">@T["Editor.TripsAnalysisTime"]</small>
                            </div>
                        </div>
                    </div>

                    <!-- Search filter (shown with results) -->
                    <div id="backfill-search-wrapper" class="mb-2 d-none">
                        <div class="backfill-search-group">
                            <input type="text" class="form-control form-control-sm pe-4"
                                   id="backfill-search" placeholder="@T["Editor.TripsSearchPlacesRegions"]">
                            <button type="button" class="btn-search-clear d-none"
                                    id="backfill-search-clear" title="@T["Editor.TripsClearSearch"]">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs" id="backfillTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed-pane"
                                    type="button" role="tab" aria-controls="confirmed-pane" aria-selected="true">
                                <i class="bi bi-plus-circle text-success me-1"></i>
                                @T["Editor.TripsConfirmed"] <span class="badge bg-success ms-1" id="new-visits-count">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="suggestions-tab" data-bs-toggle="tab" data-bs-target="#suggestions-pane"
                                    type="button" role="tab" aria-controls="suggestions-pane" aria-selected="false">
                                <i class="bi bi-lightbulb text-info me-1"></i>
                                @T["Editor.TripsConsiderAlso"] <span class="badge bg-info ms-1" id="suggested-visits-count">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="stale-tab" data-bs-toggle="tab" data-bs-target="#stale-pane"
                                    type="button" role="tab" aria-controls="stale-pane" aria-selected="false">
                                <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                                @T["Editor.TripsStale"] <span class="badge bg-warning text-dark ms-1" id="stale-visits-count">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="existing-tab" data-bs-toggle="tab" data-bs-target="#existing-pane"
                                    type="button" role="tab" aria-controls="existing-pane" aria-selected="false">
                                <i class="bi bi-check-circle text-primary me-1"></i>
                                @T["Editor.TripsExisting"] <span class="badge bg-primary ms-1" id="existing-visits-count">0</span>
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content pt-3" id="backfillTabContent">
                        <!-- Confirmed (New Visits) Tab -->
                        <div class="tab-pane fade show active" id="confirmed-pane" role="tabpanel" aria-labelledby="confirmed-tab">
                            <div id="new-visits-hint" class="alert alert-success small py-2 mb-2 d-none">
                                <i class="bi bi-check-circle me-1"></i>
                                @T["Editor.TripsTheseVisitsWillBeAutomaticallyCreated"]
                                <i class="bi bi-question-circle text-muted ms-1 backfill-help" role="button" tabindex="0"
                                   data-tippy-content="@T["Editor.TripsConfirmedVisitsAreDaysWhenYour"]"></i>
                            </div>
                            <div id="new-visits-list" class="list-group list-group-flush" style="max-height: min(50vh, 500px); overflow-y: auto;">
                                <!-- Populated by JS -->
                            </div>
                            <div id="no-new-visits" class="text-muted small d-none">
                                <i class="bi bi-check-circle me-1"></i>
                                @T["Editor.TripsNoNewVisitsFoundYouMay"]
                            </div>
                        </div>

                        <!-- Consider Also (Suggestions) Tab -->
                        <div class="tab-pane fade" id="suggestions-pane" role="tabpanel" aria-labelledby="suggestions-tab">
                            <div id="suggested-visits-hint" class="alert alert-info small py-2 mb-2 d-none">
                                <i class="bi bi-lightbulb me-1"></i>
                                @T["Editor.TripsTheseArePotentialVisitsWithSome"]
                                <i class="bi bi-question-circle text-muted ms-1 backfill-help" role="button" tabindex="0"
                                   data-tippy-content="@T["Editor.TripsSuggestionsUseGPSPointsAtSeveral"]"></i>
                            </div>
                            <div id="suggested-select-all-wrapper" class="d-flex justify-content-end mb-2 d-none">
                                <a href="#" class="small text-decoration-none" id="suggested-select-all">@T["Editor.TripsSelectAll"]</a>
                                <span class="text-muted mx-1">|</span>
                                <a href="#" class="small text-decoration-none" id="suggested-deselect-all">@T["Editor.TripsDeselectAll"]</a>
                            </div>
                            <div id="suggested-visits-list" class="list-group list-group-flush" style="max-height: min(50vh, 500px); overflow-y: auto;">
                                <!-- Populated by JS -->
                            </div>
                            <div id="no-suggested-visits" class="text-muted small d-none">
                                <i class="bi bi-check-circle me-1"></i>
                                @T["Editor.TripsNoAdditionalSuggestionsAllPotentialVisits"]
                            </div>
                        </div>

                        <!-- Stale Visits Tab -->
                        <div class="tab-pane fade" id="stale-pane" role="tabpanel" aria-labelledby="stale-tab">
                            <div id="stale-visits-hint" class="alert alert-warning small py-2 mb-2 d-none">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                @T["Editor.TripsCheckedVisitsWillBeDeletedThese"]
                                <i class="bi bi-question-circle text-muted ms-1 backfill-help" role="button" tabindex="0"
                                   data-tippy-content="@T["Editor.TripsStaleVisitsReferToADeleted"]"></i>
                            </div>
                            <div id="stale-select-all-wrapper" class="d-flex justify-content-end mb-2 d-none">
                                <a href="#" class="small text-decoration-none" id="stale-select-all">@T["Editor.TripsSelectAll"]</a>
                                <span class="text-muted mx-1">|</span>
                                <a href="#" class="small text-decoration-none" id="stale-deselect-all">@T["Editor.TripsDeselectAll"]</a>
                            </div>
                            <div id="stale-visits-list" class="list-group list-group-flush" style="max-height: min(50vh, 500px); overflow-y: auto;">
                                <!-- Populated by JS -->
                            </div>
                            <div id="no-stale-visits" class="text-muted small d-none">
                                <i class="bi bi-check-circle me-1"></i>
                                @T["Editor.TripsNoStaleVisitsFoundAllExisting"]
                            </div>
                        </div>

                        <!-- Existing Visits Tab -->
                        <div class="tab-pane fade" id="existing-pane" role="tabpanel" aria-labelledby="existing-tab">
                            <div id="existing-visits-hint" class="alert alert-secondary small py-2 mb-2 d-none">
                                <i class="bi bi-shield-check me-1"></i>
                                @T["Editor.TripsTheseAreValidVisitsTheyRemain"]
                                <i class="bi bi-question-circle text-muted ms-1 backfill-help" role="button" tabindex="0"
                                   data-tippy-content="@T["Editor.TripsExistingVisitsAreValidRecordsFor"]"></i>
                            </div>
                            <div id="existing-select-all-wrapper" class="d-flex justify-content-end mb-2 d-none">
                                <a href="#" class="small text-decoration-none" id="existing-select-all">@T["Editor.TripsSelectAll"]</a>
                                <span class="text-muted mx-1">|</span>
                                <a href="#" class="small text-decoration-none" id="existing-deselect-all">@T["Editor.TripsDeselectAll"]</a>
                            </div>
                            <div id="existing-visits-list" class="list-group list-group-flush" style="max-height: min(50vh, 500px); overflow-y: auto;">
                                <!-- Populated by JS -->
                            </div>
                            <div id="no-existing-visits" class="text-muted small d-none">
                                <i class="bi bi-inbox me-1"></i>
                                @T["Editor.TripsNoExistingVisitsForThisTrip"]
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Action Summary (shown before Apply) -->
            <div id="action-summary" class="px-3 pb-2 d-none">
                <div class="alert alert-light border mb-0 small">
                    <strong>@T["Editor.TripsActionsToPerform"]</strong>
                    <ul class="mb-0 ps-3">
                        <li id="summary-create" class="d-none"></li>
                        <li id="summary-confirm-suggestions" class="d-none text-info"></li>
                        <li id="summary-delete-stale" class="d-none text-warning"></li>
                        <li id="summary-delete-manual" class="d-none text-danger"></li>
                        <li id="summary-nothing" class="d-none text-muted">@T["Editor.TripsNoChangesToApply"]</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Editor.TripsCancel"]</button>
                <button type="button" class="btn btn-primary" id="btn-backfill-analyze">
                    <i class="bi bi-search me-1"></i>@T["Editor.TripsAnalyze"]
                </button>
                <button type="button" class="btn btn-success d-none" id="btn-backfill-apply">
                    <i class="bi bi-check-lg me-1"></i>@T["Editor.TripsApplyChanges"]
                </button>
            </div>
        </div>
    </div>
</div>

@* Review is mounted separately from Bootstrap transitions so retained files and errors stay reachable. *@
<section id="trip-import-controls" class="card p-3 my-3" hidden aria-label="@T["Editor.TripsImportReview"]" data-owner="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    <h3 id="importSelectedFile" class="h5"></h3>
    <p id="importChoiceMessage" role="status"></p>
    <p>@T["Editor.TripsUpdateReplacesGeographyNotesTagsAnd"]</p>
    <div id="importPlanningRows"></div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" id="btnUpdate" class="btn btn-outline-primary">@T["Editor.TripsReviewUpdate"]</button>
        <button type="button" id="btnApplyImport" class="btn btn-primary" hidden>@T["Editor.TripsApplyReviewedUpdate"]</button>
        <button type="button" id="btnCopy" class="btn btn-outline-secondary">@T["Editor.TripsCreateNewTrip2"]</button>
        <button type="button" id="btnCancelImport" class="btn btn-outline-secondary">@T["Editor.TripsCancel"]</button>
        <a href="/User/Trip" target="_blank" rel="noopener" class="btn btn-link">@T["Editor.TripsCheckMyTrips"]</a>
        @* This explicit local recovery never represents a server cancellation or a confirmed outcome. *@
        <button type="button" id="btnAbandonImport" class="btn btn-outline-danger" hidden>@T["Editor.TripsAbandonUnresolvedAttempt"]</button>
    </div>
</section>

<!-- ▼ Place Context Map modal (stacked above backfill modal) -->
<div class="modal fade" id="placeContextModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="placeContextTitle">
                    <i class="bi bi-geo-alt me-1"></i>@T["Editor.TripsPlaceContext"]
                </h5>
                <button type="button" class="btn-close" aria-label="@T["Editor.TripsClose"]" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="placeContextMap"></div>
                <div id="placeContextInfo" class="p-3 border-top small">
                    <div class="row text-center">
                        <div class="col">
                            <div class="fw-bold" id="context-ping-count">-</div>
                            <small class="text-muted">@T["Editor.TripsLocationPings"]</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" id="context-time-range">-</div>
                            <small class="text-muted">@T["Editor.TripsTimeRange"]</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" id="context-avg-distance">-</div>
                            <small class="text-muted">@T["Editor.TripsAvgDistance"]</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" id="context-closest-ping">-</div>
                            <small class="text-muted">@T["Editor.TripsClosestPing"]</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" id="context-furthest-ping">-</div>
                            <small class="text-muted">@T["Editor.TripsFurthestPing"]</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <div class="me-auto d-flex align-items-center gap-2">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        <i class="bi bi-rulers"></i> @T["Editor.TripsClickTheRulerIconToMeasure"]
                    </small>
                    <span id="context-external-links"></span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@T["Editor.TripsClose"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    @Html.FrontendViewScripts()
    @if (Environment.IsDevelopment())
    {
        <script type="module" src="http://localhost:5173/ClientApps/trip-editor/src/recovery/myTrips.ts"></script>
    }
    else if (Wayfarer.Util.ViteAssets.Read(Environment.WebRootPath, "ClientApps/trip-editor/src/recovery/myTrips.ts").Script is string recoveryScript)
    {
        <script type="module" src="@recoveryScript"></script>
    }
    <script type="module" src="~/js/Areas/User/Trip/compositionEntries.js" asp-append-version="true"></script>
}
