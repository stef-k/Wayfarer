@using System.Globalization
@using Wayfarer.Localization
@inject WebMessages T
@model IEnumerable<Wayfarer.Models.LocationImport>
@using Wayfarer.Services.LocationEnrichment
@{
    ViewData["Title"] = T["Shell.LocationImports"];
    ViewData["WebCatalog"] = "Transfers";
    var managedFiles = ViewData["ManagedFiles"] as Dictionary<int, string>;
    ViewData["BodyClass"] = "container-fluid";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-controller="LocationImport" asp-action="Upload" class="btn btn-primary">
        <i class="bi bi-upload"></i> @T["Transfers.UploadNew"]
    </a>
</div>

<div class="alert alert-light small mb-3">
    <i class="bi bi-lightbulb me-1"></i>
    @T["Transfers.HowItWorks"]
</div>

<!-- Keep the dense import-history table inside its own horizontal scroll surface on phones. -->
<div class="table-responsive">
<table class="table table-striped" id="locationImport">
    <thead>
        <tr>
            <th>@T["Transfers.FileName"]</th>
            <th>@T["Transfers.UploadedAt"]</th>
            <th>
                @T["Transfers.Status"]
                <i class="bi bi-question-circle text-muted ms-1"
                   data-tippy-content="@T["Transfers.StatusHelp"]"></i>
            </th>
            <th>@T["Transfers.ProcessedRecords"]</th>
            <th>@T["Transfers.LastRecord"]</th>
            <th>@T["Transfers.Errors"]</th>
            <th>@T["Shell.Actions"]</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var import in Model)
    {
        var (statusKey, badge) = LocationTransferText.ImportStatusDisplay(import.Status);
        var managedState = managedFiles?.GetValueOrDefault(import.Id);
        var failureKey = LocationTransferText.ImportFailureKey(import);
        <tr>
            <td class="filePath">@Wayfarer.Services.LocationImports.LocationImportStagedFiles.DisplayName(import.FilePath)</td>
            <td><time datetime="@import.CreatedAt.ToString("O", CultureInfo.InvariantCulture)">@import.CreatedAt.ToString("g", T.DisplayCulture)</time></td>
            <td class="importStatus"><span class="badge @badge">@T[statusKey]</span></td>
            <td class="text-center lastProcessedIndex">
                @T["Transfers.Progress", T.DisplayNumber(import.LastProcessedIndex), T.DisplayNumber(import.TotalRecords)]
                @if (import.SkippedDuplicates > 0)
                {
                    <div class="text-body-secondary">@T.Count("Transfers.DuplicatesSkipped", import.SkippedDuplicates)</div>
                }
                @* Suppressed records are processed without restoring intentionally deleted history. *@
                @if (import.SkippedDeleted > 0)
                {
                    <div class="text-body-secondary" role="status">@T.Count("Transfers.DeletedSkipped", import.SkippedDeleted)</div>
                }
            </td>
            <td class="text-center lastImportedRecord">@LocationTransferText.LastRecord(T, import.LastImportedRecord)</td>
            <td class="text-center errorMessage">
                @if (failureKey != null)
                {
                    <div>@T[failureKey]</div>
                }
                @if (import.ManagedUpload)
                {
                    <div class="text-body-secondary">@T["Transfers.ManagedPayload", T[LocationTransferText.CustodyKey(managedState)]]</div>
                }
                @if (import.DeletionRequestedAtUtc.HasValue)
                {
                    <div class="text-body-secondary" role="status">@T["Transfers.DeletePending"]</div>
                }
                @* Classification feedback remains distinct from processing failures. *@
                @if (import.UnclassifiedActivityCount > 0)
                {
                    <div class="text-warning-emphasis" role="status">
                        @T.Count("Transfers.InvalidActivity", import.UnclassifiedActivityCount)
                    </div>
                }
            </td>
            <td>
                @{
                    // Existing lifecycle and custody values decide which controls to display.
                    bool showDropdown = false;
                    string? primaryKey = null, primaryAction = null;

                    // Only persisted Retained custody permits a managed restart; Web antiforgery remains unchanged.
                    if (import.ManagedUpload && managedState != ManagedImportFileState.Retained)
                    {
                        primaryKey = managedState == ManagedImportFileState.Removed ? "PayloadRemoved" : "PayloadCleanup";
                        showDropdown = true;
                    }
                    else if (import.Status == ImportStatus.Stopped || import.Status == ImportStatus.Failed)
                    {
                        primaryKey = import.Status == ImportStatus.Failed ? "Retry"
                            : import.StopRequestedAtUtc.HasValue || import.LastProcessedIndex > 0 ? "Resume" : "Start";
                        primaryAction = "start";
                        showDropdown  = true;
                    }
                    else if (import.Status == ImportStatus.InProgress)
                    {
                        primaryKey = "Stop";
                        primaryAction = "stop";
                        showDropdown  = true;
                    }
                    else if (import.Status == ImportStatus.Stopping)
                    {
                        primaryKey = "Stopping";
                        // disabled, no action
                    }
                    else if (import.Status == ImportStatus.Completed)
                    {
                        // no primary, but allow delete
                        showDropdown = true;
                    }
                }

                <div class="btn-group">
                    @* Primary action button *@
                    @if (primaryKey != null)
                    {
                        <button
                            type="button"
                            class="btn btn-sm btn-primary js-import-action"
                            data-action="@primaryAction"
                            data-text-key="@primaryKey"
                            data-id="@import.Id"
                            disabled="@(primaryAction == null)">
                            @T[$"Transfers.Action.{primaryKey}"]
                        </button>
                    }

                    @* Dropdown for Delete/Cancel *@
                    @if (showDropdown)
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="visually-hidden">@T["Transfers.MoreActions"]</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#"
                                   class="dropdown-item text-danger js-delete-import"
                                   data-id="@import.Id">
                                    @T["Shell.Delete"]
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">@T["Transfers.Empty"]</div>
}

@* Hidden antiforgery token *@
<div style="display:none;">
    @Html.AntiForgeryToken()
</div>

@* Pre-generate all URLs into a JS config object *@
<script>
    window.__locationImportConfig = {
        deleteUrl      : '@Url.Action("Delete",      "LocationImport")',
        startImportUrl : '@Url.Action("StartImport", "LocationImport")',
        stopImportUrl  : '@Url.Action("StopImport",  "LocationImport")'
    };
</script>

@section Scripts {
    @Html.FrontendViewScripts()
}
@{
    var enrichment = ViewData["EnrichmentPresentation"] as LocationEnrichmentPresentationModel
        ?? throw new InvalidOperationException("Enrichment presentation was not projected.");
}
<section class="card mb-3" aria-labelledby="enrichment-heading">
    <div class="card-body">
        <h2 id="enrichment-heading" class="h5">@T["Transfers.EnrichmentHeading"]</h2>
        <p class="small">@T["Transfers.EnrichmentHelp"]</p>
        <dl class="row" aria-label="@T["Transfers.EnrichmentStatus"]">
            <dt class="col-sm-4">@T["Transfers.WorkflowState"]</dt><dd class="col-sm-8">@T[$"Transfers.Workflow.{enrichment.StatusText}"]</dd>
            <dt class="col-sm-4">@T["Transfers.Provider"]</dt><dd class="col-sm-8">@(enrichment.ProviderKey is null ? T["Transfers.ProviderNotSelected"] : enrichment.ProviderDisplayName)</dd>
            <dt class="col-sm-4">@T["Transfers.ProviderAvailability"]</dt><dd class="col-sm-8">@T[LocationTransferText.AvailabilityKey(enrichment)]</dd>
            <dt class="col-sm-4">@T["Transfers.WayfarerUsage"]</dt><dd class="col-sm-8">@T["Transfers.UsageSummary", T.DisplayNumber(enrichment.ProviderUsage), T.DisplayNumber(enrichment.ProviderLimit),
                T[enrichment.UsageUnit == "contacts" ? "Transfers.Contacts" : "Transfers.Credits"]]
                @T[enrichment.ProviderKey switch
                {
                    "geoapify" => "Transfers.GeoapifyWindow",
                    "mapbox" => "Transfers.MapboxWindow",
                    _ => "Transfers.NoUsageWindow"
                }]
                @T[enrichment.GuardEnabled ? "Transfers.GuardEnabled" : "Transfers.GuardDisabled"]</dd>
            @if (enrichment.ProviderNextAvailableAtUtc.HasValue)
            { <dt class="col-sm-4">@T["Transfers.CapacityReturns"]</dt><dd class="col-sm-8"><time datetime="@enrichment.ProviderNextAvailableAtUtc.Value.ToString("O", CultureInfo.InvariantCulture)">@LocationTransferText.UtcDate(T, enrichment.ProviderNextAvailableAtUtc.Value)</time></dd> }
            <dt class="col-sm-4">@T["Transfers.ProcessedCandidates"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.Processed)</dd>
            <dt class="col-sm-4">@T["Transfers.Enriched"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.Enriched)</dd>
            <dt class="col-sm-4">@T["Transfers.EnrichmentSkipped"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.Skipped)</dd>
            <dt class="col-sm-4">@T["Transfers.Runnable"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.RunnableRemaining)</dd>
            <dt class="col-sm-4">@T["Transfers.FutureDue"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.FutureDue)</dd>
            @* Operation ownership is distinct from readiness and stored address shape. *@
            <dt class="col-sm-4">@T["Transfers.InFlight"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.InFlight)</dd>
            <dt class="col-sm-4">@T["Transfers.AwaitingRecovery"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.AwaitingRecovery)</dd>
            <dt class="col-sm-4">@T["Transfers.ManualRetry"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.ManualRetryAvailable)</dd>
            <dt class="col-sm-4">@T["Transfers.CannotRetry"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.CannotBeRetried)</dd>
            <dt class="col-sm-4">@T["Transfers.IncompleteAddresses"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.IncompleteProviderAddresses)</dd>
            <dt class="col-sm-4">@T["Transfers.FailedBatches"]</dt><dd class="col-sm-8">@T.DisplayNumber(enrichment.FailedBatches)</dd>
            <dt class="col-sm-4">@T["Transfers.LastOutcome"]</dt><dd class="col-sm-8">@T[$"Transfers.Outcome.{enrichment.LastOutcome}"]</dd>
            @if (enrichment.NextAttemptAtUtc.HasValue)
            { <dt class="col-sm-4">@T["Transfers.NextAttempt"]</dt><dd class="col-sm-8"><time datetime="@enrichment.NextAttemptAtUtc.Value.ToString("O", CultureInfo.InvariantCulture)">@LocationTransferText.UtcDate(T, enrichment.NextAttemptAtUtc.Value)</time></dd> }
        </dl>
        <p class="small">@T["Transfers.ProviderUsageHelp"]</p>
        @if (enrichment.IncompleteProviderAddresses > 0)
        {
            <p class="small">@T["Transfers.IncompleteHelp"]</p>
        }
        @if (enrichment.RepairsWithoutLocality > 0)
        {
            <p class="small">@T.Count("Transfers.RepairsWithoutLocality", enrichment.RepairsWithoutLocality)</p>
        }
        @if (!enrichment.IntentEnabled && enrichment.FutureDue > 0)
        {
            <p class="small">@T["Transfers.StoppedRetryHelp"]</p>
        }
        <p id="enrichment-status" role="status">@T[LocationTransferText.EnrichmentReasonKey(enrichment)]</p>
        <div class="d-flex gap-2 flex-wrap" aria-label="@T["Transfers.EnrichmentActions"]">
            @if (enrichment.Start.Visible) { <form asp-action="StartEnrichment" method="post"><button class="btn btn-primary" type="submit" aria-describedby="enrichment-status">@T["Transfers.StartEnrichment"]</button></form> }
            @if (enrichment.Pause.Visible) { <form asp-action="PauseEnrichment" method="post"><button class="btn btn-outline-secondary" type="submit" aria-describedby="enrichment-status">@T["Transfers.PauseEnrichment"]</button></form> }
            @if (enrichment.Resume.Visible) { <form asp-action="ResumeEnrichment" method="post"><button class="btn btn-outline-primary" type="submit" aria-describedby="enrichment-status" disabled="@(!enrichment.Resume.Enabled)">@T["Transfers.ResumeEnrichment"]</button></form> }
            @if (enrichment.Cancel.Visible) { <form asp-action="CancelEnrichment" method="post"><button class="btn btn-outline-danger" type="submit" aria-describedby="enrichment-status">@T["Transfers.CancelEnrichment"]</button></form> }
            @if (enrichment.RetryDeferred.Visible) { <form asp-action="RetryDeferredEnrichment" method="post"><button class="btn btn-outline-warning" type="submit" aria-describedby="enrichment-status">@T["Transfers.RetryEnrichment"]</button><div class="form-text">@T["Transfers.RetryCost"]</div></form> }
            @if (enrichment.RepairIncomplete.Visible) { <form asp-action="RepairIncompleteAddresses" method="post"><button class="btn btn-outline-primary" type="submit" aria-describedby="enrichment-status" disabled="@(!enrichment.RepairIncomplete.Enabled)">@T["Transfers.RepairIncomplete"]</button><div class="form-text">@T["Transfers.RepairCost"]</div></form> }
        </div>
    </div>
</section>
