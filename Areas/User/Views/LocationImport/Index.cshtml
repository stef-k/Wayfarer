@using Wayfarer.Models.LocationEnrichment
@model IEnumerable<Wayfarer.Models.LocationImport>
@using Wayfarer.Services.LocationEnrichment
@{
    ViewData["BodyClass"] = "container-fluid";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-controller="LocationImport" asp-action="Upload" class="btn btn-primary">
        <i class="bi bi-upload"></i> Upload New File
    </a>
</div>

<div class="alert alert-light small mb-3">
    <i class="bi bi-lightbulb me-1"></i>
    <strong>How it works:</strong> Import location history from Google Timeline (JSON format from Google Takeout).
    Large files are processed in the background - you can leave this page and check back later.
</div>

<!-- Keep the dense import-history table inside its own horizontal scroll surface on phones. -->
<div class="table-responsive">
<table class="table table-striped" id="locationImport" data-user-id="@ViewData["UserId"]">
    <thead>
        <tr>
            <th>File Name</th>
            <th>Uploaded At</th>
            <th>
                Status
                <i class="bi bi-question-circle text-muted ms-1"
                   data-tippy-content="InProgress: currently processing. Completed: finished successfully. Stopped: paused by user. Failed: encountered errors."></i>
            </th>
            <th>Processed Records</th>
            <th>Last Processed Record</th>
            <th>Errors</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var import in Model)
    {
        <tr>
            <td class="filePath">@System.IO.Path.GetFileName(import.FilePath)</td>
            <td>@import.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="importStatus">
                @if (import.Status == ImportStatus.Stopped)
                {
                    <span class="badge bg-dark">@import.Status</span>
                }
                else if (import.Status == ImportStatus.Completed)
                {
                    <span class="badge bg-success">@import.Status</span>
                }
                else if (import.Status == ImportStatus.Failed)
                {
                    <span class="badge bg-danger">@import.Status</span>
                }
                else if (import.Status == ImportStatus.InProgress)
                {
                    <span class="badge bg-info">@import.Status</span>
                }
                else if (import.Status == ImportStatus.Stopping)
                {
                    <span class="badge bg-secondary">@import.Status</span>
                }
            </td>
            <td class="text-center lastProcessedIndex" data-total-records="@import.TotalRecords">
                @import.LastProcessedIndex of @import.TotalRecords
            </td>
            <td class="text-center lastImportedRecord">
                @import.LastImportedRecord
            </td>
            <td class="text-center errorMessage">
                @import.ErrorMessage
            </td>
            <td>
                @{
                    // decide which primary button to show
                    bool showDropdown = false;
                    string? primaryLabel = null, primaryAction = null;

                    if (import.Status == ImportStatus.Stopped || import.Status == ImportStatus.Failed)
                    {
                        primaryLabel  = "Start";
                        primaryAction = "start";
                        showDropdown  = true;
                    }
                    else if (import.Status == ImportStatus.InProgress)
                    {
                        primaryLabel  = "Stop";
                        primaryAction = "stop";
                        showDropdown  = true;
                    }
                    else if (import.Status == ImportStatus.Stopping)
                    {
                        primaryLabel = "Stopping…";
                        // disabled, no action
                    }
                    else if (import.Status == ImportStatus.Completed)
                    {
                        // no primary, but allow delete
                        showDropdown = true;
                    }
                }

                <div class="btn-group">
                    @* Primary action button *@
                    @if (primaryLabel != null)
                    {
                        <button
                            type="button"
                            class="btn btn-sm btn-primary js-import-action"
                            data-action="@primaryAction"
                            data-id="@import.Id"
                            @(primaryAction == null ? "disabled" : "")>
                            @primaryLabel
                        </button>
                    }

                    @* Dropdown for Delete/Cancel *@
                    @if (showDropdown)
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#"
                                   class="dropdown-item text-danger js-delete-import"
                                   data-id="@import.Id"
                                   data-status="@import.Status">
                                    Delete
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No location import records found.</div>
}

@* Hidden antiforgery token *@
<div style="display:none;">
    @Html.AntiForgeryToken()
</div>

@* Pre-generate all URLs into a JS config object *@
<script>
    window.__locationImportConfig = {
        deleteUrl      : '@Url.Action("Delete",      "LocationImport")',
        startImportUrl : '@Url.Action("StartImport", "LocationImport")',
        stopImportUrl  : '@Url.Action("StopImport",  "LocationImport")'
    };
    const locationImport = document.getElementById('locationImport');
    const userId = locationImport.dataset.userId;
</script>

@section Scripts {
    @Html.FrontendViewScripts()
}
@{
    var enrichment = ViewData["EnrichmentPresentation"] as LocationEnrichmentPresentationModel
        ?? throw new InvalidOperationException("Enrichment presentation was not projected.");
}
<section class="card mb-3" aria-labelledby="enrichment-heading">
    <div class="card-body">
        <h2 id="enrichment-heading" class="h5">Missing-address enrichment</h2>
        <p class="small">Importing may finish before enrichment. Imported Locations remain safe if enrichment is paused,
            cancelled, or fails, and large histories may take days. Cancelling enrichment does not cancel or delete imports.</p>
        <dl class="row" aria-label="Durable enrichment status">
            <dt class="col-sm-4">Workflow state</dt><dd class="col-sm-8">@enrichment.StatusText</dd>
            <dt class="col-sm-4">Provider</dt><dd class="col-sm-8">@enrichment.ProviderDisplayName</dd>
            <dt class="col-sm-4">Provider availability</dt><dd class="col-sm-8">@enrichment.ProviderAvailabilitySummary</dd>
            <dt class="col-sm-4">Wayfarer usage</dt><dd class="col-sm-8">@enrichment.ProviderUsage of @enrichment.ProviderLimit @enrichment.UsageUnit; @enrichment.UsageWindowDescription. Guard/meter @(enrichment.GuardEnabled ? "enabled" : "disabled").</dd>
            <dt class="col-sm-4">Processed candidates</dt><dd class="col-sm-8">@enrichment.Processed</dd>
            <dt class="col-sm-4">Enriched</dt><dd class="col-sm-8">@enrichment.Enriched</dd>
            <dt class="col-sm-4">Skipped</dt><dd class="col-sm-8">@enrichment.Skipped</dd>
            <dt class="col-sm-4">Runnable now</dt><dd class="col-sm-8">@enrichment.RunnableRemaining</dd>
            <dt class="col-sm-4">Retryable later</dt><dd class="col-sm-8">@enrichment.FutureDue</dd>
            <dt class="col-sm-4">Permanently deferred</dt><dd class="col-sm-8">@enrichment.PermanentlyDeferred</dd>
            <dt class="col-sm-4">Failed batches</dt><dd class="col-sm-8">@enrichment.FailedBatches</dd>
            <dt class="col-sm-4">Last outcome</dt><dd class="col-sm-8">@enrichment.LastOutcome</dd>
            @if (enrichment.NextAttemptAtUtc.HasValue)
            { <dt class="col-sm-4">Next attempt</dt><dd class="col-sm-8"><time datetime="@enrichment.NextAttemptAtUtc.Value.ToString("O")">@enrichment.NextAttemptAtUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")</time></dd> }
        </dl>
        <p class="small">Geoapify geocoding and routing share Wayfarer's rolling pool; usage elsewhere in your
            provider account is not visible here. Mapbox Permanent requires separate consent and uses Wayfarer's
            independent monthly meter. Deleting import history does not delete Locations or enrichment.</p>
        <p id="enrichment-status" role="status">@(enrichment.PausedReason ?? enrichment.NoActionReason
            ?? "Choose an available enrichment action.")</p>
        <div class="d-flex gap-2 flex-wrap" aria-label="Enrichment actions">
            @if (enrichment.Start.Visible) { <form asp-action="StartEnrichment" method="post"><button class="btn btn-primary" type="submit" aria-describedby="enrichment-status">Start enrichment</button></form> }
            @if (enrichment.Pause.Visible) { <form asp-action="PauseEnrichment" method="post"><button class="btn btn-outline-secondary" type="submit" aria-describedby="enrichment-status">Pause enrichment</button></form> }
            @if (enrichment.Resume.Visible) { <form asp-action="ResumeEnrichment" method="post"><button class="btn btn-outline-primary" type="submit" aria-describedby="enrichment-status" disabled="@(!enrichment.Resume.Enabled)">Resume enrichment</button></form> }
            @if (enrichment.Cancel.Visible) { <form asp-action="CancelEnrichment" method="post"><button class="btn btn-outline-danger" type="submit" aria-describedby="enrichment-status">Cancel enrichment</button></form> }
            @if (enrichment.RetryDeferred.Visible) { <form asp-action="RetryDeferredEnrichment" method="post"><button class="btn btn-outline-warning" type="submit" aria-describedby="enrichment-status">Retry deferred enrichment</button></form> }
        </div>
    </div>
</section>
