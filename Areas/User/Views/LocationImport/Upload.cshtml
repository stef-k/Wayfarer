@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ViewModels.LocationImportUploadViewModel
@{
    ViewData["Title"] = T["Shell.UploadLocationData"];
    ViewData["LanguageSafeGet"] = Url.Action("Upload");
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-2">
            <div class="card shadow-sm">
                <div class="card-header text-bg-primary mb-3">
                    <h2>@T["Transfers.UploadHistory"]</h2>
                </div>

                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(true, T["Transfers.CorrectErrors"])
                        </div>

                    }

                    @* Report the effective request policy, including multipart overhead. *@
                    @if (ViewBag.UploadsDisabled == true)
                    {
                        <p class="alert alert-warning">@T["Transfers.UploadsDisabled"]</p>
                    }
                    else
                    {
                        <p class="mb-3">
                            @T["Transfers.UploadLimit", T.DisplayNumber((int)ViewBag.UploadLimit)]
                        </p>
                    }

                    @* Explain the shared-catalog side effect before the owner submits history. *@
                    <p class="form-text mb-3">
                        @T["Transfers.ActivityHelp"]
                    </p>

                    <form asp-area="User" asp-controller="LocationImport" asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="fileUpload" class="form-label">@T["Transfers.SelectFile"]</label>
                            <input asp-for="File" id="fileUpload" class="form-control" accept="@ViewBag.AcceptedExtensions" />
                            @Html.ValidationMessageFor(m => m.File, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label for="fileType" class="form-label">@T["Transfers.FileType"]</label>
                            @Html.DropDownListFor(m => m.FileType, (IEnumerable<SelectListItem>)ViewBag.FileTypes, new { id = "fileType", @class = "form-select" })

                            @Html.ValidationMessageFor(m => m.FileType, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-check mb-1">
                            <input asp-for="EnrichmentRequested" class="form-check-input" />
                            <label asp-for="EnrichmentRequested" class="form-check-label">
                                @T["Transfers.ContinueEnrichment"]
                            </label>
                            <span asp-validation-for="EnrichmentRequested" class="text-danger"></span>
                        </div>
                        <p class="form-text mb-3">
                            @T["Transfers.ContinueHelp"]
                        </p>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-outline-primary" disabled="@(ViewBag.UploadsDisabled == true)">@T["Transfers.UploadFile"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
