@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Areas.User.ConnectionModels.ConnectionTokenViewModel
@{
    ViewData["Title"] = T["Connection.Title"];
    ViewData["WebCatalog"] = "Connection";
}
@* Razor emits only safe status and antiforgery. A successful POST owns the one-time token and local QR. *@
<div class="container py-3" id="connect-apps" data-token-id="@Model.Status?.TokenId"
     data-issued-at="@Model.Status?.IssuedAt.ToString("O")" data-effective-https="@Model.IsHttps.ToString().ToLowerInvariant()">
    <h1>@T["Connection.Title"]</h1>
    <p>@T["Connection.Intro"]</p>
    <p class="text-muted">@T["Connection.Account"] <strong>@Model.UserName</strong> · @T["Connection.ServerAddress"] <span id="connection-origin"></span>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="copy-server" disabled>@T["Connection.CopyServer"]</button></p>
    <div class="alert alert-info" id="connection-message" role="status" hidden></div>
    <section class="card mb-3" aria-labelledby="connection-heading">
        <div class="card-body">
            <h2 class="h4" id="connection-heading">@T["Connection.Token"]</h2>
            <p>@T["Connection.TokenHelp"]</p>
            <p id="connection-status">@(T[Model.Status == null ? "Connection.Absent" : "Connection.Exists"])</p>
            <p class="small text-muted" id="connection-issued">@if (Model.Status != null) { @T["Connection.IssuedAt", Model.Status.IssuedAt.ToString("g", T.DisplayCulture)] }</p>
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-primary" id="issue-connection" disabled>
                @(T[Model.Status == null ? "Connection.Create" : "Connection.Replace"])
            </button>
            <div class="mt-3" id="replace-confirmation" hidden>
                <p>@T["Connection.ReplaceWarning"]</p>
                <button type="button" class="btn btn-danger" id="confirm-replacement">@T["Connection.ConfirmReplace"]</button>
                <button type="button" class="btn btn-outline-secondary" id="cancel-replacement">@T["Shell.Cancel"]</button>
            </div>
            <div class="mt-3" id="connection-reveal" hidden>
                <p>@T["Connection.RevealHelp"]</p>
                <pre class="border rounded p-2 text-break text-wrap" id="connection-token"></pre>
                <button type="button" class="btn btn-outline-primary" id="copy-token">@T["Connection.CopyToken"]</button>
            </div>
            <button type="button" class="btn btn-outline-secondary mt-3" id="hide-connection" hidden>@T["Connection.Hide"]</button>
            <p class="small text-muted mt-3 mb-0">@T["Connection.RecoveryHelp"]</p>
        </div>
    </section>
    <section class="card mb-3" aria-labelledby="mobile-heading">
        <div class="card-body">
            <h2 class="h4" id="mobile-heading">WayfarerMobile</h2>
            <p>@T["Connection.MobileHelp"]</p>
            <div class="mb-3" id="connection-qr" style="max-width:220px" aria-label="@T["Connection.PairingQr"]"></div>
            <a href="https://stef-k.github.io/Wayfarer/user/mobile.html#connect-to-your-instance">@T["Connection.MobileGuide"]</a>
        </div>
    </section>
    <section class="card" aria-labelledby="logger-heading">
        <div class="card-body">
            <h2 class="h4" id="logger-heading">@T["Connection.Loggers"]</h2>
            <p>@T["Connection.LoggerHelp"]</p>
            <p><a href="https://stef-k.github.io/Wayfarer/user/connect-apps.html#use-gpslogger">@T["Connection.LoggerGuide"]</a></p>
            <a class="small text-muted" href="https://stef-k.github.io/Wayfarer/development/api.html">@T["Connection.IntegrationGuide"]</a>
            <span class="small text-muted"> · </span>
            <a class="small text-muted" asp-area="User" asp-controller="LocationProviderSettings" asp-action="Index">@T["Providers.Title"]</a>
        </div>
    </section>
</div>
@section Scripts {
    @* This bundled source supports synchronous SVG; the older minified file does not. *@
    <script src="~/lib/davidshimjs-qrcodejs/qrcode.js" asp-append-version="true"></script>
    @Html.FrontendViewScripts()
}
