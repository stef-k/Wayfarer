@model DeleteUserViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Accounts.DeleteTitle"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("Delete", new { id = Model.Id });
}

<h1 class="text-center">@T["Accounts.DeleteTitle"]</h1>

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-sm mb-4">
                <div class="card-header text-bg-danger">
                    <h3 class="mb-0">@T["Accounts.DeleteQuestion"]</h3>
                </div>
                <div class="card-body">
                    <h3 class="mb-3">@T["Accounts.DeleteTarget", Model.Username, Model.DisplayName]</h3>

                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" asp-area="Admin" asp-controller="Users">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">@T["Shell.Delete"]</button>
                            <a asp-action="Index" class="btn btn-secondary">@T["Shell.Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
