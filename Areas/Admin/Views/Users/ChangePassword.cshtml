@model Wayfarer.Models.ViewModels.ChangePasswordViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Accounts.PasswordChange"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("ChangePassword", new { id = Model.UserId });
}

<partial name="~/Views/Shared/Accounts/_ChangePassword.cshtml" model="Model" />
