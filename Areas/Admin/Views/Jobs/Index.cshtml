@using Wayfarer.Models.ViewModels
@using Wayfarer.Localization
@inject WebMessages T
@model IEnumerable<JobMonitoringViewModel>

@{
    ViewData["Title"] = T["AdminJobs.Title"];
    ViewData["WebCatalog"] = "AdminJobs";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12">
            <!-- Help Section -->
            <div class="accordion mb-4" id="jobHelpAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed py-2" type="button"
                                data-bs-toggle="collapse" data-bs-target="#jobHelpContent"
                                aria-expanded="false" aria-controls="jobHelpContent">
                            <i class="bi bi-question-circle me-2"></i> @T["AdminJobs.Help"]
                        </button>
                    </h2>
                    <div id="jobHelpContent" class="accordion-collapse collapse" data-bs-parent="#jobHelpAccordion">
                        <div class="accordion-body small">
                            <div class="row">
                                <div class="col-md-4">
                                    <h6><span class="badge bg-primary">@T["AdminJobs.Start"]</span></h6>
                                    <p>@T["AdminJobs.StartHelp"]</p>
                                </div>
                                <div class="col-md-4">
                                    <h6><span class="badge bg-warning text-dark">@T["AdminJobs.Pause"]</span></h6>
                                    <p>@T["AdminJobs.PauseHelp"]</p>
                                </div>
                                <div class="col-md-4">
                                    <h6><span class="badge bg-success">@T["AdminJobs.Resume"]</span></h6>
                                    <p>@T["AdminJobs.ResumeHelp"]</p>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4">
                                    <h6><span class="badge bg-danger">@T["AdminJobs.Cancel"]</span></h6>
                                    <p>@T["AdminJobs.CancelHelp"]</p>
                                </div>
                                <div class="col-md-8">
                                    <h6>@T["AdminJobs.Indicators"]</h6>
                                    <ul class="mb-0">
                                        <li><span class="badge bg-success">@T["AdminJobs.Status.Running"]</span> - @T["AdminJobs.RunningHelp"]</li>
                                        <li><span class="badge bg-warning text-dark">@T["AdminJobs.Status.Paused"]</span> - @T["AdminJobs.PausedHelp"]</li>
                                        <li><span class="badge bg-secondary">@T["AdminJobs.Status.Scheduled"]</span> - @T["AdminJobs.ScheduledHelp"]</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search Form -->
            <form method="get" asp-action="Index" class="mb-4">
                <div class="input-group">
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="@T["AdminJobs.Search"]" class="form-control" />
                    <button type="submit" class="btn btn-primary">@T["Shell.Search"]</button>
                </div>
            </form>

            <!-- Job Monitoring Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th class="text-nowrap">
                                @T["AdminJobs.Name"]
                                <i class="bi bi-question-circle text-muted ms-1"
                                   data-tippy-content="@T["AdminJobs.NameHelp"]"></i>
                            </th>
                            <th class="text-nowrap">@T["AdminJobs.Group"]</th>
                            <th class="text-nowrap">@T["AdminJobs.LastRun"]</th>
                            <th class="text-nowrap">@T["AdminJobs.NextRun"]</th>
                            <th>@T["AdminJobs.StatusHeading"]</th>
                            <th>@T["AdminJobs.LastResult"]</th>
                            <th class="text-nowrap">@T["Shell.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr data-job-name="@job.JobName" data-job-group="@job.JobGroup"
                                data-interruptable="@(job.IsInterruptable.ToString().ToLowerInvariant())">
                                <td class="text-nowrap">@job.JobName</td>
                                <td class="text-nowrap">@job.JobGroup</td>
                                <td class="text-nowrap">
                                    @if (job.LastRunTime != null)
                                    {
                                        <span>@job.LastRunTime?.ToString("g", T.DisplayCulture)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@T["AdminJobs.NeverRun"]</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (job.IsPaused)
                                    {
                                        <span class="text-muted">@T["AdminJobs.Status.Paused"]</span>
                                    }
                                    else
                                    {
                                        @job.NextFireTime?.ToString("g", T.DisplayCulture)
                                    }
                                </td>
                                <td>
                                    @if (job.IsRunning)
                                    {
                                        <span class="badge bg-success">@T["AdminJobs.Status.Running"]</span>
                                    }
                                    else if (job.IsPaused)
                                    {
                                        <span class="badge bg-warning text-dark">@T["AdminJobs.Status.Paused"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@AdminJobWebText.Status(T, job.Status)</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(job.StatusMessage))
                                    {
                                        <small class="text-muted">@AdminJobWebText.Summary(T, job.StatusMessage)</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                                <td>
                                    <partial name="_JobActions" model="job" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav aria-label="@T["Shell.Pagination"]">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-action="Index"
                               asp-controller="Jobs"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">
                                @T.DisplayNumber(i)
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@* Reuse the server's forms for live states, with antiforgery and the same action rules. *@
<template id="job-running-actions"><partial name="_JobActions" model="@(new JobMonitoringViewModel { IsRunning = true, IsInterruptable = true })" /></template>
<template id="job-running-disabled-actions"><partial name="_JobActions" model="@(new JobMonitoringViewModel { IsRunning = true })" /></template>
<template id="job-paused-actions"><partial name="_JobActions" model="@(new JobMonitoringViewModel { IsPaused = true })" /></template>
<template id="job-idle-actions"><partial name="_JobActions" model="@(new JobMonitoringViewModel())" /></template>

@section Scripts {
    @Html.FrontendViewScripts()
}
