@model Wayfarer.Areas.Admin.Models.TransportProfileCreateViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Catalogs.TransportCreate"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("Create");
}

<h1 class="text-center fs-3">@T["Catalogs.TransportCreate"]</h1>
<form method="post" class="card card-body" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Key" class="form-label">@T["Catalogs.Key"]</label><input asp-for="Key" class="form-control" aria-describedby="key-help" /><div id="key-help" class="form-text">@T["Catalogs.TransportKeyHelp"]</div><span asp-validation-for="Key" class="text-danger"></span></div>
    <partial name="_Fields" model="Model" />
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">@T["Catalogs.Create"]</button><a asp-action="Index" class="btn btn-secondary">@T["Shell.Cancel"]</a></div>
</form>
