@model Wayfarer.Areas.Admin.Models.TransportProfileRowViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Catalogs.TransportDelete"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("Delete", new { id = Model.Id });
}

<h1 class="text-center fs-3">@T["Catalogs.TransportDelete"]</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card card-body">
    <dl class="row"><dt class="col-sm-3">@T["Catalogs.Key"]</dt><dd class="col-sm-9"><code>@Model.Key</code></dd><dt class="col-sm-3">@T["Catalogs.Label"]</dt><dd class="col-sm-9">@Model.Label</dd><dt class="col-sm-3">@T["Catalogs.TransportReferencedSegments"]</dt><dd class="col-sm-9">@T.DisplayNumber(Model.ReferencedSegments)</dd></dl>
    @if (Model.IsSeeded || Model.ReferencedSegments > 0)
    {
        <div class="alert alert-warning">@T["Catalogs.TransportDeleteBlocked"]</div>
        <a asp-action="Index" class="btn btn-secondary align-self-start">@T["Catalogs.Back"]</a>
    }
    else
    {
        <div class="alert alert-danger">@T["Catalogs.TransportDeletePermanent"]</div>
        <form method="post"><input name="rowVersion" value="@Model.RowVersion" type="hidden" /><button type="submit" class="btn btn-danger">@T["Catalogs.ConfirmDelete"]</button> <a asp-action="Index" class="btn btn-secondary">@T["Shell.Cancel"]</a></form>
    }
</div>
