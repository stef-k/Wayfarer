@model Wayfarer.Areas.Admin.Models.TransportProfileIndexViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Catalogs.TransportIndex"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
}

<h1 class="text-center my-1 fs-3">@T["Catalogs.TransportIndex"]</h1>
<div class="alert alert-light small mb-3">
    @T["Catalogs.TransportIntro"]
</div>
<div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-success">@T["Catalogs.TransportCreate"]</a>
    <form method="get" class="d-flex" role="search">
        <label class="visually-hidden" for="transport-profile-search">@T["Catalogs.TransportSearch"]</label>
        <input id="transport-profile-search" name="search" value="@Model.Search" class="form-control me-2" placeholder="@T["Catalogs.TransportSearchHint"]" />
        <button class="btn btn-primary" type="submit">@T["Shell.Search"]</button>
    </form>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>@T["Catalogs.Order"]</th><th>@T["Catalogs.Key"]</th><th>@T["Catalogs.Label"]</th><th>@T["Catalogs.Category"]</th><th>@T["Catalogs.SpeedColumn"]</th><th>@T["Catalogs.Status"]</th><th>@T["Catalogs.Segments"]</th><th>@T["Shell.Actions"]</th></tr></thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted">@T["Catalogs.TransportEmpty"]</td></tr>
        }
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.SortOrder</td><td><code>@item.Key</code></td><td>@item.Label</td><td>@item.Category</td>
                <td>@(item.PlanningSpeedKmh?.ToString("0.###", T.DisplayCulture) ?? T["Catalogs.TransportManualOnly"])</td>
                <td>@(T[item.IsActive ? "Catalogs.TransportActive" : "Catalogs.TransportInactive"])</td><td>@T.DisplayNumber(item.ReferencedSegments)</td>
                <td><div class="btn-group" role="group" aria-label="@T["Catalogs.TransportActions", item.Label]">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">@T["Shell.Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">@T["Shell.Delete"]</a>
                </div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<nav aria-label="@T["Catalogs.TransportPages"]"><ul class="pagination justify-content-center">
@for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
{
    <li class="page-item @(pageNumber == Model.Page ? "active" : null)"><a class="page-link" asp-route-page="@pageNumber" asp-route-search="@Model.Search">@pageNumber</a></li>
}
</ul></nav>
