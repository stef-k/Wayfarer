@model Wayfarer.Areas.Admin.Models.TransportProfileEditViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Catalogs.TransportEdit"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("Edit", new { id = Model.Id });
}

<h1 class="text-center fs-3">@T["Catalogs.TransportEdit"]</h1>
<form method="post" class="card card-body" novalidate>
    <input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><input asp-for="WasActive" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Key" class="form-label">@T["Catalogs.Key"]</label><input asp-for="Key" class="form-control" readonly aria-describedby="immutable-key-help" /><div id="immutable-key-help" class="form-text">@T["Catalogs.TransportKeyImmutable"]</div></div>
    <div class="mb-3"><label asp-for="Label" class="form-label">@T["Catalogs.Label"]</label><input asp-for="Label" class="form-control" /><span asp-validation-for="Label" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Category" class="form-label">@T["Catalogs.Category"]</label><input asp-for="Category" class="form-control" /><span asp-validation-for="Category" class="text-danger"></span></div>
    @* Planning-speed edits affect Wayfarer estimates; accepted provider estimates and Manual values retain their authority. *@
    <div class="mb-3"><label asp-for="PlanningSpeedKmh" class="form-label">@T["Catalogs.PlanningSpeed"]</label><input asp-for="PlanningSpeedKmh" class="form-control" /><div class="form-text">@T["Catalogs.TransportSpeedHelp"]</div><span asp-validation-for="PlanningSpeedKmh" class="text-danger"></span></div>
    @if (Model.ReferencedSegments > 0)
    {
        <div class="alert alert-warning">@T["Catalogs.TransportReferences", T.DisplayNumber(Model.ReferencedSegments), T.DisplayNumber(Model.AutomaticSegments), T.DisplayNumber(Model.ManualSegments)]</div>
        <div class="form-check mb-3"><input asp-for="ConfirmReferencedSpeedChange" class="form-check-input" /><label asp-for="ConfirmReferencedSpeedChange" class="form-check-label">@T["Catalogs.TransportConfirmSpeed"]</label><span asp-validation-for="ConfirmReferencedSpeedChange" class="text-danger d-block"></span></div>
    }
    <div class="mb-3"><label asp-for="SortOrder" class="form-label">@T["Catalogs.Order"]</label><input asp-for="SortOrder" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">@T["Catalogs.TransportAvailable"]</label></div>
    @if (Model.WasActive)
    {
        <div class="alert alert-warning">@T.Count("Catalogs.TransportDeactivate", Model.ReferencedSegments)</div>
        <div class="form-check mb-3"><input asp-for="ConfirmDeactivation" class="form-check-input" /><label asp-for="ConfirmDeactivation" class="form-check-label">@T["Catalogs.TransportConfirmDeactivation"]</label><span asp-validation-for="ConfirmDeactivation" class="text-danger d-block"></span></div>
    }
    <div class="mb-3"><label asp-for="Description" class="form-label">@T["Catalogs.Description"]</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">@T["Catalogs.Save"]</button><a asp-action="Index" class="btn btn-secondary">@T["Shell.Cancel"]</a></div>
</form>
