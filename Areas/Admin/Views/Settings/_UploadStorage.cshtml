@inject Wayfarer.Localization.WebMessages T
@* Known canonical and legacy staging authorities; metrics never inspect DB-supplied paths. *@
<div class="col-12 mb-2">
    <strong>@T["AdminSettings.UploadPath"] </strong><code>@ViewData["UploadsPath"]</code>
    @* Compatibility files remain in place and are included once in totals. *@
    @foreach (var legacyRoot in ViewData["LegacyUploadsPaths"] as string[] ?? [])
    {
        <div>@T["AdminSettings.UploadLegacy"] <code>@legacyRoot</code></div>
    }
</div>

<div class="row mb-2">
    <div class="col-4">
        <strong>@T["AdminSettings.UploadCount"]</strong><br/>
        <code>@((ViewData["UploadsFileCount"] as int?)?.ToString("N0", T.DisplayCulture))</code>
    </div>
    <div class="col-4">
        <strong>@T["AdminSettings.UploadTotalSize"]</strong><br/>
        <code>@((ViewData["UploadsSizeMB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code>
    </div>
    <div class="col-4">
        <strong>@T["AdminSettings.UploadTotalSize"]</strong><br/>
        <code>@((ViewData["UploadsSizeGB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) GB</code>
    </div>
</div>
