@model ApplicationSettings
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Shell.ApplicationSettings"];
    ViewData["WebCatalog"] = "AdminSettings";
    ViewData["LanguageSafeGet"] = Url.Action("Index");
}

<div class="container">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow-sm">
                <div class="card-header text-bg-primary">
                    <h2 class="mb-0 text-center">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <h3 class="text-center fs-4">@T["AdminSettings.LocationHeading"]</h3>
                    <p>@T["AdminSettings.LocationIntro"]</p>

                    <div class="alert alert-warning">
                        <strong><i class="bi bi-battery-half me-1"></i>@T["AdminSettings.BatteryHeading"]</strong>
                        @T["AdminSettings.BatteryIntro"]
                        <ul class="mb-0 mt-2">
                            <li>@T["AdminSettings.BatteryHighMaximum", 2]</li>
                            <li>@T["AdminSettings.BatteryHigh", 3, 2]</li>
                            <li>@T["AdminSettings.BatteryModerate", 5, 4]</li>
                            <li>@T["AdminSettings.BatteryGood", 10, 9]</li>
                            <li>@T["AdminSettings.BatteryBest", 15, 14]</li>
                        </ul>
                    </div>

                    <p>
                        <strong>@T["AdminSettings.StorageEstimateHeading"]</strong><br/>
                        @T["AdminSettings.StorageEstimate", 2, T.DisplayNumber(262800)]<br/>
                        @T["AdminSettings.StorageEstimate", 3, T.DisplayNumber(175200)]<br/>
                        @T["AdminSettings.StorageEstimateRecommended", 5, T.DisplayNumber(105120)]<br/>
                        @T["AdminSettings.StorageEstimate", 10, T.DisplayNumber(52560)]<br/>
                        @T["AdminSettings.StorageEstimate", 15, T.DisplayNumber(35040)]
                    </p>
                    <form asp-action="Update" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="row">

                            <div class="col-md-6">
                                <label for="LocationTimeThresholdMinutes" class="form-label">@T["AdminSettings.TimeThreshold"]</label>
                                <select asp-for="LocationTimeThresholdMinutes" class="form-control" id="timeThresholdSelect">
                                    <optgroup label="@T["AdminSettings.TimeFrequent"]">
                                        <option value="2" class="text-danger fw-bold">@T["AdminSettings.MinutesHigh", 2]</option>
                                        <option value="3">@T["AdminSettings.Minutes", 3]</option>
                                        <option value="4">@T["AdminSettings.Minutes", 4]</option>
                                        <option value="5">@T["AdminSettings.MinutesRecommended", 5]</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.TimeModerate"]">
                                        <option value="10">@T["AdminSettings.Minutes", 10]</option>
                                        <option value="15">@T["AdminSettings.Minutes", 15]</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.TimeHourly"]">
                                        <option value="30">@T["AdminSettings.MinutesTwiceHourly", 30]</option>
                                        <option value="45">@T["AdminSettings.Minutes", 45]</option>
                                        <option value="60">@T["AdminSettings.MinutesHours", 60, T.Count("AdminSettings.Hours", 1)]</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.TimeMultiHour"]">
                                        <option value="120">@T["AdminSettings.MinutesHours", 120, T.Count("AdminSettings.Hours", 2)]</option>
                                        <option value="180">@T["AdminSettings.MinutesHours", 180, T.Count("AdminSettings.Hours", 3)]</option>
                                        <option value="240">@T["AdminSettings.MinutesHours", 240, T.Count("AdminSettings.Hours", 4)]</option>
                                        <option value="300">@T["AdminSettings.MinutesHours", 300, T.Count("AdminSettings.Hours", 5)]</option>
                                        <option value="360">@T["AdminSettings.MinutesFourDaily", 360, T.Count("AdminSettings.Hours", 6)]</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.TimeDaily"]">
                                        <option value="720">@T["AdminSettings.MinutesTwiceDaily", 720, T.Count("AdminSettings.Hours", 12)]</option>
                                        <option value="1440">@T["AdminSettings.MinutesOnceDaily", 1440, T.Count("AdminSettings.Hours", 24)]</option>
                                    </optgroup>
                                </select>
                                <small id="timeThresholdWarning" class="form-text text-danger d-none">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    <strong>@T["AdminSettings.Warning"]</strong> @T["AdminSettings.TimeWarning"]
                                </small>
                                <span asp-validation-for="LocationTimeThresholdMinutes" class="text-danger"></span>
                            </div>


                            <div class="col-md-6">
                                <label for="LocationDistanceThresholdMeters" class="form-label">
                                    @T["AdminSettings.DistanceThreshold"]
                                    <i class="bi bi-question-circle text-muted ms-1"
                                       data-tippy-content="@T["AdminSettings.DistanceHelp"]"></i>
                                </label>
                                <select asp-for="LocationDistanceThresholdMeters" class="form-control">
                                    <optgroup label="@T["AdminSettings.DistanceFine"]">
                                        <option value="5">@(5.ToString(T.DisplayCulture)) m</option>
                                        <option value="10">@(10.ToString(T.DisplayCulture)) m</option>
                                        <option value="15">@T["AdminSettings.DefaultChoice", 15.ToString(T.DisplayCulture) + " m"]</option>
                                        <option value="20">@(20.ToString(T.DisplayCulture)) m</option>
                                        <option value="25">@(25.ToString(T.DisplayCulture)) m</option>
                                        <option value="30">@(30.ToString(T.DisplayCulture)) m</option>
                                        <option value="35">@(35.ToString(T.DisplayCulture)) m</option>
                                        <option value="40">@(40.ToString(T.DisplayCulture)) m</option>
                                        <option value="45">@(45.ToString(T.DisplayCulture)) m</option>
                                        <option value="50">@(50.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.DistanceMedium"]">
                                        <option value="55">@(55.ToString(T.DisplayCulture)) m</option>
                                        <option value="60">@(60.ToString(T.DisplayCulture)) m</option>
                                        <option value="65">@(65.ToString(T.DisplayCulture)) m</option>
                                        <option value="70">@(70.ToString(T.DisplayCulture)) m</option>
                                        <option value="75">@(75.ToString(T.DisplayCulture)) m</option>
                                        <option value="80">@(80.ToString(T.DisplayCulture)) m</option>
                                        <option value="85">@(85.ToString(T.DisplayCulture)) m</option>
                                        <option value="90">@(90.ToString(T.DisplayCulture)) m</option>
                                        <option value="95">@(95.ToString(T.DisplayCulture)) m</option>
                                        <option value="100">@(100.ToString(T.DisplayCulture)) m</option>
                                        <option value="105">@(105.ToString(T.DisplayCulture)) m</option>
                                        <option value="110">@(110.ToString(T.DisplayCulture)) m</option>
                                        <option value="115">@(115.ToString(T.DisplayCulture)) m</option>
                                        <option value="120">@(120.ToString(T.DisplayCulture)) m</option>
                                        <option value="125">@(125.ToString(T.DisplayCulture)) m</option>
                                        <option value="130">@(130.ToString(T.DisplayCulture)) m</option>
                                        <option value="135">@(135.ToString(T.DisplayCulture)) m</option>
                                        <option value="140">@(140.ToString(T.DisplayCulture)) m</option>
                                        <option value="145">@(145.ToString(T.DisplayCulture)) m</option>
                                        <option value="150">@(150.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.DistanceCoarse"]">
                                        <option value="200">@(200.ToString(T.DisplayCulture)) m</option>
                                        <option value="250">@(250.ToString(T.DisplayCulture)) m</option>
                                        <option value="300">@(300.ToString(T.DisplayCulture)) m</option>
                                        <option value="350">@(350.ToString(T.DisplayCulture)) m</option>
                                        <option value="400">@(400.ToString(T.DisplayCulture)) m</option>
                                        <option value="450">@(450.ToString(T.DisplayCulture)) m</option>
                                        <option value="500">@(500.ToString(T.DisplayCulture)) m</option>
                                        <option value="550">@(550.ToString(T.DisplayCulture)) m</option>
                                        <option value="600">@(600.ToString(T.DisplayCulture)) m</option>
                                        <option value="650">@(650.ToString(T.DisplayCulture)) m</option>
                                        <option value="700">@(700.ToString(T.DisplayCulture)) m</option>
                                        <option value="750">@(750.ToString(T.DisplayCulture)) m</option>
                                        <option value="800">@(800.ToString(T.DisplayCulture)) m</option>
                                        <option value="850">@(850.ToString(T.DisplayCulture)) m</option>
                                        <option value="900">@(900.ToString(T.DisplayCulture)) m</option>
                                        <option value="950">@(950.ToString(T.DisplayCulture)) m</option>
                                        <option value="1000">@(1.ToString(T.DisplayCulture)) km</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.DistanceVeryCoarse"]">
                                        <option value="1500">@(1.5.ToString(T.DisplayCulture)) km</option>
                                        <option value="2000">@(2.ToString(T.DisplayCulture)) km</option>
                                        <option value="2500">@(2.5.ToString(T.DisplayCulture)) km</option>
                                        <option value="3000">@(3.ToString(T.DisplayCulture)) km</option>
                                        <option value="3500">@(3.5.ToString(T.DisplayCulture)) km</option>
                                        <option value="4000">@(4.ToString(T.DisplayCulture)) km</option>
                                        <option value="4500">@(4.5.ToString(T.DisplayCulture)) km</option>
                                        <option value="5000">@(5.ToString(T.DisplayCulture)) km</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.DistanceRegional"]">
                                        <option value="10000">@(10.ToString(T.DisplayCulture)) km</option>
                                        <option value="15000">@(15.ToString(T.DisplayCulture)) km</option>
                                        <option value="20000">@(20.ToString(T.DisplayCulture)) km</option>
                                        <option value="25000">@(25.ToString(T.DisplayCulture)) km</option>
                                        <option value="30000">@(30.ToString(T.DisplayCulture)) km</option>
                                        <option value="35000">@(35.ToString(T.DisplayCulture)) km</option>
                                        <option value="40000">@(40.ToString(T.DisplayCulture)) km</option>
                                        <option value="45000">@(45.ToString(T.DisplayCulture)) km</option>
                                        <option value="50000">@(50.ToString(T.DisplayCulture)) km</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.DistanceMaximum"]">
                                        <option value="100000">@(100.ToString(T.DisplayCulture)) km</option>
                                    </optgroup>
                                </select>
                                <span asp-validation-for="LocationDistanceThresholdMeters" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label for="LocationAccuracyThresholdMeters" class="form-label">
                                    <i class="bi bi-bullseye me-1"></i>@T["AdminSettings.AccuracyThreshold"]
                                </label>
                                <select asp-for="LocationAccuracyThresholdMeters" class="form-control">
                                    <optgroup label="@T["AdminSettings.AccuracyHigh"]">
                                        <option value="10">@(10.ToString(T.DisplayCulture)) m</option>
                                        <option value="15">@(15.ToString(T.DisplayCulture)) m</option>
                                        <option value="20">@(20.ToString(T.DisplayCulture)) m</option>
                                        <option value="25">@(25.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.AccuracyGood"]">
                                        <option value="30">@(30.ToString(T.DisplayCulture)) m</option>
                                        <option value="35">@(35.ToString(T.DisplayCulture)) m</option>
                                        <option value="40">@(40.ToString(T.DisplayCulture)) m</option>
                                        <option value="45">@(45.ToString(T.DisplayCulture)) m</option>
                                        <option value="50">@T["AdminSettings.DefaultChoice", 50.ToString(T.DisplayCulture) + " m"]</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.AccuracyModerate"]">
                                        <option value="55">@(55.ToString(T.DisplayCulture)) m</option>
                                        <option value="60">@(60.ToString(T.DisplayCulture)) m</option>
                                        <option value="65">@(65.ToString(T.DisplayCulture)) m</option>
                                        <option value="70">@(70.ToString(T.DisplayCulture)) m</option>
                                        <option value="75">@(75.ToString(T.DisplayCulture)) m</option>
                                        <option value="80">@(80.ToString(T.DisplayCulture)) m</option>
                                        <option value="85">@(85.ToString(T.DisplayCulture)) m</option>
                                        <option value="90">@(90.ToString(T.DisplayCulture)) m</option>
                                        <option value="95">@(95.ToString(T.DisplayCulture)) m</option>
                                        <option value="100">@(100.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.AccuracyRelaxed"]">
                                        <option value="105">@(105.ToString(T.DisplayCulture)) m</option>
                                        <option value="110">@(110.ToString(T.DisplayCulture)) m</option>
                                        <option value="120">@(120.ToString(T.DisplayCulture)) m</option>
                                        <option value="130">@(130.ToString(T.DisplayCulture)) m</option>
                                        <option value="140">@(140.ToString(T.DisplayCulture)) m</option>
                                        <option value="150">@(150.ToString(T.DisplayCulture)) m</option>
                                        <option value="160">@(160.ToString(T.DisplayCulture)) m</option>
                                        <option value="170">@(170.ToString(T.DisplayCulture)) m</option>
                                        <option value="180">@(180.ToString(T.DisplayCulture)) m</option>
                                        <option value="190">@(190.ToString(T.DisplayCulture)) m</option>
                                        <option value="200">@(200.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.AccuracyVeryRelaxed"]">
                                        <option value="250">@(250.ToString(T.DisplayCulture)) m</option>
                                        <option value="300">@(300.ToString(T.DisplayCulture)) m</option>
                                        <option value="400">@(400.ToString(T.DisplayCulture)) m</option>
                                        <option value="500">@(500.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                    <optgroup label="@T["AdminSettings.AccuracyMaximum"]">
                                        <option value="1000">@(1000.ToString(T.DisplayCulture)) m</option>
                                    </optgroup>
                                </select>
                                <small class="form-text text-muted">
                                    @T["AdminSettings.AccuracyHelp"]
                                </small>
                                <span asp-validation-for="LocationAccuracyThresholdMeters" class="text-danger"></span>
                            </div>
                        </div>
                        <hr/>
                        <partial name="_VisitDetection" model="Model" />
                        <hr/>
                        <div class="row">
                            <h3 class="text-center fs-4">@T["AdminSettings.RegistrationHeading"]</h3>
                            <div class="col-md-12 mb-2">
                                <div class="form-group">
                                    <label for="IsRegistrationOpen" class="form-label">@T["AdminSettings.RegistrationLabel"]</label>

                                    <!-- Use Bootstrap's built-in large checkbox class -->
                                    <div class="form-check form-switch">
                                        <input type="checkbox" class="form-check-input form-check-input-lg"
                                               id="IsRegistrationOpen" name="IsRegistrationOpen"
                                               value="true" @(Model.IsRegistrationOpen ? "checked" : "")/>
                                        @* Hidden fallback ensures "false" is posted when checkbox is unchecked *@
                                        <input type="hidden" name="IsRegistrationOpen" value="false"/>
                                        <label class="form-check-label" for="IsRegistrationOpen">@T["AdminSettings.RegistrationEnable"]</label>
                                    </div>

                                    <small class="form-text text-muted">@T["AdminSettings.RegistrationHelp"]</small>
                                </div>
                            </div>
                        </div>
                        <hr/>
                        <div class="row">
                            <h3 class="text-center fs-4">@T["AdminSettings.UploadHeading"]</h3>
                            <div class="col-md-8">
                                <partial name="_UploadStorage" />

                                <label for="UploadSizeLimitMB" class="form-label">
                                    @T["AdminSettings.UploadLimit", Model.UploadSizeLimitMB]
                                </label>

                                <div class="input-group">
                                    <input asp-for="UploadSizeLimitMB"
                                           class="form-control"
                                           type="number"
                                           step="1"
                                           min="-1"
                                           max="@ApplicationSettings.DefaultUploadSizeLimitMB"/>
                                    <span class="input-group-text">MiB</span>
                                </div>

                                <span asp-validation-for="UploadSizeLimitMB" class="text-danger"></span>
                            </div>

                            <div class="form-text">
                                • @T["AdminSettings.UploadScope"]<br/>
                                • @T["AdminSettings.UploadValues", "-1", "0", "1..100"]<br/>
                                • @T["AdminSettings.UploadMaximum", ApplicationSettings.DefaultUploadSizeLimitMB]<br/>
                            </div>
                        </div>
                        <hr/>

                        <partial name="_TileProvider" model="Model" />
                        <hr/>
                        <partial name="_CacheSettings" model="Model" />
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg mt-3">@T["Shell.Save"]</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Html.FrontendViewScripts()
}
