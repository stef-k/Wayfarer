@model ApplicationSettings
@inject Wayfarer.Localization.WebMessages T

@if (Model.TileOutboundBudgetPerIpPerMinute == 30 &&
     !Model.TileOutboundBudgetHistorical30Acknowledged)
{
    <div class="col-12">
        <div class="alert alert-warning">
            <strong>@T["AdminSettings.HistoricBudget"]</strong> @T["AdminSettings.HistoricBudgetHelp"]
            <div class="mt-2">
                <button type="submit" class="btn btn-sm btn-primary"
                        formaction="@Url.Action("UseRecommendedTileOutboundBudget")">@T["AdminSettings.HistoricBudgetApply"]</button>
                <button type="submit" class="btn btn-sm btn-outline-secondary"
                        formaction="@Url.Action("AcknowledgeHistoricalTileOutboundBudget")">@T["AdminSettings.HistoricBudgetKeep"]</button>
            </div>
        </div>
    </div>
}
