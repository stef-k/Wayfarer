@model ApplicationSettings
@inject Wayfarer.Localization.WebMessages T
@{
    // The estimate is display-only. Input values keep their invariant form syntax.
    var tileMetadataHotCacheEntries = Wayfarer.Services.TileMetadataHotCache.GetApproximateEntryLimit(Model.TileMetadataHotCacheSizeMB);
}

<div class="row">
    <h3 class="text-center fs-4">@T["AdminSettings.TileRateHeading"]</h3>
    <p class="text-muted">
        @T["AdminSettings.TileRateIntro"]
    </p>

    <div class="col-md-3 mb-3">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input"
                   id="TileRateLimitEnabled" name="TileRateLimitEnabled"
                   value="true" @(Model.TileRateLimitEnabled ? "checked" : "")/>
            <input type="hidden" name="TileRateLimitEnabled" value="false"/>
            <label class="form-check-label" for="TileRateLimitEnabled">
                @T["AdminSettings.TileRateEnable"]
                <i class="bi bi-question-circle text-muted ms-1"
                   data-tippy-content="@T["AdminSettings.TileRateTooltip"]"></i>
            </label>
        </div>
        <small class="form-text text-muted">
            @T["AdminSettings.TileRateHelp"]
        </small>
    </div>

    <div class="col-md-3 mb-3">
        <label asp-for="TileRateLimitPerMinute" class="form-label">@T["AdminSettings.AnonymousPerIp"]</label>
        <div class="input-group">
            <input asp-for="TileRateLimitPerMinute" class="form-control" type="number" min="50" max="10000" />
            <span class="input-group-text">@T["AdminSettings.RequestsPerMinute"]</span>
        </div>
        <small class="form-text text-muted">
            @T["AdminSettings.TileRateDefault", T.DisplayNumber(ApplicationSettings.DefaultTileRateLimitPerMinute)]
        </small>
        <span asp-validation-for="TileRateLimitPerMinute" class="text-danger"></span>
    </div>

    <div class="col-md-3 mb-3">
        <label asp-for="TileRateLimitAuthenticatedPerMinute" class="form-label">@T["AdminSettings.AuthenticatedPerUser"]</label>
        <div class="input-group">
            <input asp-for="TileRateLimitAuthenticatedPerMinute" class="form-control" type="number" min="100" max="50000" />
            <span class="input-group-text">@T["AdminSettings.RequestsPerMinute"]</span>
        </div>
        <small class="form-text text-muted">
            @T["AdminSettings.TileAuthRateDefault", T.DisplayNumber(ApplicationSettings.DefaultTileRateLimitAuthenticatedPerMinute)]
        </small>
        <span asp-validation-for="TileRateLimitAuthenticatedPerMinute" class="text-danger"></span>
    </div>

</div>
<div class="row">
    <div class="col-md-3 mb-3">
        <div class="alert alert-info mb-0">
            <strong><i class="bi bi-shield-check me-1"></i>@T["AdminSettings.TileWhoAffected"]</strong>
            <ul class="mb-0 mt-1">
                <li><strong>@T["AdminSettings.TileRateSignedIn"]</strong> @T["AdminSettings.TileRateByUser"]</li>
                <li><strong>@T["AdminSettings.TileRateAnonymous"]</strong> @T["AdminSettings.TileRateByIp"]</li>
            </ul>
            <small class="text-muted">@T["AdminSettings.TileRateCounting"]</small>
        </div>
    </div>
</div>

<hr/>
<div class="row">
    <h3 class="text-center fs-4">@T["AdminSettings.TileCacheHeading"]</h3>
    <div class="col-12 mb-2">
        @* Distinguish current writes from retained, read-compatible native storage. *@
        <strong>@T["AdminSettings.TileCacheCurrent"] </strong><code>@ViewData["CachePath"]</code>
        @if (ViewData["LegacyCachePath"] is string legacyTileRoot)
        {
            <br /><strong>@T["AdminSettings.TileCacheLegacy"] </strong><code>@legacyTileRoot</code>
        }
    </div>
    <hr/>
    <div class="col-5 mb-2">
        <strong>@T["AdminSettings.TileCacheFiles"] </strong><code
            id="TotalCacheFiles">@((ViewData["TotalCacheFiles"] as int?)?.ToString("N0", T.DisplayCulture))</code>
    </div>
    <div class="col-7 mb-2">
        <strong>@T["AdminSettings.TileCacheLruFiles"] </strong><code
            id="LruTotalFiles">@((ViewData["LruTotalFiles"] as int?)?.ToString("N0", T.DisplayCulture))</code>
    </div>
    <hr/>
    <div class="col-5 mb-2">
        <strong>@T["AdminSettings.TileCacheTotalMb"] </strong><code
            id="TotalCacheSize">@((ViewData["TotalCacheSize"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code>
    </div>
    <div class="col-7 mb-2">
        <strong>@T["AdminSettings.TileCacheLruMb"] </strong><code
            id="TotalLru">@((ViewData["TotalLru"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code>
    </div>

    <hr/>
    <div class="col-5 mb-2">
        <strong>@T["AdminSettings.TileCacheTotalGb"] </strong><code
            id="TotalCacheSizeGB">@((ViewData["TotalCacheSizeGB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) GB</code>
    </div>

    <div class="col-7 mb-2">
        <strong>@T["AdminSettings.TileCacheLruGb"] </strong><code
            id="TotalLruGB">@((ViewData["TotalLruGB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) GB</code>
    </div>
    <hr/>
    <div class="col-md-8">
        <label for="MaxCacheTileSizeInMB" class="form-label">
            @T["AdminSettings.TileCacheMaximum"]
        </label>

        <div class="input-group">
            <input asp-for="MaxCacheTileSizeInMB"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="-1"/>
            <span class="input-group-text">MB</span>
        </div>

        <span asp-validation-for="MaxCacheTileSizeInMB" class="text-danger"></span>

        <div class="form-text">
            • @T["AdminSettings.TileCacheMaximumIntro"]<br/>
            • @T["AdminSettings.TileCacheDisable", "-1"]<br/>
            • @T["AdminSettings.TileCacheDefault", "0", ApplicationSettings.DefaultMaxCacheTileSizeInMB.ToString("#,0.##", T.DisplayCulture)]<br/>
            • <strong>@T["AdminSettings.TileCacheMinimum"]</strong> @T["AdminSettings.TileCacheOsmHelp"]<br/>
            • @T["AdminSettings.TileCacheTypical"]<br/>
            • @T["AdminSettings.TileCachePermanent"]<br/>
            • @T["AdminSettings.TileCacheEviction"]<br/>
        </div>
    </div>

    <div class="col-md-8 mt-3">
        <label asp-for="TileMetadataHotCacheSizeMB" class="form-label">
            @T["AdminSettings.HotCacheBudget"]
        </label>

        <div class="input-group">
            <input asp-for="TileMetadataHotCacheSizeMB"
                   class="form-control"
                   type="number"
                   min="-1"
                   max="512"
                   data-entry-bytes="@Wayfarer.Services.TileMetadataHotCache.EstimatedBytesPerHotMetadataEntry" />
            <span class="input-group-text">MB</span>
        </div>

        <span asp-validation-for="TileMetadataHotCacheSizeMB" class="text-danger"></span>

        <div class="form-text">
            • @T["AdminSettings.HotCacheIntro"]<br/>
            • @T["AdminSettings.HotCacheOnlyMetadata"]<br/>
            • @T["AdminSettings.HotCacheDisable", "-1"]<br/>
            • @T["AdminSettings.HotCacheValues", "-1", "16–512"]<br/>
            • @T["AdminSettings.HotCacheEstimate"]<br/>
        </div>

        <div class="alert alert-secondary mt-2 mb-0 py-2" id="tileMetadataHotCacheHint">
            @if (Model.TileMetadataHotCacheSizeMB == -1)
            {
                <span>@T["AdminSettings.HotCacheDisabled"]</span>
            }
            else
            {
                <span>@T["AdminSettings.HotCacheEntries", Model.TileMetadataHotCacheSizeMB, T.DisplayNumber(tileMetadataHotCacheEntries.GetValueOrDefault())]</span>
            }
        </div>
    </div>


    <div class="col-md-4">
        <div class="row mt-3">
            <div class="col">
                <a href="#" class="btn btn-danger" id="clearLruCache"
                   title="@T["AdminSettings.PurgeLruTooltip"]">@T["AdminSettings.PurgeLru"]</a>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col"><a href="#" class="btn btn-danger" id="clearAllCache"
                                title="@T["AdminSettings.PurgeAllTooltip"]">@T["AdminSettings.PurgeAll"]</a></div>
        </div>
    </div>

    @* ── Purge progress bar (hidden until a purge starts) ── *@
    <div class="col-12">
        <div id="cachePurgeProgress" class="mt-3" style="display:none;">
            <div class="progress">
                <div id="cachePurgeBar"
                     class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar" aria-label="@T["AdminSettings.PurgeProgressLabel"]"
                     aria-valuenow="0" aria-valuemin="0"
                     aria-valuemax="100" style="width: 0%">0%</div>
            </div>
            <small id="cachePurgeText" class="text-muted">@T["AdminSettings.PurgeStarting"]</small>
        </div>
    </div>

</div>

<hr/>

@* ── @T["AdminSettings.ImageCacheHeading"] Settings ── *@
<div class="row">
    <h3 class="text-center fs-2">@T["AdminSettings.ImageCacheHeading"]</h3>

    <div class="col-6 mb-2">
        <strong>@T["AdminSettings.ImageCacheCount"]</strong>
        <code id="ImageCacheCount">@((ViewData["ImageCacheCount"] as int?)?.ToString("N0", T.DisplayCulture))</code>
    </div>
    <div class="col-6 mb-2">
        <strong>@T["AdminSettings.ImageCacheSize"]</strong>
        <code id="ImageCacheSizeMB">@((ViewData["ImageCacheSizeMB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code>
    </div>

    <hr/>

    <div class="col-md-6">
        <label asp-for="MaxCacheImageSizeInMB" class="form-label">
            @T["AdminSettings.ImageCacheMaximum"]
        </label>

        <div class="input-group">
            <input asp-for="MaxCacheImageSizeInMB"
                   class="form-control"
                   type="number"
                   step="1"
                   min="-1"/>
            <span class="input-group-text">MB</span>
        </div>

        <span asp-validation-for="MaxCacheImageSizeInMB" class="text-danger"></span>

        <div class="form-text">
            • @T["AdminSettings.ImageCacheMaximumHelp"]<br/>
            • @T["AdminSettings.ImageCacheDisable", "-1"]<br/>
            • @T["AdminSettings.DefaultMb", ApplicationSettings.DefaultMaxCacheImageSizeInMB.ToString("#,0.##", T.DisplayCulture)]<br/>
            • @T["AdminSettings.ImageCacheTypical"]<br/>
            • @T["AdminSettings.ImageCacheEviction"]<br/>
        </div>
    </div>

    <div class="col-md-6">
        <label asp-for="ImageCacheExpiryDays" class="form-label">
            @T["AdminSettings.ImageCacheExpiry"]
        </label>

        <div class="input-group">
            <input asp-for="ImageCacheExpiryDays"
                   class="form-control"
                   type="number"
                   step="1"
                   min="1"
                   max="365"/>
            <span class="input-group-text">@T["AdminSettings.DayUnit"]</span>
        </div>

        <span asp-validation-for="ImageCacheExpiryDays" class="text-danger"></span>

        <div class="form-text">
            • @T["AdminSettings.ImageCacheExpiryHelp"]<br/>
            • @T["AdminSettings.ImageCacheExpiryRecommended"]<br/>
            • @T["AdminSettings.DefaultDays", T.Count("AdminSettings.Days", ApplicationSettings.DefaultImageCacheExpiryDays)]<br/>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12 col-md-6">
        <label asp-for="MaxProxyImageDownloadMB" class="form-label fw-semibold">
            @T["AdminSettings.ImageDownloadMaximum"]
        </label>
        <div class="input-group">
            <input asp-for="MaxProxyImageDownloadMB" class="form-control"
                   type="number"
                   min="5"
                   max="200"/>
            <span class="input-group-text">MB</span>
        </div>

        <span asp-validation-for="MaxProxyImageDownloadMB" class="text-danger"></span>

        <div class="form-text">
            • @T["AdminSettings.ImageDownloadMaximumHelp"]<br/>
            • @T["AdminSettings.ImageDownloadOptimized"]<br/>
            • @T["AdminSettings.DefaultMb", ApplicationSettings.DefaultMaxProxyImageDownloadMB.ToString("#,0.##", T.DisplayCulture)]<br/>
        </div>
    </div>
</div>

<div class="row mb-3">
    <h3 class="text-center fs-4">@T["AdminSettings.ImageRateHeading"]</h3>
    <p class="text-muted">
        @T["AdminSettings.ImageRateIntro"]
    </p>

    <div class="col-md-6 mb-3">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input"
                   id="ProxyImageRateLimitEnabled" name="ProxyImageRateLimitEnabled"
                   value="true" @(Model.ProxyImageRateLimitEnabled ? "checked" : "")/>
            @* Hidden fallback ensures "false" is posted when checkbox is unchecked *@
            <input type="hidden" name="ProxyImageRateLimitEnabled" value="false"/>
            <label class="form-check-label" for="ProxyImageRateLimitEnabled">
                @T["AdminSettings.ImageRateEnable"]
                <i class="bi bi-question-circle text-muted ms-1"
                   data-tippy-content="@T["AdminSettings.ImageRateTooltip"]"></i>
            </label>
        </div>
        <small class="form-text text-muted">
            @T["AdminSettings.ImageRateHelp"]
        </small>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="ProxyImageRateLimitPerMinute" class="form-label">@T["AdminSettings.AnonymousPerIp"]</label>
        <div class="input-group">
            <input asp-for="ProxyImageRateLimitPerMinute" class="form-control" type="number" min="10" max="5000" />
            <span class="input-group-text">@T["AdminSettings.RequestsPerMinute"]</span>
        </div>
        <small class="form-text text-muted">
            @T["AdminSettings.ImageRateDefault", T.DisplayNumber(ApplicationSettings.DefaultProxyImageRateLimitPerMinute)]
        </small>
        <span asp-validation-for="ProxyImageRateLimitPerMinute" class="text-danger"></span>
    </div>
</div>

<hr/>

<div class="row">
    <h3 class="text-center fs-2">@T["AdminSettings.StorageHeading"]</h3>

    <div class="col-4 mb-2 fs-5">
        <strong>@T["AdminSettings.StorageTiles"]</strong><br/>
        <code>@((ViewData["TotalCacheSize"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code> /
        <code>@((ViewData["TotalCacheSizeGB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) GB</code>
    </div>

    <div class="col-4 mb-2 fs-5">
        <strong>@T["AdminSettings.ImageCacheHeading"]:</strong><br/>
        <code>@((ViewData["ImageCacheSizeMB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code>
    </div>

    <div class="col-4 mb-2 fs-5">
        <strong>@T["AdminSettings.StorageUploads"]</strong><br/>
        <code>@((ViewData["UploadsSizeMB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code> / <code>@((ViewData["UploadsSizeGB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) GB</code>
    </div>
</div>

<!-- Separate row for combined total -->
<div class="row mt-3">
    <div class="col-6 fs-5">
        <strong>@T["AdminSettings.StorageTotalMb"]</strong>
        <code class="text-primary">@((ViewData["CombinedStorageMB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) MB</code>
    </div>
    <div class="col-6 fs-5">
        <strong>@T["AdminSettings.StorageTotalGb"]</strong>
        <code class="text-primary">@((ViewData["CombinedStorageGB"] as double?)?.ToString("#,0.###", T.DisplayCulture)) GB</code>
    </div>
</div>

<div class="form-text fs-6 mt-2">
    • @T["AdminSettings.StorageIncludes"]<br/>
    • @T["AdminSettings.StoragePermanent"]<br/>
    • @T["AdminSettings.StorageSummary"]
</div>
