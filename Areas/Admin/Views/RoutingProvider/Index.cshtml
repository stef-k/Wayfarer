@model Wayfarer.Areas.Admin.Models.RoutingProviderIndexViewModel
@{ ViewData["Title"] = "External Routing"; }

<h1 class="text-center my-1 fs-3">External route generation</h1>
<div class="alert alert-light small">
    The feature is server-authoritative and defaults to disabled. Exactly one verified OSRM-compatible configuration may be selected globally.
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Create" class="btn btn-success">Create OSRM configuration</a>
    <form asp-action="SetFeature" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="settingsRowVersion" value="@Model.SettingsRowVersion" />
        <input type="hidden" name="enabled" value="@(!Model.ExternalRouteGenerationEnabled ? "true" : "false")" />
        <button type="submit" class="btn @(Model.ExternalRouteGenerationEnabled ? "btn-warning" : "btn-primary")">
            @(Model.ExternalRouteGenerationEnabled ? "Disable generation" : "Enable generation")
        </button>
    </form>
</div>
<p><strong>Global state:</strong> @(Model.ExternalRouteGenerationEnabled ? "Enabled" : "Disabled")</p>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Name</th><th>Adapter</th><th>State</th><th>Credential</th><th>Version</th><th>Actions</th></tr></thead>
        <tbody>
        @if (Model.Providers.Count == 0) { <tr><td colspan="6" class="text-muted">No routing providers configured.</td></tr> }
        @foreach (var provider in Model.Providers)
        {
            <tr>
                <td>@provider.DisplayName</td><td>OSRM-compatible</td><td>@provider.State</td>
                <td>@(provider.CredentialPresent ? "Stored (masked)" : "None")</td>
                <td>@provider.ConfigurationVersion / verified @(provider.VerifiedConfigurationVersion?.ToString() ?? "none")</td>
                <td><div class="d-flex flex-wrap gap-1">
                    <a asp-action="Edit" asp-route-id="@provider.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="Verify" asp-route-id="@provider.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="configurationVersion" value="@provider.ConfigurationVersion" />
                        <input type="hidden" name="rowVersion" value="@provider.RowVersion" />
                        <button class="btn btn-sm btn-secondary" type="submit">Verify</button>
                    </form>
                    <form asp-action="Activate" asp-route-id="@provider.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="configurationVersion" value="@provider.ConfigurationVersion" />
                        <input type="hidden" name="providerRowVersion" value="@provider.RowVersion" />
                        <input type="hidden" name="settingsRowVersion" value="@Model.SettingsRowVersion" />
                        <button class="btn btn-sm btn-success" type="submit" disabled="@(provider.State is not (Wayfarer.Services.ExternalRouting.RoutingProviderState.Verified or Wayfarer.Services.ExternalRouting.RoutingProviderState.Active) ? "disabled" : null)">Activate</button>
                    </form>
                </div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
