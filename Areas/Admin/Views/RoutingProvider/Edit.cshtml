@model Wayfarer.Areas.Admin.Models.RoutingProviderEditViewModel
@{ ViewData["Title"] = "Edit routing provider"; }
<h1 class="fs-3">Edit OSRM-compatible configuration</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<partial name="_Form" model="Model" /></form>
@if (Model.CredentialPresent)
{
    <hr /><h2 class="fs-5">Clear stored credential</h2>
    <form asp-action="ClearCredential" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="form-check"><input id="confirm-clear" name="confirmed" value="true" type="checkbox" class="form-check-input" required /><label for="confirm-clear" class="form-check-label">Confirm permanent credential clearing</label></div>
        <div class="form-check"><input id="disable-routing" name="disableRouting" value="true" type="checkbox" class="form-check-input" /><label for="disable-routing" class="form-check-label">Atomically disable external routing if required</label></div>
        <button class="btn btn-danger mt-2" type="submit">Clear credential</button>
    </form>
}
