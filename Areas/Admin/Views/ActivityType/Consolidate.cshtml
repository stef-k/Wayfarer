@model Wayfarer.Models.ViewModels.ActivityConsolidationViewModel
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Catalogs.ActivityConsolidateTitle"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("Consolidate", new { sourceId = Model.Source.Id, destinationId = Model.Destination?.Id });
}

@* Only catalog names and aggregate counts are rendered; versions bind the two confirmed catalog rows. *@
<h1 class="text-center fs-3">@T["Catalogs.ActivityConsolidateTitle"]</h1>
<div class="card shadow-sm">
    <div class="card-body">
        <p>@T.Count("Catalogs.ActivitySource", Model.Source.LocationCount, Model.Source.Name)</p>
        @if (Model.Destination is null)
        {
            <form method="get" asp-action="Consolidate" asp-area="Admin" asp-controller="ActivityType">
                <input type="hidden" name="sourceId" value="@Model.Source.Id" />
                <label for="destinationId" class="form-label">@T["Catalogs.ActivityExistingDestination"]</label>
                <select id="destinationId" name="destinationId" asp-items="Model.Destinations" class="form-select" data-val="true"
                        data-val-required="@T["Catalogs.ActivityChooseDestination"]" required>
                    <option value="">@T["Catalogs.ActivityChooseDestination"]</option>
                </select>
                <span class="text-danger d-block mb-3" data-valmsg-for="destinationId" data-valmsg-replace="true"></span>
                <button type="submit" class="btn btn-primary">@T["Catalogs.ActivityPreview"]</button>
            </form>
        }
        @if (Model.Destination is { } destination)
        {
            <hr />
            <p>@T.Count("Catalogs.ActivityDestination", destination.LocationCount, destination.Name)</p>
            <div class="alert alert-warning">
                @T["Catalogs.ActivityMove", Model.Source.Name, destination.Name]
                @T["Catalogs.ActivityConsolidateHelp"]
            </div>
            <form method="post" asp-action="Consolidate" asp-area="Admin" asp-controller="ActivityType">
                <input type="hidden" name="sourceId" value="@Model.Source.Id" />
                <input type="hidden" name="destinationId" value="@destination.Id" />
                <input type="hidden" name="sourceVersion" value="@Model.Source.Version" />
                <input type="hidden" name="destinationVersion" value="@destination.Version" />
                <button type="submit" class="btn btn-danger">@T["Catalogs.ActivityConfirmConsolidation"]</button>
            </form>
            <a asp-action="Consolidate" asp-route-sourceId="@Model.Source.Id" class="btn btn-link mt-2">@T["Catalogs.ActivityAnotherDestination"]</a>
        }
        <a asp-action="Index" class="btn btn-secondary mt-3">@T["Shell.Cancel"]</a>
    </div>
</div>
