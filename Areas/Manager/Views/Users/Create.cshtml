@model Wayfarer.Models.ViewModels.CreateUserViewModel
@using Wayfarer.Localization
@inject Wayfarer.Localization.WebMessages T
@{
    ViewData["Title"] = T["Accounts.Create"];
    ViewData["WebContentLanguage"] = T.Locale.Tag;
    ViewData["LanguageSafeGet"] = Url.Action("Create");
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<!-- Validation Errors -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(true, T["Accounts.ValidationSummary"])
    </div>
}

<!-- Card Layout for Form -->
<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" asp-action="Create" asp-area="Manager" asp-controller="Users">
            @Html.AntiForgeryToken()

            <!-- Username Field -->
            <div class="mb-3">
                <label for="UserName" class="form-label">@T["Accounts.Username"]</label>
                <input type="text" class="form-control" asp-for="UserName" required />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <!-- Password Field -->
            <div class="mb-3">
                <label for="Password" class="form-label">@T["Accounts.Password"]</label>
                <input type="password" class="form-control" asp-for="Password" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Display Name Field -->
            <div class="mb-3">
                <label for="DisplayName" class="form-label">@T["Accounts.DisplayName"]</label>
                <input type="text" class="form-control" asp-for="DisplayName" required />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <!-- Role Selection -->
            <div class="mb-3">
                <label for="Role" class="form-label">@T["Accounts.Role"]</label>
                <select id="Role" asp-for="Role" class="form-control" asp-items="AccountWebText.RoleOptions(T, Model.Roles)">
                    <option value="">@T["Accounts.SelectRole"]</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <!-- Is Active Checkbox -->
            <div class="form-check form-switch mb-3">
                <label class="form-check-label" for="IsActive">@T["Accounts.ActiveToggle"]</label>
                <input type="checkbox" class="form-check-input" id="IsActive" asp-for="IsActive" role="switch" />
            </div>

            <!-- Is Protected Checkbox -->
            <div class="form-check form-switch mb-3">
                <label class="form-check-label" for="IsProtected">@T["Accounts.ProtectedAccount"]</label>
                <input type="checkbox" class="form-check-input" id="IsProtected" asp-for="IsProtected" role="switch" />
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary">@T["Accounts.CreateSubmit"]</button>
        </form>
    </div>
</div>

