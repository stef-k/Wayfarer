@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResetPasswordConfirmationModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.Password.ResetConfirmation"];
}

<h1>@ViewData["Title"]</h1>
<p>
    @T["Identity.Password.ResetCompleted"] <a asp-page="./Login">@T["Identity.Login.Title"]</a>
</p>
