@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginWithRecoveryCodeModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.TwoFactor.RecoveryTitle"];
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    @T["Identity.TwoFactor.RecoveryInstructions"]
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="@T["Identity.Field.RecoveryCode"]" />
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@T["Identity.Login.Title"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
