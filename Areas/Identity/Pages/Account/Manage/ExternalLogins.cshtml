@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.ExternalLoginsModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.External.Manage"];
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="/Areas/Identity/Pages/Account/_StatusMessage.cshtml" for="StatusMessage" />
@if (Model.CurrentLogins?.Count > 0)
{
    <h3>@T["Identity.External.Registered"]</h3>
    <table class="table">
        <tbody>
            @foreach (var login in Model.CurrentLogins)
            {
                <tr>
                    <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                    <td>
                        @if (Model.ShowRemoveButton)
                        {
                            <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                <div>
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="btn btn-primary" title="@T["Identity.External.RemoveProvider", login.ProviderDisplayName]">@T["Identity.External.Remove"]</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            @: &nbsp;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.OtherLogins?.Count > 0)
{
    <h4>@T["Identity.External.Add"]</h4>
    <hr />
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="form-horizontal">
        <div id="socialLoginList">
            <p>
                @foreach (var provider in Model.OtherLogins)
                {
                    <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="@T["Identity.External.UseProvider", provider.DisplayName]">@provider.DisplayName</button>
                }
            </p>
        </div>
    </form>
}
