@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.Disable2faModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.TwoFactor.DisableTitle"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="/Areas/Identity/Pages/Account/_StatusMessage.cshtml" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@T["Identity.TwoFactor.DisableWarning"]</strong>
    </p>
    <p>
        @T["Identity.TwoFactor.DisableKeys"] <a asp-page="./ResetAuthenticator">@T["Identity.Authenticator.ResetKey"]</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">@T["Identity.TwoFactor.Disable"]</button>
    </form>
</div>
