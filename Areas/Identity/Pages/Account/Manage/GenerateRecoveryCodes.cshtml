@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.GenerateRecoveryCodesModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.Recovery.GenerateTitle"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="/Areas/Identity/Pages/Account/_StatusMessage.cshtml" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@T["Identity.Recovery.KeepSafe"]</strong>
    </p>
    <p>
        @T["Identity.Recovery.AccessWarning"]
    </p>
    <p>
        @T["Identity.Recovery.KeepKeys"] <a asp-page="./ResetAuthenticator">@T["Identity.Authenticator.ResetKey"]</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">@T["Identity.Recovery.Generate"]</button>
    </form>
</div>
