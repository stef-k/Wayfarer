@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.PersonalDataModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.Data.Title"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@T["Identity.Data.Description"]</p>
        <p>
            <strong>@T["Identity.Data.DeleteWarning"]</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">@T["Identity.Data.Download"]</button>
        </form>
        <p>
            <a id="delete" role="button" asp-page="DeletePersonalData" class="btn btn-danger">@T["Identity.Data.Delete"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
