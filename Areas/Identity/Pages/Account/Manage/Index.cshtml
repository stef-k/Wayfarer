@page
@model IndexModel
@{
    ViewData["Title"] = T["Identity.Manage.Profile"];
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["WebCatalog"] = "ProfilePhoto";
    var role = ViewData["UserRole"] as string;
    var roleLabel = role switch
    {
        "Admin" => T["Shell.AdminRole"],
        "Manager" => T["Shell.ManagerRole"],
        "User" => T["Identity.Manage.User"],
        _ => role
    };
}

<h3>@ViewData["Title"]</h3>
<h5>@T["Identity.Manage.Role"]: <kbd>@roleLabel</kbd></h5>
<partial name="/Areas/Identity/Pages/Account/_StatusMessage.cshtml" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="@T["Identity.Field.Username"]" disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" aria-required="true" aria-describedby="profile-display-name-help" placeholder="@T["Identity.Field.DisplayName"]" />
                <label asp-for="Input.DisplayName" class="form-label">@T["Identity.Field.DisplayName"]</label>
                <div id="profile-display-name-help" class="form-text">@T["Identity.Manage.DisplayNameHelp"]</div>
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>
            @* Public consent is saved independently and is retained when the photo changes. *@
            <div class="form-check my-3">
                <input asp-for="Input.ShowProfilePhotoOnPublicTrips" class="form-check-input" />
                <label asp-for="Input.ShowProfilePhotoOnPublicTrips" class="form-check-label"></label>
                <p class="form-text">@T["Identity.Manage.ShowPhotoHelp"]</p>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">@T["Identity.Manage.Save"]</button>
        </form>
    </div>
</div>

@* A separate editor keeps photo mutations independent of the Profile preference form. *@
<section id="profile-photo-editor" class="mt-4" aria-labelledby="photo-heading">
    <h4 id="photo-heading">@T["ProfilePhoto.Title"]</h4>
    <img id="current-profile-photo" class="profile-photo-current" alt="@T["ProfilePhoto.Current"]" hidden />
    <p id="photo-consent" class="form-text"></p>
    <label for="photo-file" class="form-label">@T["ProfilePhoto.Select"]</label>
    <input id="photo-file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
    <p class="form-text">@T["ProfilePhoto.Formats"]</p>
    <div id="photo-framing" hidden>
        <canvas id="photo-preview" width="256" height="256" aria-label="@T["ProfilePhoto.Preview"]"></canvas>
        <label for="photo-zoom">@T["ProfilePhoto.Zoom"]</label><input id="photo-zoom" type="range" min="1" max="4" step="0.01" value="1" />
        <label for="photo-pan-x">@T["ProfilePhoto.Horizontal"]</label><input id="photo-pan-x" type="range" min="0" max="100" value="50" />
        <label for="photo-pan-y">@T["ProfilePhoto.Vertical"]</label><input id="photo-pan-y" type="range" min="0" max="100" value="50" />
        <button id="photo-reset" type="button" class="btn btn-outline-secondary">@T["ProfilePhoto.Reset"]</button>
    </div>
    <div class="d-flex gap-2 mt-2">
        <button id="photo-save" type="button" class="btn btn-primary" disabled>@T["ProfilePhoto.Save"]</button>
        <button id="photo-cancel" type="button" class="btn btn-outline-secondary">@T["ProfilePhoto.Cancel"]</button>
        <button id="photo-remove" type="button" class="btn btn-outline-danger" disabled>@T["ProfilePhoto.Remove"]</button>
        <button id="photo-refresh" type="button" class="btn btn-outline-primary" hidden>@T["ProfilePhoto.Refresh"]</button>
    </div>
    <p id="photo-status" role="status" aria-live="polite"></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/profilePhotoEditor.js" asp-append-version="true"></script>
}
