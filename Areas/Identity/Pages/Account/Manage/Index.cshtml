@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
    var role = ViewData["UserRole"];
}

<h3>@ViewData["Title"]</h3>
<h5>This account has a role of: <kbd>@role</kbd></h5>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" aria-required="true" placeholder="Display Name" />
                <label asp-for="Input.DisplayName" class="form-label">Display Name</label>
                <div id="Input.DisplayName" class="form-text">Display name for your public pages (if any).</div>
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>
            @* Public consent is saved independently and is retained when the photo changes. *@
            <div class="form-check my-3">
                <input asp-for="Input.ShowProfilePhotoOnPublicTrips" class="form-check-input" />
                <label asp-for="Input.ShowProfilePhotoOnPublicTrips" class="form-check-label"></label>
                <p class="form-text">Applies to your current and future photo on all your public Trips. Removing or replacing a photo keeps this choice. Downloaded copies cannot be recalled.</p>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </form>
    </div>
</div>

@* A separate editor keeps photo mutations independent of the Profile preference form. *@
<section id="profile-photo-editor" class="mt-4" aria-labelledby="photo-heading">
    <h4 id="photo-heading">Profile photo (optional)</h4>
    <img id="current-profile-photo" class="profile-photo-current" alt="Current profile photo" hidden />
    <p id="photo-consent" class="form-text"></p>
    <label for="photo-file" class="form-label">Select or replace photo</label>
    <input id="photo-file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
    <p class="form-text">JPEG, PNG or static WebP, up to 15 MiB and 40 megapixels. For HEIC/HEIF, export or select JPEG, PNG or static WebP.</p>
    <div id="photo-framing" hidden>
        <canvas id="photo-preview" width="256" height="256" aria-label="Circular photo crop preview"></canvas>
        <label for="photo-zoom">Zoom</label><input id="photo-zoom" type="range" min="1" max="4" step="0.01" value="1" />
        <label for="photo-pan-x">Horizontal position</label><input id="photo-pan-x" type="range" min="0" max="100" value="50" />
        <label for="photo-pan-y">Vertical position</label><input id="photo-pan-y" type="range" min="0" max="100" value="50" />
        <button id="photo-reset" type="button" class="btn btn-outline-secondary">Reset crop</button>
    </div>
    <div class="d-flex gap-2 mt-2">
        <button id="photo-save" type="button" class="btn btn-primary" disabled>Save photo</button>
        <button id="photo-cancel" type="button" class="btn btn-outline-secondary">Cancel selection</button>
        <button id="photo-remove" type="button" class="btn btn-outline-danger" disabled>Remove photo</button>
        <button id="photo-refresh" type="button" class="btn btn-outline-primary" hidden>Refresh photo state</button>
    </div>
    <p id="photo-status" role="status" aria-live="polite"></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/profilePhotoEditor.js" asp-append-version="true"></script>
}
