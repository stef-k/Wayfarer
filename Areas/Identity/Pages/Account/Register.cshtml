@page
@model RegisterModel
@{
    ViewData["Title"] = T["Identity.Register.Title"];
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>@T["Identity.Register.New"]</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <!-- Username Field -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Username" class="form-control" aria-required="true" placeholder="@T["Identity.Field.Username"]" />
                <label asp-for="Input.Username">@T["Identity.Field.Username"]</label>
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <!-- Password Field -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@T["Identity.Field.Password"]" />
                <label asp-for="Input.Password">@T["Identity.Field.Password"]</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password Field -->
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@T["Identity.Field.ConfirmPassword"]" />
                <label asp-for="Input.ConfirmPassword">@T["Identity.Field.ConfirmPassword"]</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" placeholder="@T["Identity.Field.DisplayName"]" />
                <label asp-for="Input.DisplayName" class="form-label">@T["Identity.Field.DisplayName"]</label>
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">@T["Identity.Register.Title"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
