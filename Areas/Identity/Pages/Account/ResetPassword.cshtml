@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResetPasswordModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.Password.Reset"];
}

<h1>@ViewData["Title"]</h1>
<h2>@T["Identity.Password.ResetInstruction"]</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* A missing reset code is a field error even though the submitted token is hidden. *@
            <input asp-for="Input.Code" type="hidden" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@T["Identity.Field.Password"]" />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@T["Identity.Field.ConfirmPassword"]" />
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@T["Identity.Password.ResetAction"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
