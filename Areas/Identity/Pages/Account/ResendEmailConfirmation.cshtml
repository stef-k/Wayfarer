@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResendEmailConfirmationModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    // The framework returns its sent acknowledgment on the POST document.
    ViewData["LanguageOneTimeResult"] = ViewData.ModelState[string.Empty]?.Errors
        .Any(error => error.ErrorMessage == T["Identity.Email.VerificationSent"]) == true;
    ViewData["Title"] = T["Identity.Email.ResendTitle"];
}

<h1>@ViewData["Title"]</h1>
<h2>@T["Identity.Email.Enter"]</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@T["Identity.Email.Resend"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
