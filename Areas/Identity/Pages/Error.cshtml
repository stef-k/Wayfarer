@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Internal.ErrorModel
@* The pinned Identity UI package owns the page model and handlers. *@
@{
    ViewData["Title"] = T["Identity.Error.Title"];
}

<h1 class="text-danger">@T["Identity.Error.Title"]</h1>
<h2 class="text-danger">@T["Identity.Error.Description"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T["Identity.Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@T["Identity.Error.Development"]</h3>
<p>@T["Identity.Error.DevelopmentDetails", "Development"]</p>
<p><strong>@T["Identity.Error.DevelopmentWarning", "Development"]</strong></p>
<p>@T["Identity.Error.DevelopmentSetup", "ASPNETCORE_ENVIRONMENT", "Development"]</p>
