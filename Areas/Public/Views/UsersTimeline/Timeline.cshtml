@inject Wayfarer.Localization.WebMessages T

@{
    ViewData["BodyClass"] = "container-fluid";
    ViewData["LoadLeaflet"] = true;
    ViewData["WebCatalog"] = "PublicTimeline";
    ViewData["Title"] = T["PublicTimeline.PageTitle", ViewData["DisplayName"]];
    var title = ViewData["TimelineTitle"] as string;
    var heading = string.IsNullOrWhiteSpace(title) ? T["PublicTimeline.Heading", ViewData["DisplayName"]] : title;
}

@* The regular page retains the public-sharing disclosure beside the heading. *@
<div id="timeline-header" class="d-flex flex-wrap align-items-baseline justify-content-center justify-content-md-start gap-2 my-0">
    <h1 class="fs-3 my-0">@heading</h1>
    <i class="bi bi-question-circle text-muted ms-1 fs-6" tabindex="0" role="img"
       aria-label="@T["PublicTimeline.Disclosure"]" data-tippy-content="@T["PublicTimeline.Disclosure"]"></i>
    <span id="timeline-summary" class="small font-monospace text-muted"></span>
</div>

<partial name="_TimelineMap" />

@section Scripts {
    @Html.FrontendViewScripts()
}
