@inject Wayfarer.Localization.WebMessages T

@{
    Layout = "~/Views/Shared/_EmbedLayout.cshtml";
    ViewData["BodyClass"] = "container-fluid p-0 h-100";
    ViewData["LoadLeaflet"] = true;
    ViewData["WebCatalog"] = "PublicTimeline";
    ViewData["TimelineEmbedded"] = true;
    ViewData["Title"] = T["PublicTimeline.PageTitle", ViewData["DisplayName"]];
    var title = ViewData["TimelineTitle"] as string;
    var heading = string.IsNullOrWhiteSpace(title) ? T["PublicTimeline.Heading", ViewData["DisplayName"]] : title;
}

@* Fit the header and map inside the iframe so ordinary scrolling chains to its parent. *@
<div class="wayfarer-embed d-flex flex-column h-100" data-timeline-embed>
    <div id="timeline-header" class="d-flex flex-shrink-0 flex-wrap align-items-baseline justify-content-center justify-content-md-start gap-2 px-3">
        <h1 class="fs-3 py-1">@heading</h1>
        <span id="timeline-summary" class="small font-monospace text-muted"></span>
    </div>

    <partial name="_TimelineMap" />
</div>

@section Scripts {
    @Html.FrontendViewScripts()
}
