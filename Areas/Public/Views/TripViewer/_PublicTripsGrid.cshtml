@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ViewModels.PublicTripIndexVm

@if (Model.Items.Count == 0)
{
    <partial name="_DiscoveryEmpty" model="Model" />
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm overflow-hidden" data-trip-id="@item.Id">
                    <!-- Hero Image with PiP Map -->
                    <div class="trip-hero-wrap">
                        <!-- Base photo -->
                        @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                        {
                            <img class="trip-photo js-lazy"
                                 data-src="/Public/Trips/@item.Id/CoverImage?v=@item.UpdatedAt.Ticks"
                                 alt="@item.Name">
                        }
                        else if (item.CenterLat.HasValue && item.CenterLon.HasValue)
                        {
                            <!-- Show map thumbnail via async thumbnail system if no cover image but has coordinates -->
                            <img class="trip-photo" data-thumb-placeholder
                                 alt="@T["Discovery.MapOf", item.Name]"
                                 style="background-color: #e9ecef;">
                        }
                        else
                        {
                            <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                <i class="bi bi-map text-secondary" style="font-size: 3rem;"></i>
                            </div>
                        }

                        <!-- PiP map badge (only show if trip has map coordinates) -->
                        @if (item.CenterLat.HasValue && item.CenterLon.HasValue)
                        {
                            <button type="button" class="trip-map-badge" aria-label="@T["Discovery.MapPreview"]" data-hero-toggle
                                data-trip-preview="@item.Id">
                                <img class="w-100 h-100 object-fit-cover" data-thumb-placeholder alt=""
                                    style="background-color: #e9ecef;">
                                <!-- UI tip bubble -->
                                <span class="pip-tip-bubble" role="status" aria-live="polite">
                                    <span class="pip-tip-text d-none d-lg-inline">@T["Discovery.HoverMap"]</span>
                                    <span class="pip-tip-text d-lg-none">@T["Discovery.TapMap"]</span>
                                </span>
                            </button>

                            <!-- Full-bleed map overlay -->
                            <img class="trip-map-overlay w-100 h-100 object-fit-cover" data-thumb-placeholder
                                alt="@T["Discovery.MapOf", item.Name]" aria-hidden="true" style="background-color: #e9ecef;">
                        }

                        <!-- Updated badge -->
                        @{
                            var daysSinceUpdate = (DateTime.UtcNow - item.UpdatedAt).Days;
                        }
                        @if (daysSinceUpdate <= 7)
                        {
                            <span class="position-absolute top-0 end-0 m-2 badge bg-secondary">
                                @T.Count("Discovery.UpdatedAgo", daysSinceUpdate)
                            </span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <!-- Title -->
                        <h5 class="card-title">
                            <a href="/Public/Trips/@item.Id" class="text-decoration-none text-body stretched-link">
                                @item.Name
                            </a>
                        </h5>

                        <!-- Attribution -->
                        @if (!string.IsNullOrWhiteSpace(item.OwnerDisplayName))
                        {
                            <p class="text-muted small mb-2">
                                <partial name="_PublicOwnerPhoto" model="@item.OwnerProfilePhoto" /><i class="bi bi-person"></i> @T["Discovery.ByOwner", item.OwnerDisplayName]
                            </p>
                        }

                        <!-- Notes Excerpt -->
                        @if (!string.IsNullOrWhiteSpace(item.NotesExcerpt))
                        {
                            <p class="card-text text-muted small flex-grow-1">
                                @item.NotesExcerpt
                            </p>
                        }

                        <!-- Tags -->
                        @if (item.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mb-2" data-trip-tags>
                                @foreach (var tag in item.Tags.Take(5))
                                {
                                    <a href="@Url.RouteUrl("PublicTripsByTag", new { slug = tag.Slug })"
                                       class="badge rounded-pill text-bg-secondary text-decoration-none position-relative"
                                       style="font-size: 0.7rem; z-index: 1030;" title="@T["Discovery.FilterByTag", tag.Name]">
                                        <i class="bi bi-tag-fill"></i> @tag.Name
                                    </a>
                                }
                                @if (item.Tags.Count > 5)
                                {
                                    <span class="badge rounded-pill text-bg-light">+@T.DisplayNumber(item.Tags.Count - 5)</span>
                                }
                            </div>
                        }

                        <!-- Meta Row -->
                        <div class="d-flex gap-3 text-muted small mt-2">
                            @if (item.RegionsCount > 0)
                            {
                                <span title="@T.Count("Discovery.RegionCount", item.RegionsCount)">
                                    <i class="bi bi-bounding-box"></i> @T.DisplayNumber(item.RegionsCount)
                                </span>
                            }
                            @if (item.AreasCount > 0)
                            {
                                <span title="@T.Count("Discovery.AreaCount", item.AreasCount)">
                                    <i class="bi bi-hexagon"></i> @T.DisplayNumber(item.AreasCount)
                                </span>
                            }
                            @if (item.PlacesCount > 0)
                            {
                                <span title="@T.Count("Viewer.PlaceCount", item.PlacesCount)">
                                    <i class="bi bi-geo-alt"></i> @T.DisplayNumber(item.PlacesCount)
                                </span>
                            }
                            @if (item.SegmentsCount > 0)
                            {
                                <span title="@T.Count("Discovery.SegmentCount", item.SegmentsCount)">
                                    <i class="bi bi-diagram-3"></i> @T.DisplayNumber(item.SegmentsCount)
                                </span>
                            }
                            <span class="ms-auto" title="@T["Discovery.LastUpdated"]">
                                <i class="bi bi-clock"></i> @item.UpdatedAt.ToString("d", T.DisplayCulture)
                            </span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1 position-relative" data-trip-preview="@item.Id" data-bs-toggle="modal" data-bs-target="#tripQuickView" style="z-index: 1030;" title="@T["Discovery.PreviewHint"]">
                                <i class="bi bi-eye"></i> @T["Discovery.Preview"]
                            </button>
                            @* Clone button - show for authenticated users, login prompt for others *@
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (!item.IsOwner)
                                {
                                    <form asp-area="User" asp-controller="Trip" asp-action="Clone" asp-route-id="@item.Id" method="post" class="clone-trip-form flex-grow-1 position-relative" style="z-index: 1030;">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100"
                                            title="@T["Viewer.CloneTrip"]">
                                            <i class="bi bi-files"></i> @T["Discovery.Clone"]
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-outline-secondary flex-grow-1 position-relative" style="z-index: 1030;" title="@T["Viewer.LoginToCloneTip"]">
                                    <i class="bi bi-box-arrow-in-right"></i> @T["Viewer.LoginToClone"]
                                </a>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary position-relative copy-url" data-url="@($"{Context.Request.Scheme}://{Context.Request.Host}/Public/Trips/{item.Id}")" style="z-index: 1030;" title="@T["Viewer.CopyPublicUrl"]">
                                <i class="bi bi-share"></i> @T["Discovery.Share"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
