@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ViewModels.PublicTripIndexVm

@if (Model.Items.Count == 0)
{
    <partial name="_DiscoveryEmpty" model="Model" />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 100px;">@T["Discovery.Image"]</th>
                    <th style="width: 100px;">@T["Discovery.Map"]</th>
                    <th>@T["Discovery.Trip"]</th>
                    <th style="width: 180px;">@T["Discovery.Tags"]</th>
                    <th class="text-center" style="width: 80px;">@T["Discovery.Items"]</th>
                    <th style="width: 130px;">@T["Discovery.Updated"]</th>
                    <th style="width: 150px;" class="text-end">@T["Discovery.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr data-trip-id="@item.Id">
                        <!-- Cover Image Column -->
                        <td>
                            <div style="width: 90px; height: 60px; overflow: hidden; border-radius: 4px;">
                                @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                {
                                    <img class="w-100 h-100 object-fit-cover js-lazy" data-src="/Public/Trips/@item.Id/CoverImage?v=@item.UpdatedAt.Ticks"
                                        alt="@item.Name" style="background-color: #e9ecef;" />
                                }
                                else if (item.CenterLat.HasValue && item.CenterLon.HasValue)
                                {
                                    <!-- Show map thumbnail via async thumbnail system if no cover image but has coordinates -->
                                    <img class="w-100 h-100 object-fit-cover" data-thumb-placeholder
                                        alt="@T["Discovery.MapOf", item.Name]" style="background-color: #e9ecef;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-body-secondary d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary"></i>
                                    </div>
                                }
                            </div>
                        </td>

                        <!-- Map Thumbnail Column -->
                        <td>
                            <div style="width: 90px; height: 60px; overflow: hidden; border-radius: 4px;">
                                @if (item.CenterLat.HasValue && item.CenterLon.HasValue)
                                {
                                    <img class="w-100 h-100 object-fit-cover" data-thumb-placeholder alt="@T["Discovery.MapOf", item.Name]"
                                        style="background-color: #e9ecef;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-body-secondary d-flex align-items-center justify-content-center">
                                        <i class="bi bi-map text-secondary"></i>
                                    </div>
                                }
                            </div>
                        </td>

                        <!-- Trip Info Column -->
                        <td>
                            <div>
                                <a href="/Public/Trips/@item.Id" class="fw-semibold text-decoration-none d-block">
                                    @item.Name
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.OwnerDisplayName))
                                {
                                    <div class="text-muted small">
                                        <partial name="_PublicOwnerPhoto" model="@item.OwnerProfilePhoto" /><i class="bi bi-person"></i> @T["Discovery.ByOwner", item.OwnerDisplayName]
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.NotesExcerpt))
                                {
                                    <div class="text-muted small mt-1">
                                        @item.NotesExcerpt
                                    </div>
                                }
                            </div>
                        </td>

                        <!-- Tags Column -->
                        <td>
                            @if (item.Tags.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1" data-trip-tags>
                                    @foreach (var tag in item.Tags.Take(3))
                                    {
                                        <a href="@Url.RouteUrl("PublicTripsByTag", new { slug = tag.Slug })"
                                            class="badge rounded-pill text-bg-secondary text-decoration-none" style="font-size: 0.7rem;"
                                            title="@T["Discovery.FilterByTag", tag.Name]">
                                            <i class="bi bi-tag-fill"></i> @tag.Name
                                        </a>
                                    }
                                    @if (item.Tags.Count > 3)
                                    {
                                        <span class="badge rounded-pill text-bg-secondary"
                                            title="@string.Join(", ", item.Tags.Skip(3).Select(t => t.Name))">
                                            +@T.DisplayNumber(item.Tags.Count - 3)
                                        </span>
                                    }
                                </div>
                            }
                        </td>

                        <!-- Stats Column -->
                        <td class="text-center">
                            <div class="d-flex flex-column gap-1 small text-muted">
                                @if (item.RegionsCount > 0)
                                {
                                    <span title="@T.Count("Discovery.RegionCount", item.RegionsCount)">
                                        <i class="bi bi-bounding-box"></i> @T.DisplayNumber(item.RegionsCount)
                                    </span>
                                }
                                @if (item.AreasCount > 0)
                                {
                                    <span title="@T.Count("Discovery.AreaCount", item.AreasCount)">
                                        <i class="bi bi-hexagon"></i> @T.DisplayNumber(item.AreasCount)
                                    </span>
                                }
                                @if (item.PlacesCount > 0)
                                {
                                    <span title="@T.Count("Viewer.PlaceCount", item.PlacesCount)">
                                        <i class="bi bi-geo-alt"></i> @T.DisplayNumber(item.PlacesCount)
                                    </span>
                                }
                                @if (item.SegmentsCount > 0)
                                {
                                    <span title="@T.Count("Discovery.SegmentCount", item.SegmentsCount)">
                                        <i class="bi bi-diagram-3"></i> @T.DisplayNumber(item.SegmentsCount)
                                    </span>
                                }
                            </div>
                        </td>

                        <!-- Updated Column -->
                        <td>
                            <span class="small text-muted">
                                @{
                                    var daysSinceUpdate = (DateTime.UtcNow - item.UpdatedAt).Days;
                                }
                                @if (daysSinceUpdate == 0)
                                {
                                    <span class="badge bg-secondary">@T["Discovery.Today"]</span>
                                }
                                else if (daysSinceUpdate <= 7)
                                {
                                    <span class="badge bg-secondary">@T.Count("Discovery.UpdatedAgo", daysSinceUpdate)</span>
                                }
                                else
                                {
                                    <span>@item.UpdatedAt.ToString("d", T.DisplayCulture)</span>
                                }
                            </span>
                        </td>

                        <!-- Actions Column -->
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-trip-preview="@item.Id"
                                    data-bs-toggle="modal" data-bs-target="#tripQuickView" title="@T["Discovery.PreviewHint"]" aria-label="@T["Discovery.PreviewHint"]">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @* Clone button - show for authenticated users, login prompt for others *@
                                        @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @if (!item.IsOwner)
                                    {
                                        <form asp-area="User" asp-controller="Trip" asp-action="Clone" asp-route-id="@item.Id"
                                            method="post" class="clone-trip-form d-inline-block">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                title="@T["Viewer.CloneTrip"]" aria-label="@T["Viewer.CloneTrip"]">
                                                <i class="bi bi-files"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <a asp-area="Identity" asp-page="/Account/Login"
                                        asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                        class="btn btn-sm btn-outline-secondary" title="@T["Viewer.LoginToCloneTip"]" aria-label="@T["Viewer.LoginToCloneTip"]">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                    </a>
                                }
                                <button type="button" class="btn btn-sm btn-outline-primary copy-url"
                                    data-url="@($"{Context.Request.Scheme}://{Context.Request.Host}/Public/Trips/{item.Id}")"
                                    title="@T["Viewer.CopyPublicUrl"]" aria-label="@T["Viewer.CopyPublicUrl"]">
                                    <i class="bi bi-share"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
