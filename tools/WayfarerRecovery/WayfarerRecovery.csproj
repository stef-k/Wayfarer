<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Version.props" />
  <!-- Bundle-owned worker uses the configured DB image's native PostgreSQL tools. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>wayfarer-recovery</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- PostgreSQL snapshot coordination and read-only key-ring usability checks. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LockProbe" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.11" />
  </ItemGroup>
</Project>
