<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Version.props" />
  <!-- Standalone operator executable; no dependency on the web application's runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>wayfarerctl</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- One reviewed replacement policy supplies operator and publication admission. -->
    <EmbeddedResource Include="../release/caddy-replacement.json" LogicalName="WayfarerCtl.caddy-replacement.json" />
    <ProjectReference Include="../WayfarerRecovery/WayfarerRecovery.csproj" />
    <InternalsVisibleTo Include="Wayfarer.Tests" />
  </ItemGroup>
</Project>
