{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["ClientApps/trip-editor/src/**/*.ts", "ClientApps/trip-editor/src/**/*.tsx", "ClientApps/trip-editor/src/**/*.vue"]
}
