{
  "name": "wayfarer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:client": "node --test tests/client/*.test.mjs",
    "test:trip-import-client": "node --test tests/client/tripImportClient.test.mjs",
    "test:segment-route-policy": "node --test tests/client/segmentRouteWorkPolicy.test.mjs",
    "test:external-route-proposals": "node --test tests/client/segmentRouteProposalState.test.mjs",
    "test:e2e:trip-editor": "playwright test --config=playwright.config.ts",
    "test:e2e:shared-layout": "playwright test --config=playwright.shared-layout.config.ts",
    "smoke:trip-editor:assets": "node tools/trip-editor-asset-smoke.mjs --mode=all",
    "smoke:trip-editor:assets:built": "node tools/trip-editor-asset-smoke.mjs --mode=built",
    "smoke:trip-editor:assets:dev": "node tools/trip-editor-asset-smoke.mjs --mode=development",
    "smoke:trip-editor:assets:published": "node tools/trip-editor-asset-smoke.mjs --mode=published"
  },
  "dependencies": {
    "@types/leaflet": "1.9.22",
    "@vitejs/plugin-vue": "6.0.8",
    "leaflet": "1.9.4",
    "quill": "2.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.1",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "0.28.1",
    "vue-tsc": "3.3.10"
  }
}
