@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Services.ProfilePhotoReference
@* Only an opted-in current public-Trip reference is rendered beside an existing owner name. *@
@if (Model != null)
{
    <span class="profile-photo public-owner-photo"><img src="@Model.Url" alt="@T["Shell.OwnerPhoto"]" /></span>
}
