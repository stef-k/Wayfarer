@inject Wayfarer.Localization.WebMessages T
@model string
@{
    /// <summary>
    /// User navigation dropdown partial view.
    /// Receives the user's display name as the model to show in the dropdown button.
    /// </summary>
}
<div class="dropdown" style="margin-top: 2px;">
    <button class="btn dropdown-toggle text-truncate nav-user-btn" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" title="@Model">
        <i class="bi bi-person me-1"></i>@Model
    </button>
    <ul class="dropdown-menu user-menu">

        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Timeline" asp-action="Chronological"
                title="@T["Shell.TimelineNavigation"]">@T["Shell.Timeline"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Timeline" asp-action="Index"
                title="@T["Shell.PrivateTimelineLink"]">@T["Shell.PrivateTimeline"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Location" asp-action="Index"
                title="@T["Shell.LocationsMap"]">@T["Shell.Locations"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Location" asp-action="AllLocations"
                title="@T["Shell.LocationsTable"]">@T["Shell.AllLocations"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Location" asp-action="BulkEditNotes"
                title="@T["Shell.BulkEditNotesLink"]">@T["Shell.BulkEditNotes"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="LocationImport" asp-action="Index"
                title="@T["Shell.UploadLocationData"]">@T["Shell.LocationImports"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Trip" asp-action="Index"
                title="@T["Shell.MyTripsLink"]">@T["Shell.Trips"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Visit" asp-action="Index"
                title="@T["Shell.TripVisitHistoryLink"]">@T["Shell.TripVisitHistory"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="HiddenAreas" asp-action="Index"
                title="@T["Shell.HiddenAreasLink"]">@T["Shell.HiddenAreas"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Groups" asp-action="Index"
                title="@T["Shell.MembershipsLink"]">@T["Shell.MyGroups"]</a>
        </li>
        <li class="nav-item d-flex align-items-center">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Invitations" asp-action="Index"
                title="@T["Shell.ManageInvitations"]">
                @T["Shell.Invitations"]
            </a>
            <span id="userInvitesBadge" class="badge bg-danger rounded-pill ms-2 d-none" style="min-width:1.25rem;">
                0
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="User" asp-controller="Settings" asp-action="Index"
                title="@T["Shell.SettingsLink"]">@T["Shell.Settings"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="Identity" asp-page="/Account/Manage/Index"
                title="@T["Shell.ManageAccount"]">@T["Shell.MyAccount"]</a>
        </li>
    </ul>
</div>
