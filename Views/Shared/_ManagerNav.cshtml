@inject Wayfarer.Localization.WebMessages T
@model string
@{
    /// <summary>
    /// Manager navigation dropdown partial view.
    /// Receives the user's display name as the model to show in the dropdown button.
    /// </summary>
}
<div class="dropdown" style="margin-top: 2px;">
    <button class="btn dropdown-toggle text-truncate nav-user-btn" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" title="@T["Shell.ManagerRole", Model]">
        <i class="bi bi-people me-1"></i>@Model
    </button>
    <ul class="dropdown-menu user-menu">
        <li>
            <a class="dropdown-item" asp-action="Index" asp-area="Manager" asp-controller="Users">@T["Shell.Users"]</a>
        </li>
        <li>
            <a class="dropdown-item d-flex align-items-center" asp-action="Index" asp-area="Manager" asp-controller="Groups">
                @T["Shell.Groups"]
                <span id="managerGroupsBadge" class="badge bg-primary rounded-pill ms-2 d-none" style="min-width:1.25rem;">0</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link theme-toggle" asp-area="Identity" asp-page="/Account/Manage/Index" title="@T["Shell.ManageAccount"]">@T["Shell.MyAccount"]</a>
        </li>
    </ul>
</div>
