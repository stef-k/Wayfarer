@model Wayfarer.Models.ViewModels.ChangePasswordViewModel
@using Wayfarer.Localization
@inject WebMessages T

@{
    // Generate links and forms in the area that admitted this management page.
    var area = ViewContext.RouteData.Values["area"] as string;
}

<h2 class="mb-4 text-center">@ViewData["Title"]</h2>

<!-- Info Alert -->
<div class="alert alert-info mb-4">
    @T["Accounts.PasswordTarget"]
    <ul>
        <li><strong>@T["Accounts.Username"]:</strong> @Model.UserName</li>
        <li><strong>@T["Accounts.DisplayName"]:</strong> @Model.DisplayName</li>
    </ul>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(true, T["Accounts.ValidationSummary"])
    </div>
}

<!-- Card Layout -->
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post" asp-area="@area" asp-controller="Users">
            @Html.AntiForgeryToken()

            <!-- New Password -->
            <div class="mb-3">
                <label for="NewPassword" class="form-label">@T["Accounts.NewPassword"]</label>
                <input type="password" asp-for="NewPassword" class="form-control" required />
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <!-- Confirm New Password -->
            <div class="mb-3">
                <label for="ConfirmPassword" class="form-label">@T["Accounts.ConfirmPassword"]</label>
                <input type="password" asp-for="ConfirmPassword" class="form-control" required />
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <!-- Hidden UserId -->
            <input type="hidden" asp-for="UserId" />

            <!-- Submit Button -->
            <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-primary">@T["Accounts.PasswordChange"]</button>
            </div>
        </form>
    </div>
</div>
