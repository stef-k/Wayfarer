@inject Wayfarer.Localization.WebMessages T
@{
    // Localized redirects carry a presentation identity instead of their initiating language.
    var key = TempData["WebAlertKey"] as string;
    var legacyText = TempData["AlertMessage"] as string;
    var argument = TempData["WebAlertArgument"];
    var count = TempData["WebAlertCount"];
    var text = key is null ? legacyText
        : count is int total ? T.Count(key, total) : T[key, argument];
}
@if (text != null)
{
    <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show" role="alert">
        <span lang="@(key is null ? "en" : null)">@text</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Shell.Close"]"></button>
    </div>
}
