@inject Wayfarer.Localization.WebMessages T
@model bool
@* Visit retains H1-H3/strike; Location retains fonts and its explicit Clear action. *@
<div id="notes-toolbar" class="rich-notes-toolbar" role="toolbar" aria-label="@T["Shell.NoteFormatting", T["Shell.Notes"]]">
    <select data-heading aria-label="@T["Shell.Heading"]"><option value="0">@T["Shell.Paragraph"]</option>
        @for (var level = 1; level <= (Model ? 3 : 6); level++) { <option value="@level">@T["Shell.HeadingLevel", T.DisplayNumber(level)]</option> }
    </select>
    <button type="button" data-action="bold" data-mark="bold" aria-pressed="false">@T["Shell.Bold"]</button>
    <button type="button" data-action="italic" data-mark="italic" aria-pressed="false">@T["Shell.Italic"]</button>
    <button type="button" data-action="underline" data-mark="underline" aria-pressed="false">@T["Shell.Underline"]</button>
    @if (Model) { <button type="button" data-action="strike" data-mark="strike" aria-pressed="false">@T["Shell.Strike"]</button> }
    <button type="button" data-action="ordered">@T["Shell.OrderedList"]</button>
    <button type="button" data-action="bullet">@T["Shell.BulletList"]</button>
    <button type="button" data-action="link">@T["Shell.Link"]</button>
    <button type="button" data-action="image">@T["Shell.Image"]</button>
    @if (!Model) { <select data-font aria-label="@T["Shell.Font"]"><option value="">@T["Shell.DefaultFont"]</option><option value="serif">@T["Shell.Serif"]</option><option value="monospace">@T["Shell.Monospace"]</option></select> }
    <button type="button" data-action="remove">@T["Shell.RemoveFormatting"]</button>
    @if (!Model) { <button type="button" data-action="clear">@T["Shell.Clear"]</button> }
</div>
