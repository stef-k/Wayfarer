@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.Trip
@{
    // Standalone print shares the structure and keeps its English presentation.
    var live = ViewData["WebCatalog"] as string == "Viewer";
    var policy = Model.ContributionPolicy ?? (live ? T["Viewer.Unlicensed"] : "Unlicensed / view-only");
}
@* Credits are publishable plain text; Razor escapes every field and only the shared codec admits links. *@
<span class="small text-muted">@(live ? T["Viewer.OwnerContributions", policy] : $"Owner's contributions: {policy}")@(Model.Credits.Count > 0 ? $" · {(live ? T["Viewer.InheritedTerms"] : "Includes inherited terms")}" : "")</span>
<details class="d-inline-block small ms-2">
    <summary class="link-primary">@(live ? T["Viewer.Credits"] : "Credits")</summary>
    <p>@(live ? T["Viewer.CreditsPolicy"] : "Policy covers the owner's contributions. Inherited terms and notices remain separate. View-only does not revoke inherited rights or prevent manual copying.")</p>
    @foreach (var credit in Model.Credits)
    {
        <section class="mb-2">
            <strong>@credit.Contributor</strong> <span>@credit.SourceTitle</span>
            <p style="white-space:pre-wrap">@credit.Licence</p>
            @if (credit.LicenceUrl != null) { <a href="@credit.LicenceUrl" rel="noopener noreferrer">@(live ? T["Viewer.LicenceInformation"] : "Licence information")</a> }
            <p style="white-space:pre-wrap">@credit.Notices</p>
            <p style="white-space:pre-wrap">@credit.Modifications</p>
            @if (credit.SourceUrl != null) { <a href="@credit.SourceUrl" rel="noopener noreferrer">@(live ? T["Viewer.Source"] : "Source")</a> }
        </section>
    }
</details>
