@using Wayfarer.Util
@using Wayfarer.Models.ViewModels
@model Wayfarer.Models.Trip


@if (Model.Segments?.Any() == true)
{
    <div class="border-top pt-2 text-bg-light ">
        <h6 class="text-muted fw-semibold px-2 mb-1">
            <i class="bi bi-signpost-2 me-1"></i> Segments
        </h6>

        <ul class="list-group list-group-flush">

            @{
                var emoji = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                {
                    ["walk"] = "🚶", ["bicycle"] = "🚴", ["bike"] = "🏍️", ["car"] = "🚗", ["bus"] = "🚌",
                    ["train"] = "🚆", ["ferry"] = "⛴️", ["boat"] = "🚤", ["flight"] = "✈️",
                    ["helicopter"] = "🚁", ["drive"] = "🚗", ["taxi"] = "🚕", ["tram"] = "🚊"
                };
            }

            @foreach (var seg in (Model.Segments ?? Enumerable.Empty<Segment>()).OrderBy(s => s.DisplayOrder))
            {
                /* ─── data & helpers ─────────────────────────────────────────── */
                var modeKey = (seg.Mode ?? "").ToLowerInvariant();
                var emojiIcon = emoji.TryGetValue(modeKey, out var e) ? e : "❓";

                // Controller readers explicitly load waypoint Places, making this collection authoritative.
                var journey = ViewerSegmentJourneyResolver.Resolve(seg, waypointsLoaded: true);
                var fromName = journey.Anchors.FirstOrDefault()?.DisplayName ?? "Unavailable place";
                var toName = journey.Anchors.LastOrDefault()?.DisplayName ?? "Unavailable place";
                var fromRegion = seg.FromPlace?.Region?.Name ?? "";
                var toRegion = seg.ToPlace?.Region?.Name ?? "";
                var label = journey.TrailText ?? "Journey unavailable";

                var durTxt = seg.EstimatedDuration?.ToString(@"hh\:mm") ?? "—";
                var distTxt = seg.EstimatedDistanceKm?.ToString("0.##") ?? "—";

                var startLat = journey.Anchors.FirstOrDefault()?.Location?.Y;
                var startLon = journey.Anchors.FirstOrDefault()?.Location?.X;
                var endLat = journey.Anchors.LastOrDefault()?.Location?.Y;
                var endLon = journey.Anchors.LastOrDefault()?.Location?.X;
                var wkt = journey.RouteWkt;
                <text>
                    <li class="list-group-item segment-list-item py-1 px-2 d-flex justify-content-between gap-2 segment-list-item-view"
                        title="Click to view the route"
                        data-segment-id="@(seg?.Id)"
                        data-from-place-name="@fromName"
                        data-from-placeregion-name="@fromRegion"
                        data-to-place-name="@toName"
                        data-to-placeregion-name="@toRegion"
                        data-segment-name="@($"{seg?.Mode}: {label}")"
                        data-transport-mode="@seg?.Mode"
                        data-estimated-distance="@seg?.EstimatedDistanceKm"
                        data-estimated-duration="@seg?.EstimatedDuration.FormatDuration()"
                        @if (startLat is not null)
                        {
                        <text> data-from-lat="@startLat" </text>
                        }
                        @if (startLon is not null)
                        {
                        <text> data-from-lon="@startLon" </text>
                        }
                        @if (endLat is not null)
                        {
                        <text> data-to-lat="@endLat" </text>
                        }
                        @if (endLon is not null)
                        {
                        <text> data-to-lon="@endLon" </text>
                        }
                        @if (!string.IsNullOrEmpty(wkt))
                        {
                        <text> data-route-wkt="@wkt" </text>
                        }
                        data-segment-notes="@(seg?.Notes ?? "")">

                        <div class="d-flex align-items-start gap-2 small">
                            <span class="fs-5" aria-hidden="true">@emojiIcon</span>
                            <div>
                                <div><strong>@(seg?.Mode)</strong></div>
                                <div>
                                    (<span title="Estimated time">⏱️ @durTxt&nbsp;min</span> /
                                    <span title="Estimated distance">📏 @distTxt&nbsp;km</span>)
                                </div>
                                <div title="From: @fromName (@fromRegion)">
                                    <strong>From:</strong> @fromName (@fromRegion)
                                </div>
                                <div title="To: @toName (@toRegion)">
                                    <strong>To:</strong> @toName (@toRegion)
                                </div>
                                @await Html.PartialAsync("~/Views/Trip/Partials/_SegmentJourney.cshtml", journey,
                                    new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["Interactive"] = true })
                                @if (HtmlHelpers.HasVisibleContent(seg?.Notes))
                                {
                                    <div class="text-muted mt-1 segment-notes-preview" style="max-height: 100px; overflow-y: auto;">
                                        @Html.ProxyNotesImages(seg?.Notes)
                                    </div>
                                }
                            </div>
                        </div>

                        <input type="checkbox"
                               class="form-check-input segment-toggle ms-2"
                               checked
                               title="Show/Hide this segment on map"/>
                    </li>
                </text>
            }
        </ul>
    </div>
}
