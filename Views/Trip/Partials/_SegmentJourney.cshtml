@using Wayfarer.Localization
@inject Wayfarer.Localization.WebMessages T
@model Wayfarer.Models.ViewModels.ViewerSegmentJourney
@{
    var live = ViewData["WebCatalog"] as string == "Viewer";
    var interactive = ViewData["Interactive"] as bool? ?? false;
}

@* This shared semantic trail stays useful when the map or JavaScript is unavailable. *@
<div class="segment-journey text-wrap">
    @if (Model.Anchors.Count > 0)
    {
        <ol class="segment-journey-roles mb-1 ps-4">
            @foreach (var anchor in Model.Anchors)
            {
                <li class="segment-journey-role text-break">
                    <strong>@anchor.Label — @(live ? ViewerJourneyText.Role(anchor, T) : anchor.Role) —</strong>
                    @if (interactive && anchor.PlaceId.HasValue && anchor.Location != null)
                    {
                        <button type="button" class="btn btn-link p-0 align-baseline text-wrap text-start segment-journey-place" data-place-id="@anchor.PlaceId">
                            @(live ? ViewerJourneyText.Name(anchor, T) : anchor.DisplayName)
                        </button>
                    }
                    else
                    {
                        <span>@(live ? ViewerJourneyText.Name(anchor, T) : anchor.DisplayName)</span>
                    }
                </li>
            }
        </ol>
        <div class="segment-journey-trail text-break" aria-label="@(live ? ViewerJourneyText.AccessibleName(Model, T) : Model.AccessibleName)">
            @(live ? ViewerJourneyText.Trail(Model, T, true) : Model.CompactTrail)
        </div>
        <div class="small text-muted">
            @(live ? T.Count("Viewer.WaypointCount", Model.WaypointCount) : $"{Model.WaypointCount} {(Model.WaypointCount == 1 ? "waypoint" : "waypoints")}") ·
            @(live ? T.Count("Viewer.RoutePointCount", Model.RoutePointCount) : $"{Model.RoutePointCount} {(Model.RoutePointCount == 1 ? "route point" : "route points")}")
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.DegradationMessage))
    {
        <div class="small text-muted segment-journey-status">@(live ? ViewerJourneyText.Degradation(Model.DegradationMessage, T) : Model.DegradationMessage)</div>
    }
</div>
