@inject Wayfarer.Localization.WebMessages T
@using System.Linq
@using Wayfarer.Util
@using Wayfarer.Models
@inject Wayfarer.Parsers.IApplicationSettingsService ApplicationSettingsService
@model Wayfarer.Models.Trip
@{
    ViewData["WebCatalog"] = "Viewer";
    ViewData["LoadLeaflet"] = true;
    Layout = "_Layout";
    // Public consent affects only owner-name identity, never exported or captured content.
    var ownerPhoto = Model.IsPublic && Model.User is { IsActive: true, ShowProfilePhotoOnPublicTrips: true }
        ? Wayfarer.Services.ProfilePhotoReference.Public(Model.User.ProfilePhotoVersion, Model.Id) : null;
    bool owner = ViewBag.IsOwner as bool? ?? false;
    bool hideSidebar = ViewContext.HttpContext.Request.Query["print"] == "1";
    ViewData["BodyClass"] = "container-fluid d-flex flex-column flex-fill p-0";
    ViewBag.Title = Model.Name;

    // Visit progress
    var totalPlaces = (int)(ViewBag.TotalPlaces ?? 0);
    var visitedPlaces = (int)(ViewBag.VisitedPlaces ?? 0);
    var progressPercent = totalPlaces > 0 ? (int)Math.Round((double)visitedPlaces / totalPlaces * 100) : 0;
    var shareProgressEnabled = ViewBag.ShareProgressEnabled as bool? ?? false;
    var showProgress = owner || (shareProgressEnabled && visitedPlaces > 0);
    var mapAttribution = TileProviderAttribution.Resolve(ApplicationSettingsService.GetSettings());

    // Get visit events and group by place (only available to owner)
    var rawVisitEvents = ViewBag.VisitEvents;
    var visitEventsList = rawVisitEvents != null ? (List<PlaceVisitEvent>)rawVisitEvents : new List<PlaceVisitEvent>();
    var visitsByPlace = visitEventsList
        .Where(v => v.PlaceId.HasValue)
        .GroupBy(v => v.PlaceId!.Value)
        .ToDictionary(g => g.Key, g => g.ToList());

    // Place visit counts for public progress display
    var placeVisitCounts = ViewBag.PlaceVisitCounts as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
    var itineraryRegions = ItineraryPresentation.OrderRegions(Model.Regions);
}

@* Layout controls stay contained to the live Viewer, including embedded workspaces. *@
<link rel="stylesheet" href="~/css/trip-sidebar.css" asp-append-version="true" />
<!-- wrapper that stretches between navbar & footer -->
<div id="trip-view"
     data-embed="@( (ViewBag.IsEmbed as bool? ?? false).ToString().ToLower() )"
     data-fullscreen-url="/Public/Trips/@Model.Id"
     class="position-relative flex-grow-1"
     data-trip-lat="@FormattableString.Invariant($"{Model.CenterLat}")"
     data-trip-lon="@FormattableString.Invariant($"{Model.CenterLon}")"
     data-trip-zoom="@FormattableString.Invariant($"{Model.Zoom}")">

    @if (hideSidebar)
    {
        <style>
            #sidebar-primary,
            #sidebar-secondary {
                display: none !important;
            }
        </style>
    }

    <!-- MAP (always full width) -->
    <main class="h-100">
        <div id="mapContainer" class="h-100 w-100"></div>
    </main>

    <!-- SIDEBAR – trip legend -->
    <aside id="sidebar-primary"
           class="position-absolute top-0 start-0 h-100 overflow-auto text-bg-light" data-collapsed="false">

        <!-- fixed header with collapse-handle + trip title + optional Edit -->
        <!-- ─── Trip legend header ─── -->
        <header class="border-bottom p-0 sticky-top bg-body" style="z-index: 2;">

            @* Responsive cover (shows only when URL present) *@
            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <div class="ratio ratio-21x9">
                    @if (Model.IsPublic)
                    {
                        <img src="/Public/Trips/@Model.Id/CoverImage?v=@Model.UpdatedAt.Ticks" class="img-fluid object-fit-cover w-100 h-100" alt="@T["Viewer.CoverFor", Model.Name]"/>
                    }
                    else
                    {
                        <img src="@ImageProxyHelper.ToProxyUrl(Model.CoverImageUrl)" class="img-fluid object-fit-cover w-100 h-100" alt="@T["Viewer.CoverFor", Model.Name]"/>
                    }
                </div>
            }

            @* Title + controls in one row *@
            <div class="px-2 py-2">
                <div class="d-flex align-items-center justify-content-between gap-2">

                    <!-- Trip title -->
                    <h5 class="mb-0 flex-shrink-1" style="font-size: 18px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.3; min-width: 0;" title="@Model.Name">
                        @Model.Name
                    </h5>

                    <!-- Right-side buttons -->
                    <div class="btn-group flex-shrink-0" role="group" aria-label="@T["Viewer.Actions"]">

                        <!-- 3) “More” dropdown with Edit + exports -->
                        <div class="btn-group" role="group">
                            <button id="btn-more-actions"
                                    type="button"
                                    class="btn btn-outline-primary btn-sm dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    title="@T["Viewer.MoreActions"]" aria-label="@T["Viewer.MoreActions"]">
                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="btn-more-actions">
                                @if ((bool)(ViewBag.IsOwner ?? false))
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="User"
                                           asp-controller="Trip"
                                           asp-action="Edit"
                                           asp-route-id="@Model.Id"
                                           title="@T["Viewer.EditTrip"]"
                                           target="_blank">
                                            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@T["Viewer.Edit"]
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider"/>
                                    </li>
                                }
                                @if (Model.IsPublic)
                                {
                                    <li>
                                        <a class="dropdown-item copy-url"
                                           href="#"
                                           data-url="@($"{Context.Request.Scheme}://{Context.Request.Host}/Public/Trips/{Model.Id}")"
                                           title="@T["Viewer.CopyPublicUrl"]">
                                            <i class="bi bi-share me-1" aria-hidden="true"></i>@T["Viewer.Share"]
                                        </a>
                                    </li>
                                    @if ((bool)(ViewBag.IsOwner ?? false))
                                    {
                                        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl) || (Model.CenterLat.HasValue && Model.CenterLon.HasValue && Model.Zoom.HasValue))
                                        {
                                            <li><hr class="dropdown-divider"/></li>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                                        {
                                            <li>
                                                <a class="dropdown-item copy-url"
                                                   href="#"
                                                   data-url="@($"{Context.Request.Scheme}://{Context.Request.Host}/Public/Trips/{Model.Id}/CoverImage?v={Model.UpdatedAt.Ticks}")"
                                                   title="@T["Viewer.CopyCoverTip"]">
                                                    <i class="bi bi-image me-1" aria-hidden="true"></i>@T["Viewer.CopyCover"]
                                                </a>
                                            </li>
                                        }
                                        @if (Model.CenterLat.HasValue && Model.CenterLon.HasValue && Model.Zoom.HasValue)
                                        {
                                            <li>
                                                <a class="dropdown-item copy-url"
                                                   href="#"
                                                   data-url="@($"{Context.Request.Scheme}://{Context.Request.Host}/Public/Trips/{Model.Id}/MapSnapshot")"
                                                   title="@T["Viewer.CopyMapTip"]">
                                                    <i class="bi bi-card-image me-1" aria-hidden="true"></i>@T["Viewer.CopyMap"]
                                                </a>
                                            </li>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl) || (Model.CenterLat.HasValue && Model.CenterLon.HasValue && Model.Zoom.HasValue))
                                        {
                                            <li><hr class="dropdown-divider"/></li>
                                        }
                                    }
                                    @if (Wayfarer.Services.TripReusePolicy.GrantsReuse(Model))
                                {
                                    @* Source-bound entry still rechecks current eligibility in the private copy preview. *@
                                    @if (User.Identity?.IsAuthenticated == true && ((bool)(ViewBag.IsOwner ?? false) || Wayfarer.Services.TripReusePolicy.GrantsReuse(Model)))
                                    {
                                        <li><a class="dropdown-item" asp-area="User" asp-controller="Trip" asp-action="Copy" asp-route-source="@Model.Id">@T["Viewer.CopyToTrip"]</a></li>
                                    }
                                    @* Clone button - show for authenticated users, login prompt for others *@
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        @if (!(bool)(ViewBag.IsOwner ?? false))
                                        {
                                            <li>
                                                <form asp-area="User"
                                                      asp-controller="Trip"
                                                      asp-action="Clone"
                                                      asp-route-id="@Model.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      id="clone-trip-form">
                                                    <button type="submit"
                                                            class="dropdown-item"
                                                            title="@T["Viewer.CloneTrip"]">
                                                        <i class="bi bi-files me-1" aria-hidden="true"></i>@T["Viewer.Clone"]
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-area="Identity"
                                               asp-page="/Account/Login"
                                               asp-route-returnUrl="@Context.Request.Path"
                                               title="@T["Viewer.LoginToCloneTip"]">
                                                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>@T["Viewer.LoginToClone"]
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <hr class="dropdown-divider"/>
                                    </li>
                                }
                                }
                                @if (Wayfarer.Services.TripReusePolicy.GrantsReuse(Model) || Model.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                {
                                <partial name="~/Views/Trip/_NativeExport.cshtml" model="Model" />
                                }
                            </ul>
                        </div>

                        <!-- 2) Recenter map -->
                        <button id="btn-trip-center"
                                type="button"
                                class="btn btn-outline-dark btn-sm"
                                title="@T["Viewer.Recenter"]" aria-label="@T["Viewer.Recenter"]">
                            <i class="bi bi-crosshair" aria-hidden="true"></i>
                        </button>

                        <!-- Expand to readable view -->
                        <button id="btn-expand-readable"
                                type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#readableViewModal"
                                title="@T["Viewer.Readable"]" aria-label="@T["Viewer.Readable"]">
                            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
                        </button>

                    </div>
                </div>
            </div>
            <div class="row small px-2 pt-1 mb-2 gx-2">
                <div class="col-6">
                    @if (!string.IsNullOrWhiteSpace(Model.User?.DisplayName))
                    {
                        <span class="text-muted">@T["Viewer.TripBy"]</span> <partial name="_PublicOwnerPhoto" model="@ownerPhoto" />@Model.User.DisplayName
                    }
                    @* Portable terms remain readable without a current account byline. *@
                    <partial name="~/Views/Trip/Partials/_TripCredits.cshtml" model="Model" />
                </div>
                <div class="col-6">
                    <span class="text-muted">@T["Viewer.Updated"]</span> @Model.UpdatedAt.ToString("g", T.DisplayCulture)
                </div>
            </div>

            @if (Model.Tags?.Count > 0)
            {
                <div class="px-2 pb-2">
                    <div class="d-flex flex-wrap gap-1" data-trip-tags>
                        @foreach (var tag in Model.Tags.OrderBy(t => t.Name))
                        {
                            <a href="@Url.RouteUrl("PublicTripsByTag", new { slug = tag.Slug })"
                               class="badge rounded-pill text-bg-secondary text-decoration-none"
                               style="font-size: 0.75rem;"
                               title="@T["Viewer.FilterBy", tag.Name]">
                                <i class="bi bi-tag-fill" aria-hidden="true"></i> @tag.Name
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="px-2 pb-2">
                <input id="legend-search" type="search" class="form-control form-control-sm"
                       placeholder="@T["Viewer.Search"]" autocomplete="off" />
            </div>

            @* Visit progress - shown for owner OR when ShareProgressEnabled *@
            @if (showProgress && totalPlaces > 0)
            {
                <div class="px-2 pb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                            @if (!owner && !string.IsNullOrEmpty(Model.User?.DisplayName))
                            {
                                <span><partial name="_PublicOwnerPhoto" model="@ownerPhoto" />@T["Viewer.VisitedBy", Model.User.DisplayName]</span>
                            }
                            @T.DisplayNumber(visitedPlaces) / @T.Count("Viewer.PlaceCount", totalPlaces)
                        </small>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-secondary py-0 px-1" style="font-size: 0.7rem;"
                                    data-bs-toggle="modal"
                                    data-bs-target="@(owner ? "#visitHistoryModal" : "#publicProgressModal")"
                                    title="@(owner ? T["Viewer.DetailedHistory"] : T["Viewer.ViewProgress"])">
                                <i class="bi bi-bar-chart me-1" aria-hidden="true"></i>@T["Viewer.Details"]
                            </button>
                            <span class="badge @(progressPercent == 100 ? "bg-success" : "bg-primary") badge-sm">@progressPercent%</span>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px;" role="progressbar"
                         aria-valuenow="@visitedPlaces" aria-valuemin="0" aria-valuemax="@totalPlaces">
                        <div class="progress-bar @(progressPercent == 100 ? "bg-success" : "")"
                             style="width: @progressPercent%;"></div>
                    </div>
                </div>
            }
        </header>

        <!-- Trip meta: notes (scroll-safe) -->
        <section class="trip-meta border-bottom">

            @if (HtmlHelpers.HasVisibleContent(Model.Notes))
            {
                <div class="trip-notes rich-notes-content px-3 pb-2" style="max-height: 200px; overflow-y: auto;">
                    @Html.ProxyNotesImages(Model.Notes, linkify: true)
                </div>
            }
        </section>

        <!-- regions accordion -->
        <div id="regions-accordion" class="accordion accordion-flush ">
            @{
                var unassignedRegion = itineraryRegions.FirstOrDefault(ItineraryPresentation.IsShadowRegion);
                if (unassignedRegion?.Places?.Any() == true)
                {
                    @await Html.PartialAsync("~/Views/Trip/Partials/_RegionReadonly.cshtml", unassignedRegion, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["RegionOrdinal"] = 0 })
                }
            }
            @foreach (var r in itineraryRegions.Where(region => !ItineraryPresentation.IsShadowRegion(region)))
            {
                @await Html.PartialAsync("~/Views/Trip/Partials/_RegionReadonly.cshtml", r, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["RegionOrdinal"] = ItineraryPresentation.RegionOrdinal(r, itineraryRegions) })
            }
        </div>


        <!-- segments list -->
        @await Html.PartialAsync("~/Views/Trip/Partials/_SegmentReadonlyList.cshtml", Model)
    </aside>


    <!-- Details overlay (unchanged) -->
    <aside id="sidebar-secondary"
           class="position-absolute top-0 start-0 h-100 bg-white border-end overflow-auto"
           style="z-index:1055"></aside>
</div>

<!-- Generating-file overlay -->
<div class="modal fade" id="exportWait" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="spinner-border spinner-border-sm text-primary"></span>
                    <strong>@T["Viewer.GeneratingPdf"]</strong>
                </div>
                <div id="export-progress-message" role="status" class="text-muted small" style="min-height: 1.2em;">
                    @T["Viewer.PreparingExport"]
                </div>
            </div>
            <div class="modal-footer">
                <button id="export-cancel-btn" type="button" class="btn btn-danger btn-sm" style="display: none;">
                    <i class="bi bi-x-circle" aria-hidden="true"></i> @T["Shell.Cancel"]
                </button>
            </div>
        </div>
    </div>
</div>

<iframe id="exportFrame" style="display:none"></iframe>

<!-- Readable View Modal -->
<div class="modal fade" id="readableViewModal" tabindex="-1" aria-labelledby="readableViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-center flex-grow-1" id="readableViewModalLabel">@Model.Name</h5>
                <button type="button" id="btn-print-modal" class="btn btn-outline-primary btn-sm me-2" title="@T["Viewer.PrintPdf"]">
                    <i class="bi bi-printer" aria-hidden="true"></i> @T["Viewer.Print"]
                </button>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Shell.Close"]"></button>
            </div>
            <div class="modal-body" id="readable-modal-body" style="max-width: 900px; margin: 0 auto; position: relative;">

                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <div class="mb-3">
                        <img src="@ImageProxyHelper.ToProxyUrl(Model.CoverImageUrl)" class="img-fluid w-100 rounded" alt="@T["Viewer.CoverFor", Model.Name]" style="max-height: 400px; object-fit: cover;"/>
                    </div>
                }
                else if (Model.CenterLat.HasValue && Model.CenterLon.HasValue)
                {
                    <div class="mb-3">
                        <img src="/thumbs/trips/@Model.Id-800x450.jpg?v=@Model.UpdatedAt.Ticks"
                             class="img-fluid w-100 rounded"
                             alt="@T["Viewer.MapOf", Model.Name]"
                             style="max-height: 400px; object-fit: cover;"/>
                        @* Render only server-resolved, sanitized provider attribution. *@ @if (!string.IsNullOrWhiteSpace(mapAttribution)) { <div class="map-snapshot-attribution small text-muted mt-1">@Html.Raw(mapAttribution)</div> }
                    </div>
                }

                <!-- Trip metadata -->
                <div class="row small mb-3">
                    <div class="col-md-6">
                        @if (!string.IsNullOrWhiteSpace(Model.User?.DisplayName))
                        {
                            <strong class="text-muted">@T["Viewer.TripBy"]</strong> <partial name="_PublicOwnerPhoto" model="@ownerPhoto" />@Model.User.DisplayName
                        }
                        <partial name="~/Views/Trip/Partials/_TripCredits.cshtml" model="Model" />
                    </div>
                    <div class="col-md-6">
                        <strong class="text-muted">@T["Viewer.Updated"]</strong> @Model.UpdatedAt.ToString("g", T.DisplayCulture)
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl) && Model.CenterLat.HasValue && Model.CenterLon.HasValue)
                {
                    <div class="mb-3">
                        <img src="/thumbs/trips/@Model.Id-800x450.jpg?v=@Model.UpdatedAt.Ticks"
                             class="img-fluid w-100 rounded"
                             alt="@T["Viewer.MapOf", Model.Name]"
                             style="max-height: 300px; object-fit: cover;"/>
                        @if (!string.IsNullOrWhiteSpace(mapAttribution)) { <div class="map-snapshot-attribution small text-muted mt-1">@Html.Raw(mapAttribution)</div> }
                    </div>
                }

                <!-- Tags -->
                @if (Model.Tags?.Count > 0)
                {
                    <div class="mb-3">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in Model.Tags.OrderBy(t => t.Name))
                            {
                                <a href="@Url.RouteUrl("PublicTripsByTag", new { slug = tag.Slug })"
                                   class="badge rounded-pill text-bg-secondary text-decoration-none"
                                   style="font-size: 0.875rem; padding: 0.5em 0.75em;">
                                    <i class="bi bi-tag-fill" aria-hidden="true"></i> @tag.Name
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Notes -->
                @if (HtmlHelpers.HasVisibleContent(Model.Notes))
                {
                    <div class="trip-notes-readable rich-notes-content mb-4">
                        <h6 class="text-muted mb-2">@T["Shell.Notes"]</h6>
                        <div class="fs-6">
                            @Html.ProxyNotesImages(Model.Notes)
                        </div>
                    </div>
                }

                <div class="regions-readable">
                    <h6 class="text-muted mb-3">@T["Viewer.RegionsPlaces"]</h6>
                    @foreach (var region in itineraryRegions)
                    {
                        @if (region.Name == "Unassigned Places" && (region.Places == null || !region.Places.Any()))
                        {
                            continue;
                        }
                        <div class="region-readable mb-4 pb-3 border-bottom">
                            <h5 class="mb-2 itinerary-region-label">@ItineraryPresentation.Label(ItineraryPresentation.RegionOrdinal(region, itineraryRegions), ItineraryPresentation.IsShadowRegion(region) ? T["Viewer.UnassignedPlaces"] : region.Name)</h5>

                            @if (!string.IsNullOrWhiteSpace(region.CoverImageUrl))
                            {
                                <div class="mb-3">
                                    <img src="@ImageProxyHelper.ToProxyUrl(region.CoverImageUrl)" alt="@region.Name" class="img-fluid rounded" style="max-height: 200px; object-fit: cover; width: 100%;" />
                                </div>
                            }

                            @if (HtmlHelpers.HasVisibleContent(region.Notes))
                            {
                                <div class="mb-3 text-muted rich-notes-content">
                                    @Html.ProxyNotesImages(region.Notes)
                                </div>
                            }

                            @if (region.Places?.Count > 0)
                            {
                                <div class="places-list">
                                    @foreach (var (place, placeIndex) in ItineraryPresentation.OrderPlaces(region.Places).Select((place, index) => (place, index)))
                                    {
                                        var iconName = string.IsNullOrWhiteSpace(place.IconName) ? "marker" : place.IconName.Trim();
                                        var bgClass = string.IsNullOrWhiteSpace(place.MarkerColor) ? "bg-blue" : place.MarkerColor.Trim();

                                        <div class="place-item mb-2 ps-3">
                                            <div class="d-flex align-items-start">
                                                @await Html.PartialAsync("~/Areas/User/Views/Trip/Partials/_MapIcon.cshtml", (iconName, bgClass))
                                                <div class="flex-grow-1">
                                                    <strong class="itinerary-place-label">@ItineraryPresentation.Label(placeIndex + 1, place.Name)</strong>
                                                    @if (HtmlHelpers.HasVisibleContent(place.Notes))
                                                    {
                                                        <div class="small text-muted mt-1 rich-notes-content">
                                                            @Html.ProxyNotesImages(place.Notes)
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>@await Html.PartialAsync("~/Views/Trip/Partials/_SegmentReadableList.cshtml", Model)

                <!-- Back to Top Button -->
                <button type="button"
                        id="btn-back-to-top"
                        class="btn btn-primary rounded-circle position-fixed"
                        style="bottom: 2rem; right: 2rem; width: 50px; height: 50px; display: none; z-index: 1000;"
                        title="@T["Shell.BackToTop"]">
                    <i class="bi bi-arrow-up" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@* Anti-forgery token for AJAX calls (owner only) *@
@if (owner)
{
    <form id="__AjaxAntiForgeryForm" method="post" class="d-none">@Html.AntiForgeryToken()</form>
}

@* Visit History Modal - owner only *@
@if (owner)
{
    <div class="modal fade" id="visitHistoryModal" tabindex="-1" aria-labelledby="visitHistoryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-wrap" id="visitHistoryModalLabel">
                        <i class="bi bi-clock-history me-2" aria-hidden="true"></i>@Model.Name <span class="text-muted fw-normal">@T["Viewer.VisitHistory"]</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Shell.Close"]"></button>
                </div>
                <div class="modal-body">
                    <!-- Progress Summary -->
                    <div class="mb-4 p-3 bg-body-secondary rounded">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">@T["Viewer.OverallProgress"]</span>
                            <span class="badge @(progressPercent == 100 ? "bg-success" : "bg-primary") fs-6">@progressPercent%</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar @(progressPercent == 100 ? "bg-success" : "")" style="width: @progressPercent%;"></div>
                        </div>
                        <div class="text-muted mt-2">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i> @T["Viewer.VisitedTotal", T.DisplayNumber(visitedPlaces), T.Count("Viewer.PlaceCount", totalPlaces)]
                        </div>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="mb-3 btn-group" role="group" aria-label="@T["Viewer.FilterPlaces"]">
                        <button type="button" class="btn btn-outline-secondary btn-sm active" data-filter="all">
                            <i class="bi bi-list-ul me-1" aria-hidden="true"></i>@T["Viewer.ShowAll"]
                        </button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="visited">
                            <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>@T["Viewer.Visited"]
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-filter="not-visited">
                            <i class="bi bi-circle me-1" aria-hidden="true"></i>@T["Viewer.NotVisited"]
                        </button>
                    </div>

                    <!-- Region-by-Region Breakdown -->
                    <div id="visitHistoryRegions">
                        @foreach (var region in Model.Regions?.OrderBy(r => r.DisplayOrder) ?? Enumerable.Empty<Region>())
                        {
                            var regionPlaces = ItineraryPresentation.OrderPlaces(region.Places);
                            var regionVisitedCount = regionPlaces.Count(p => visitsByPlace.ContainsKey(p.Id));
                            var regionPercent = regionPlaces.Count > 0 ? (int)Math.Round((double)regionVisitedCount / regionPlaces.Count * 100) : 0;

                            <div class="mb-3 visit-region-block">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold">@(ItineraryPresentation.IsShadowRegion(region) ? T["Viewer.UnassignedPlaces"] : region.Name)</span>
                                    <span class="text-muted small">@T.DisplayNumber(regionVisitedCount) / @T.DisplayNumber(regionPlaces.Count)</span>
                                </div>
                                <div class="progress mb-2" style="height: 6px;">
                                    <div class="progress-bar @(regionPercent == 100 ? "bg-success" : "bg-info")" style="width: @regionPercent%;"></div>
                                </div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var place in regionPlaces)
                                    {
                                        var placeVisits = visitsByPlace.TryGetValue(place.Id, out var visits) ? visits : new List<PlaceVisitEvent>();
                                        var isVisited = placeVisits.Count > 0;
                                        <li class="list-group-item py-2 visit-place-item @(isVisited ? "" : "text-muted")" data-visited="@isVisited.ToString().ToLower()">
                                            <div class="d-flex align-items-start">
                                                @if (isVisited)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success me-2" aria-hidden="true"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-circle text-muted me-2" aria-hidden="true"></i>
                                                }
                                                <div class="flex-grow-1">
                                                    <div class="fw-medium">@place.Name</div>
                                                    @if (isVisited)
                                                    {
                                                        <div class="small text-muted" style="max-height: 80px; overflow-y: auto;">
                                                            @foreach (var visit in placeVisits.OrderByDescending(v => v.ArrivedAtUtc))
                                                            {
                                                                var duration = visit.EndedAtUtc.HasValue
                                                                    ? (visit.EndedAtUtc.Value - visit.ArrivedAtUtc)
                                                                    : (TimeSpan?)null;
                                                                var durationStr = duration.HasValue
                                                                    ? (duration.Value.TotalHours >= 1
                                                                        ? T["Viewer.HoursMinutes", (int)duration.Value.TotalHours, duration.Value.Minutes]
                                                                        : T["Viewer.Minutes", (int)duration.Value.TotalMinutes])
                                                                    : T["Viewer.Ongoing"];
                                                                <div>
                                                                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@visit.ArrivedAtUtc.ToString("d", T.DisplayCulture)
                                                                    <span class="ms-2"><i class="bi bi-stopwatch me-1" aria-hidden="true"></i>@durationStr</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                @if (isVisited)
                                                {
                                                    <span class="badge bg-success">@T.DisplayNumber(placeVisits.Count)</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        @if (Model.IsPublic)
                        {
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="modalShareProgressSwitch"
                                       data-trip-id="@Model.Id"
                                       @Html.Raw(shareProgressEnabled ? "checked=\"checked\"" : "")>
                                <label class="form-check-label" for="modalShareProgressSwitch">
                                    <i class="bi bi-broadcast me-1" aria-hidden="true"></i>@T["Viewer.ShareProgress"]
                                </label>
                            </div>
                            <span id="modalShareStatus" class="badge @(shareProgressEnabled ? "bg-success" : "bg-secondary") small">
                                @(shareProgressEnabled ? T["Viewer.Public"] : T["Viewer.Private"])
                            </span>
                            <button type="button" id="btnCopyProgressLink"
                                    class="btn btn-outline-success btn-sm @(shareProgressEnabled ? "" : "d-none")"
                                    data-public-url="/Public/Trips/@Model.Id"
                                    title="@T["Viewer.CopyShareLink"]">
                                <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>@T["Viewer.CopyLink"]
                            </button>
                        }
                        else
                        {
                            <small class="text-muted"><i class="bi bi-lock me-1" aria-hidden="true"></i>@T["Viewer.MakePublic"]</small>
                        }
                    </div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Shell.Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

@* Public Progress Modal - shown to non-owners when ShareProgressEnabled *@
@if (!owner && shareProgressEnabled && totalPlaces > 0)
{
    <div class="modal fade" id="publicProgressModal" tabindex="-1" aria-labelledby="publicProgressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-wrap" id="publicProgressModalLabel">
                        <i class="bi bi-trophy me-2 text-warning" aria-hidden="true"></i>
                        @if (!string.IsNullOrEmpty(Model.User?.DisplayName))
                        {
                            <span><partial name="_PublicOwnerPhoto" model="@ownerPhoto" />@T["Viewer.OwnerTripProgress", Model.User.DisplayName, Model.Name]</span>
                        }
                        else
                        {
                            <span>@T["Viewer.TripProgressTitle", Model.Name]</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Shell.Close"]"></button>
                </div>
                <div class="modal-body">
                    <!-- Progress Summary -->
                    <div class="mb-4 p-3 bg-body-secondary rounded text-center">
                        <div class="display-4 fw-bold @(progressPercent == 100 ? "text-success" : "text-primary")">@progressPercent%</div>
                        <div class="text-muted">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i> @T["Viewer.VisitedTotal", T.DisplayNumber(visitedPlaces), T.Count("Viewer.PlaceCount", totalPlaces)]
                        </div>
                        <div class="progress mt-3" style="height: 12px;">
                            <div class="progress-bar @(progressPercent == 100 ? "bg-success" : "")" style="width: @progressPercent%;"></div>
                        </div>
                    </div>

                    <!-- Region-by-Region Breakdown (counts only, no dates) -->
                    <h6 class="text-muted mb-3">@T["Viewer.ByRegion"]</h6>
                    @foreach (var region in Model.Regions?.OrderBy(r => r.DisplayOrder) ?? Enumerable.Empty<Region>())
                    {
                        var regionPlaces = ItineraryPresentation.OrderPlaces(region.Places);
                        var regionVisitedCount = regionPlaces.Count(p => placeVisitCounts.ContainsKey(p.Id));
                        var regionPercent = regionPlaces.Count > 0 ? (int)Math.Round((double)regionVisitedCount / regionPlaces.Count * 100) : 0;

                        if (regionPlaces.Count == 0) { continue; }

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold">@(ItineraryPresentation.IsShadowRegion(region) ? T["Viewer.UnassignedPlaces"] : region.Name)</span>
                                <span class="text-muted small">@T.DisplayNumber(regionVisitedCount) / @T.DisplayNumber(regionPlaces.Count)</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @(regionPercent == 100 ? "bg-success" : "bg-info")" style="width: @regionPercent%;"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Shell.Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="module" src="~/js/Trip/viewerPrint.js" asp-append-version="true"></script>
    @Html.FrontendViewScripts()
    <script>
        // Clone trip confirmation
        document.getElementById('clone-trip-form')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const form = this;
            const btn = form.querySelector('button[type="submit"]');

            wayfarer.showConfirmationModal({
                title: 'Clone Trip',
                message: 'Clone this trip to your account? You will be able to edit and customize your copy.',
                confirmText: 'Clone Trip',
                onConfirm: function() {
                    // Show loading state
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Cloning...';
                    }
                    form.submit();
                }
            });
        });

        // Visit History Modal filter buttons
        document.querySelectorAll('#visitHistoryModal [data-filter]').forEach(btn => {
            btn.addEventListener('click', () => {
                // Update active state
                document.querySelectorAll('#visitHistoryModal [data-filter]').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.dataset.filter;
                const items = document.querySelectorAll('#visitHistoryModal .visit-place-item');

                items.forEach(item => {
                    const isVisited = item.dataset.visited === 'true';
                    if (filter === 'all') {
                        item.style.display = '';
                    } else if (filter === 'visited') {
                        item.style.display = isVisited ? '' : 'none';
                    } else if (filter === 'not-visited') {
                        item.style.display = isVisited ? 'none' : '';
                    }
                });

                // Hide empty region blocks when filtering
                document.querySelectorAll('#visitHistoryModal .visit-region-block').forEach(block => {
                    const visibleItems = block.querySelectorAll('.visit-place-item:not([style*="display: none"])');
                    block.style.display = visibleItems.length > 0 ? '' : 'none';
                });
            });
        });

        // Notes already use the proxy in Razor; local map snapshots keep their original URLs.
        const readableModal = document.getElementById('readableViewModal');
        const modalBody = document.getElementById('readable-modal-body');
        const backToTopBtn = document.getElementById('btn-back-to-top');

        if (readableModal) {
            readableModal.addEventListener('shown.bs.modal', function() {
                // Preserve server-selected image sources and defer off-screen loading.
                readableModal.querySelectorAll('img').forEach(img => {
                    if (!img.hasAttribute('loading')) {
                        img.setAttribute('loading', 'lazy');
                    }
                });

                // Linkify plain text URLs in the modal
                const urlRegex = /(https?:\/\/[^\s<>"]+)/gi;
                const textNodes = [];

                // Find all text nodes in the modal
                function getTextNodes(node) {
                    if (node.nodeType === 3) { // Text node
                        textNodes.push(node);
                    } else if (node.nodeType === 1 && node.nodeName !== 'SCRIPT' && node.nodeName !== 'STYLE' && node.nodeName !== 'A') {
                        for (let child of node.childNodes) {
                            getTextNodes(child);
                        }
                    }
                }

                getTextNodes(readableModal.querySelector('.modal-body'));

                // Replace plain text URLs with links
                textNodes.forEach(textNode => {
                    const text = textNode.textContent;
                    if (urlRegex.test(text)) {
                        const span = document.createElement('span');
                        span.innerHTML = text.replace(urlRegex, (url) => {
                            const cleanUrl = url.trim();
                            return `<a href="${cleanUrl}" target="_blank" rel="noopener noreferrer" style="color: rgb(26, 115, 232);">${cleanUrl}</a>`;
                        });
                        textNode.parentNode.replaceChild(span, textNode);
                    }
                });

                // Make existing links clickable and open external links in new tab
                const currentDomain = window.location.hostname;
                readableModal.querySelectorAll('a').forEach(link => {
                    // Enable clicking
                    link.style.pointerEvents = 'auto';
                    link.style.cursor = 'pointer';

                    try {
                        const url = new URL(link.href, window.location.href);
                        // If external domain, open in new tab
                        if (url.hostname !== currentDomain) {
                            link.setAttribute('target', '_blank');
                            link.setAttribute('rel', 'noopener noreferrer');
                        }
                    } catch (e) {
                        // If URL parsing fails, it's likely a relative link, leave it as is
                    }
                });
            });

            // Back to top button functionality
            if (modalBody && backToTopBtn) {
                modalBody.addEventListener('scroll', function() {
                    if (modalBody.scrollTop > 300) {
                        backToTopBtn.style.display = 'block';
                    } else {
                        backToTopBtn.style.display = 'none';
                    }
                });

                backToTopBtn.addEventListener('click', function() {
                    modalBody.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            }
        }

        // Auto-open progress modal if ?progress=1 param is present
        (function() {
            const params = new URLSearchParams(window.location.search);
            if (params.get('progress') === '1') {
                // Try public progress modal first (for non-owners), then owner's modal
                const publicModal = document.getElementById('publicProgressModal');
                const ownerModal = document.getElementById('visitHistoryModal');
                const modal = publicModal || ownerModal;
                if (modal) {
                    // Small delay to ensure page is fully loaded
                    setTimeout(() => {
                        const bsModal = new bootstrap.Modal(modal);
                        bsModal.show();
                    }, 500);
                }
            }
        })();
    </script>
}


