# Non-secret, literal KEY=value input. Copy outside the source tree; do not add passwords.
PUBLIC_HOST=wayfarer.example.org
# Obtain from a genuine release's image evidence; no default or mutable tag is accepted.
WAYFARER_DIGEST=
PROXY_MODE=managed
# Choose a free private /24; .1 is host gateway, .3 is managed Caddy.
EDGE_PREFIX=172.30.64
DB_PASSWORD_FILE=/etc/wayfarer/secrets/db-password
# Same application password, copied with separate consumer ownership (UID70 and UID1654).
DB_APP_PASSWORD_FILE=/etc/wayfarer/secrets/db-app-password
APP_PASSWORD_FILE=/etc/wayfarer/secrets/app-password
# External mode only: gateway observed by Kestrel for a Linux host-native proxy.
EXTERNAL_PROXY_ADDRESS=172.30.64.1
LOOPBACK_ADDRESS=127.0.0.1
LOOPBACK_PORT=8080
