{
  // Production-specific settings
  // These override the defaults in appsettings.json when running in Production environment

  // Existing Linux-oriented production profile; normal configuration/environment overrides apply.
  "Storage": {
    "DataRoot": "/var/lib/wayfarer",
    "CacheRoot": "/var/cache/wayfarer",
    "LogRoot": "/var/log/wayfarer",
    "TempRoot": "/tmp/wayfarer"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",  // Less verbose logging in production
      "Microsoft.AspNetCore": "Warning",
      "Wayfarer.Middleware.PerformanceMonitoringMiddleware": "Information"
    },
    "LogFilePath": {
      "Default": "/var/log/wayfarer/wayfarer-.log"
    }
  },
  "Application": {
    "ContactEmail": "admin@your-domain.example"
  },
  "DataProtection": {
    "KeyRingPath": "/home/wayfarer/.aspnet/DataProtection-Keys"
  },
  "CacheSettings": {
    // Deprecated compatibility root; new tiles use Storage:CacheRoot/tiles.
    "TileCacheDirectory": "/var/www/wayfarer/TileCache",
    "ImageCacheDirectory": "/var/www/wayfarer/ImageCache",
    "ChromeCacheDirectory": "/var/www/wayfarer/ChromeCache"
  }
}
